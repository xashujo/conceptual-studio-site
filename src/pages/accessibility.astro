---
import Base from '../layouts/Base.astro';
import { settings } from '../lib/site.js';
---
<Base title="Accessibility" description="Accessibility statement for the Conceptual Studio website.">
  <section class="page-head wrap grid"><h1>Accessibility</h1><p class="lead">I want everyone to be able to use this site, and I design client work to the same standard.</p></section>
  <section class="wrap grid text-page">
    <div class="prose">
      <h2>The standard</h2>
      <p>This site aims to meet the Web Content Accessibility Guidelines (WCAG) 2.2 at level AA. It works with a keyboard and screen readers, respects your settings for reduced motion and higher contrast, and every image has a text description.</p>
      <h2>Known limits</h2>
      <ul>
        <li>The glass effect on menus is decorative. With higher contrast turned on, it becomes solid.</li>
        <li>Some older case study images contain text that isn’t repeated on the page. Ask and I’ll send an accessible version.</li>
      </ul>
      <h2>Tell me if something doesn’t work</h2>
      <p>Email <a class="link" href={`mailto:${settings.email}`}>{settings.email}</a> and I’ll fix it or get you the information another way.</p>
      <p class="muted">Last reviewed October 2026.</p>
    </div>
  </section>
</Base>
