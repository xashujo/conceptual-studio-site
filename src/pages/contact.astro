---
// Contact (brief 6.6) in the home page's design language (Josh, 2 Nov): the email in plain text, availability,
// the London clock and reply time; the elsewhere links; the procurement pointer; and the enquiry form in the
// close. "What happens next" is the one line under the form (Site settings), not a second list of steps.
// Words: Pages CMS > Contact page.
import Studio from '../layouts/Studio.astro';
import Band from '../components/studio/Band.astro';
import Enquiry from '../components/Enquiry.astro';
import { email, replyTime, social, availability } from '../lib/site';
import { contactPage as c, titleCase } from '../lib/pages';
---
<Studio title="Contact" description={`${c.intro} ${replyTime}`} current="/contact/" turnstile closeWide>
  <Band opening labelledby="contact-h">
    <div class="ph__plate glass" data-lens>
      <h1 class="ph__h" id="contact-h">{c.heading}</h1>
      <p class="ph__p">{c.intro}</p>
      <p class="ct-mail"><span class="sr-only">{c.emailLabel}: </span><a href={`mailto:${email}`}>{email}</a></p>
      <div class="acts">
        <a class="btn btn--solid" href="#enquire">{c.enquiryHeading}</a>
        <button class="btn" type="button" data-copy={email}><span data-copy-label>Copy Email</span></button>
        {availability.on && <span class="avail ct-avail"><span class="avail__dot" aria-hidden="true"></span><span>{titleCase(availability.text)}</span></span>}
      </div>
      <div class="ct-meta">
        <p class="clock"><span class="clock__dot" aria-hidden="true"></span><span>London, UK <span data-clock>(local time)</span></span></p>
        <p>{c.hours}</p>
        <p>{replyTime}</p>
      </div>
    </div>
  </Band>

  {social.length > 0 && (
    <Band night labelledby="else-h">
      <h2 class="big" id="else-h">{c.elsewhereHeading}</h2>
      <ul class="ct-else">
        {social.map((s, i) => <li><a class="glass" href={s.href} rel="me noopener" data-lens data-reveal style={`--i: ${i}`}>{s.label}<span class="arrow" aria-hidden="true">→</span></a></li>)}
      </ul>
    </Band>
  )}

  <Band labelledby="org-h">
    <div class="quote glass ct-org" data-lens data-reveal>
      <h2 class="mid" id="org-h">{c.procurementHeading}</h2>
      <p class="quote__p">{c.procurementText}</p>
      <a class="btn glass-button" href="/procurement/">{c.procurementButton} <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </Band>

  <div slot="close" class="ct-close"><Enquiry night heading={c.formHeading} /></div>
</Studio>

<style>
  .ct-mail { font-size: clamp(22px, 2.4vw, 32px); font-weight: 500; letter-spacing: -0.02em; overflow-wrap: anywhere; }
  .ct-mail a { text-underline-offset: 6px; text-decoration-thickness: 1px; }
  .ct-avail { --fill: color-mix(in srgb, var(--paper) 55%, transparent); pointer-events: none; }
  .ct-meta { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 24px; font-size: 16px; line-height: 1.5; color: var(--ink-2); }
  .ct-meta .clock { color: var(--ink); }
  .ct-else { list-style: none; margin: var(--sp-head) 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--sp-gap); }
  .ct-else a { position: relative; display: flex; justify-content: space-between; align-items: center; padding: 28px var(--sp-card); border-radius: var(--radius); font-family: var(--display); font-size: clamp(30px, 3vw, 44px); line-height: 1.1; letter-spacing: -0.01em; text-decoration: none; transition: background-color 300ms ease-out; }
  @media (hover: hover) { .ct-else a:hover { color-scheme: light; color: var(--ink); background: color-mix(in srgb, var(--paper) 90%, transparent); } .ct-else a:hover .arrow { transform: rotate(-45deg); } }
  .ct-else a:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  .ct-org { margin-top: 0; }
  .ct-close { grid-column: 1 / -1; margin-top: var(--sp-head); }
  @media (max-width: 759.98px) { .ct-else { grid-template-columns: 1fr; } }
</style>
