---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import img2 from '../assets/work/exploring-mental-health-through-3d-storytelling/01.webp';
const testimonials = await getCollection('testimonials');
const clients = await getCollection('clients');
---
<Base title="About" description="Josh McDonald runs Conceptual Studio, a one-person design studio in London for brand identity and data visualisation, mostly for colleges and public institutions.">
  <Masthead page title="Just me, doing the work." meta={[{ label: 'About', note: 'The studio' }, { label: 'Kingston · Tokyo · London' }, { label: 'Est. 2024' }]} lead="I’m Joshua McDonald, and Conceptual Studio is my design practice in London. You work with the person doing the work, from the first call to the final file." />
  <section class="wrap story" aria-labelledby="story">
    <h2 id="story" class="visually-hidden">My story</h2>
    <div class="story__pic"><Image src={img2} alt="A chrome figure in a field of daisies, from my final major project at Kingston" widths={[500, 900, 1300]} sizes="(max-width: 900px) 100vw, 40vw" loading="eager" /></div>
    <div class="story__text prose">
      <p>I trained at Kingston School of Art, where I learned identity systems, layout and how to think in concepts. My final major project was a 3D film about mental health.</p>
      <p>After that I was design lead at Fou Answer, a tech startup in Tokyo, looking after its brand, product interface, website and 3D. Tokyo taught me to work fast in a small team and to care about every part of a product, not just the logo.</p>
      <p>Since January 2026 the studio has been my full-time job. Most of my clients are colleges and public institutions: identities that end up on buses and tube platforms, and data that ends up in front of governors and the public.</p>
      <p style="margin-top: 2rem"><a class="button" href="/contact/">Start a project</a></p>
    </div>
  </section>
  <section class="section wrap" aria-labelledby="clients-title">
    <div class="bar label"><span>Clients <span class="note">(Education, companies, music)</span></span><span></span></div>
    <div class="section-head"><h2 id="clients-title">Who I’ve worked with.</h2></div>
    <ul class="client-list" role="list">{clients.map((c) => <li>{c.data.name}</li>)}</ul>
  </section>
  <section class="section is-dark" aria-labelledby="voices-title">
    <div class="wrap">
      <div class="bar label"><span>In their words <span class="note">(Clients)</span></span><span></span></div>
      <div class="section-head"><h2 id="voices-title">What clients say.</h2></div>
      <ul class="voices" role="list">
        {testimonials.map((t) => <li><figure><blockquote><p>“{t.data.quote}”</p></blockquote><figcaption class="label">{t.data.name}<span class="note">({t.data.role}, {t.data.organisation})</span></figcaption></figure></li>)}
      </ul>
    </div>
  </section>
</Base>
