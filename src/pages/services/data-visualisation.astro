---
import ServicePage from '../../components/ServicePage.astro';
import DataChart from '../../components/DataChart.astro';
import { serviceById } from '../../data/services';
const { demo } = serviceById('data');
---
<ServicePage service="data" description="Charts, maps, infographics and reports from a London design studio, built from your own figures, with starting prices.">
  {demo.heading && (
    <div class="live" slot="demo">
      <div class="live__text">
        <h2 class="mid">{demo.heading}</h2>
        <p>{demo.text}</p>
      </div>
      <div class="live__chart glass" data-lens><DataChart id="dv-chart" /></div>
    </div>
  )}
</ServicePage>

<style>
  .live { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 24px; align-items: start; }
  .live__text { grid-column: 1 / span 4; display: flex; flex-direction: column; gap: 14px; padding-top: 28px; }
  .live__text p { font-size: 18px; line-height: 1.5; max-width: 32ch; }
  .live__chart { position: relative; grid-column: 5 / -1; padding: var(--sp-card); border-radius: var(--radius); }
  @media (max-width: 1099.98px) {
    .live__text, .live__chart { grid-column: 1 / -1; }
    .live__text { padding-top: 0; margin-bottom: 28px; }
  }
</style>
