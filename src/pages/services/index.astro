---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Icon from '../../components/Icon.astro';
import { settings, price } from '../../lib/site.js';
import art from '../../assets/art/engraved/lairesse.webp';
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const from = (s: (typeof services)[number]) => Math.min(...s.data.tiers.filter((t) => t.price).map((t) => t.price as number));
const c = settings.company;
---
<Base title="Services and prices" description="Brand identity and data visualisation for colleges and public institutions, with starting prices, how projects work and supplier details for procurement teams.">
  <PageHead label="Services and prices" title="Two services, done properly." lead="Brand identity and data visualisation. Most of my clients are colleges and public institutions, so the work is built for procurement and for deadlines that don’t move." art={art} />

  <section class="wrap page-section" aria-label="Services" style="padding-top: 0">
    <div class="price-cards">
      {services.map((s, i) => (
        <article class="price-card glass">
          <div class="price-card__top"><span class="micro micro--gold">Service {String(i + 1).padStart(2, '0')}</span><span class="micro muted">From £{price(from(s))}</span></div>
          <h2 class="h3" style="font-size: clamp(2rem, 1.4rem + 1.8vw, 3.25rem)">{s.data.title}</h2>
          <p class="muted">{s.data.short}</p>
          <ul class="tiers" role="list">
            {s.data.tiers.map((t) => (
              <li><span class="tier__name">{t.name}</span><span class="tier__price">{t.price ? <><small>From</small>£{price(t.price)}</> : 'Quote'}</span><span class="tier__time">{t.timeline ?? 'Scoped with you'}</span></li>
            ))}
          </ul>
          <div class="actions">
            <a class="button" href={`/services/${s.id}/`}>Options in detail <Icon name="arrow" /></a>
            <a class="button button--glass" href={`/contact/?service=${encodeURIComponent(s.data.title)}`}>Ask for a quote</a>
          </div>
        </article>
      ))}
    </div>
    <p class="muted small" style="margin-top: 1rem">{settings.pricesNote}</p>
  </section>

  <section class="wrap page-section" aria-labelledby="proc-title">
    <div class="panel glass procurement">
      <div class="head" style="margin-bottom: 2rem"><p class="micro micro--gold head__label">For procurement teams</p><h2 id="proc-title">Supplier details</h2></div>
      <dl>
        <dt>Supplier</dt><dd>{c.name}, a London-based, UK-registered small business. Registered in {c.registeredIn}{c.number && `, company number ${c.number}`}.</dd>
        <dt>VAT</dt><dd>{c.vat ? `VAT number ${c.vat}` : 'Not VAT registered'}</dd>
        <dt>Quotes</dt><dd>A fixed written quote for every project, set out for your quote process on request.</dd>
        <dt>Invoices</dt><dd>30-day payment terms. E-invoices accepted.</dd>
        <dt>Data</dt><dd>Your data is used only for your project and handled under UK GDPR.</dd>
        <dt>References</dt><dd>References from education clients on request.</dd>
      </dl>
    </div>
  </section>
</Base>
