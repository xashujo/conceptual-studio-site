---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Icon from '../../components/Icon.astro';
import { settings, price } from '../../lib/site.js';
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const c = settings.company;
---
<Base title="Services and prices" description="Brand identity and data visualisation for colleges and public institutions, with starting prices, how projects work and supplier details for procurement teams.">
  <PageHead title="Two services, done properly." lead="Brand identity and data visualisation. Most of my clients are colleges and public institutions, so the work is built for procurement and for deadlines that don’t move." />

  <section class="wrap" aria-label="Services">
    <div class="bento">
      {services.map((s) => (
        <article class="tile tile--service" data-reveal>
          <div class="tile__pic"><Image src={s.data.image} alt={s.data.imageAlt} widths={[700, 1100, 1500]} sizes="(max-width: 1000px) 100vw, 50vw" loading="eager" /></div>
          <h2 class="display" style="font-size: clamp(1.9rem, 1.3rem + 1.6vw, 3rem)">{s.data.title}</h2>
          <p class="secondary">{s.data.short}</p>
          <ul class="tiers" role="list">
            {s.data.tiers.map((t) => (
              <li><span class="tier__name">{t.name}</span><span class="tier__price">{t.price ? <><small>from</small>£{price(t.price)}</> : 'Quote'}</span><span class="tier__time">{t.timeline ?? 'Scoped with you'}</span></li>
            ))}
          </ul>
          <div class="actions">
            <a class="button" href={`/services/${s.id}/`}>Options in detail</a>
            <a class="more-link" href={`/contact/?service=${encodeURIComponent(s.data.title)}`}>Ask for a quote <Icon name="arrow" /></a>
          </div>
        </article>
      ))}
    </div>
    <p class="small secondary" style="margin-top: 1.25rem">{settings.pricesNote}</p>
  </section>

  <section class="section wrap" aria-labelledby="proc-title">
    <div class="intro"><h2 id="proc-title">For procurement teams.</h2><p>Everything your finance team will ask for, in one place.</p></div>
    <div class="surface panel procurement">
      <dl>
        <dt>Supplier</dt><dd>{c.name}, a London-based, UK-registered small business. Registered in {c.registeredIn}{c.number && `, company number ${c.number}`}.</dd>
        <dt>VAT</dt><dd>{c.vat ? `VAT number ${c.vat}` : 'Not VAT registered'}</dd>
        <dt>Quotes</dt><dd>A fixed written quote for every project, set out for your quote process on request.</dd>
        <dt>Invoices</dt><dd>30-day payment terms. E-invoices accepted.</dd>
        <dt>Data</dt><dd>Your data is used only for your project and handled under UK GDPR.</dd>
        <dt>References</dt><dd>References from education clients on request.</dd>
      </dl>
    </div>
  </section>
</Base>
