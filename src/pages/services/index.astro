---
// /services/ (brief 6.4) in the home page's design language (Josh, 2 Nov). Monthly plans first, then the
// one-off work in three lanes (video, colleges and data, branding), each with an easy first step, how a
// project runs, and the quote form. Words: Pages CMS > Services page; prices: Services and prices.
import Studio from '../../layouts/Studio.astro';
import Band from '../../components/studio/Band.astro';
import Ladder from '../../components/Ladder.astro';
import Enquiry from '../../components/Enquiry.astro';
import { services } from '../../data/services';
import { home, responseTime } from '../../lib/site';
import { servicesPage as sp, titleCase } from '../../lib/pages';

// The lanes: every service except the retainers, in their CMS order. Their own page, or the form preset to them.
const lanes = services.filter((s) => !s.href?.includes('#'));
const retainer = services.find((s) => s.href?.includes('#'));
const steps = home.steps.map((s) => ({ title: s.title, text: s.text.replaceAll('{reply time}', responseTime) })); // Pages CMS: Home page > How We Work
---
<Studio title="Services and Prices | Conceptual Studio" description={sp.intro} current="/services/" turnstile closeText={sp.closeText}>
  <Band opening labelledby="svc-h">
    <div class="ph__plate glass" data-lens>
      <h1 class="ph__h" id="svc-h">{sp.heading}</h1>
      <p class="ph__p">{sp.intro}</p>
      <p class="ph__p sv-note">{sp.note}</p>
      <div class="acts">
        <a class="btn btn--solid" href="#enquire">{sp.enquiryHeading}</a>
        {retainer && <a class="btn" href="#retainers">{sp.retainersHeading}</a>}
        <a class="btn" href="/procurement/">{sp.procurementButton}</a>
      </div>
    </div>
  </Band>

  {retainer && (
    <Band night id="retainers" labelledby="ret-h">
      <div class="head">
        <h2 class="big" id="ret-h">{sp.retainersHeading}</h2>
        {sp.retainersNote && <p class="lede">{sp.retainersNote}</p>}
      </div>
      <Ladder service={retainer.id} custom={false} />
    </Band>
  )}

  <Band labelledby="lanes-h">
    <div class="head">
      <h2 class="big" id="lanes-h">{sp.listHeading}</h2>
      {sp.listNote && <p class="lede">{sp.listNote}</p>}
    </div>
    <ul class="lanes">
      {lanes.map((s, i) => (
        <li class="lane glass" data-lens data-reveal style={`--i: ${i}`}>
          <p class="lane__k">{s.lane}</p>
          <h3 class="lane__h">{titleCase(s.name)}</h3>
          <p class="lane__p">{s.line}</p>
          <p class="lane__first"><span>{sp.firstStepLabel}</span> {s.tiers[0].name}, <b>{s.tiers[0].price}</b></p>
          <ul class="lane__tiers">
            {s.tiers.slice(1).map((t) => <li><span>{t.name}</span><span>{t.price}</span></li>)}
          </ul>
          {s.href
            ? <a class="btn glass-button lane__go" href={s.href}>{titleCase(s.home.link)} <span class="arrow" aria-hidden="true">→</span></a>
            : <a class="btn glass-button lane__go" href={`?need=${s.id}:${s.tiers[0].id}#enquire`} data-need={`${s.id}:${s.tiers[0].id}`}>{sp.enquiryHeading} <span class="arrow" aria-hidden="true">→</span></a>}
        </li>
      ))}
    </ul>
  </Band>

  <Band night labelledby="how-h">
    <h2 class="big" id="how-h">{sp.howHeading}</h2>
    <ol class="tiles" style="margin-top: var(--sp-head)">
      {steps.map((s, i) => <li class="glass" data-lens data-reveal style={`--i: ${i % 2}`}><h3>{s.title}</h3><p>{s.text}</p></li>)}
    </ol>
    <dl class="terms">
      {sp.terms.map((t) => <div><dt>{t.title}</dt><dd>{t.text}</dd></div>)}
    </dl>
  </Band>

  <Band label={sp.enquiryHeading}>
    <Enquiry heading={sp.enquiryHeading} />
    <div class="quote glass" data-lens data-reveal>
      <h3 class="mid">{sp.procurementHeading}</h3>
      <p class="quote__p">{sp.procurementText}</p>
      <a class="btn glass-button" href="/procurement/">{sp.procurementButton} <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </Band>
</Studio>

<style>
  .sv-note { font-size: 17px; color: var(--ink-2); }
  .lanes { list-style: none; margin: var(--sp-head) 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--sp-gap); }
  .lane { position: relative; display: flex; flex-direction: column; gap: 12px; padding: var(--sp-card); border-radius: var(--radius); }
  .lane__k { font-size: 14px; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 600; color: var(--ink-2); }
  .lane__h { font-family: var(--display); font-size: 30px; line-height: 1.08; font-weight: 500; letter-spacing: -0.01em; }
  .lane__p { font-size: 17px; line-height: 1.5; }
  .lane__first { margin-top: 6px; padding: 14px 16px; border-radius: var(--radius-inner); background: color-mix(in srgb, var(--ink) 6%, transparent); font-size: 17px; line-height: 1.4; }
  .lane__first span { display: block; font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 600; color: var(--ink-2); }
  .lane__first b { font-weight: 600; }
  .lane__tiers { list-style: none; margin: 0 0 8px; padding: 0; font-size: 16px; line-height: 1.4; }
  .lane__tiers li { display: flex; justify-content: space-between; gap: 16px; padding-block: 9px; border-top: 1px solid color-mix(in srgb, var(--ink) 14%, transparent); }
  .lane__tiers li span:last-child { font-weight: 600; text-align: right; font-variant-numeric: tabular-nums; }
  .lane__go { margin-top: auto; align-self: flex-start; }
  .terms { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--sp-gap); margin: var(--sp-head) 0 0; padding-top: 24px; border-top: 1px solid color-mix(in srgb, var(--ink) 22%, transparent); }
  .terms dt { font-size: 18px; font-weight: 600; margin-bottom: 6px; }
  .terms dd { margin: 0; font-size: 17px; line-height: 1.5; color: var(--ink-2); max-width: 36ch; }
  @media (max-width: 1099.98px) { .lanes, .terms { grid-template-columns: 1fr; } }
</style>
