---
// /services/ (brief 6.4): what I do, who for, how projects work, one entry per service,
// the procurement block, and a custom quote form.
import Site from '../../layouts/Site.astro';
import PageOpen from '../../components/PageOpen.astro';
import Stages from '../../components/Stages.astro';
import Enquiry from '../../components/Enquiry.astro';
import Ladder from '../../components/Ladder.astro';
import { services, serviceById } from '../../data/services';
import { email } from '../../site';
import art from '../../assets/art/engraved/hunt-sky-gold.jpg';

const procurement = [
  ['Company', 'Conceptual Studio Limited, a London-based SME registered in England and Wales.'],
  ['Company number', '[TBC]'],
  ['Registered office', '[TBC: the address, or a registered-office service. UK law asks for it on the website]'],
  ['VAT', '[TBC: VAT number, or not VAT-registered]'],
  ['Insurance', '[TBC: professional indemnity and public liability cover, only if held]'],
  ['Payment', '30-day terms. E-invoices accepted. [TBC: confirm both]'],
  ['Accessible files', 'Accessible PDFs, and charts supplied with their data tables. [TBC: confirm the standard, such as WCAG 2.2 AA]'],
  ['Data protection', '[TBC: a short statement on how client data is stored and deleted]'],
  ['Quality and environment', '[TBC: short statements]'],
  ['References', 'Two references on request. [TBC: confirm]'],
];
---
<Site title="Services and prices | Conceptual Studio" description="Brand identity, data visualisation and social media editing from a London design studio, with starting prices and how projects run." current="services" turnstile>
  <main>
    <PageOpen word={['Services']} art={art} size="clamp(96px, 27.5vw, 420px)" who="Conceptual Studio, London" what="Brand identity, data visualisation and social media editing">
      <a class="link" href="#enquire">Start a project<span class="arrow" aria-hidden="true">→</span></a>
    </PageOpen>

    <section class="intro wrap" aria-label="Who I work with">
      <p class="intro__lead">I design brand identities and data visualisation, and edit short videos for social media. I work with further education colleges and adult learning services, a language school in Oxford, a tech startup in Tokyo and corporate clients.</p>
      <p class="intro__note">Every project is priced on its scope, so the prices here are starting points. You’ll get a fixed quote after our first call.</p>
    </section>

    <section class="svc wrap" aria-labelledby="svc-h">
      <h2 class="h2 sr" id="svc-h">What I do</h2>
      {services.map((s) => (
        <article class="svc__row">
          <h3 class="svc__name">{s.href ? <a href={s.href}>{s.name}</a> : s.name}</h3>
          <p class="svc__from">{s.tiers[0].price}{s.tiers[0].time && <span>, {s.tiers[0].time}</span>}</p>
          <p class="svc__line">{s.line}</p>
          <p class="svc__go">
            {s.href
              ? <a class="btn" href={s.href}><span class="swap"><span>{s.href.includes('#') ? 'See the tiers' : 'Prices and work'}</span><span aria-hidden="true">Open the page</span></span><span class="arrow" aria-hidden="true">→</span></a>
              : <a class="btn" href={`?need=${s.id}:unsure#enquire`} data-need={`${s.id}:unsure`}><span class="swap"><span>Ask about editing</span><span aria-hidden="true">Open the form</span></span><span class="arrow" aria-hidden="true">→</span></a>}
          </p>
        </article>
      ))}
    </section>

    <!-- Retainers have no page of their own: their tiers sit here (Pages CMS: Services and prices > Monthly design retainers). -->
    <section class="ret wrap" id="retainers" aria-labelledby="ret-h">
      <div class="ret__head">
        <h2 class="h2" id="ret-h">Monthly retainers</h2>
        <p>{serviceById('retainer').line} Three-month minimum, then month to month with 30 days' notice.</p>
      </div>
      <Ladder service="retainer" custom={false} />
    </section>

    <section class="how wrap" aria-labelledby="how-h">
      <h2 class="h2 how__h" id="how-h">How a project runs</h2>
      <Stages />
      <dl class="how__terms">
        <div><dt>Timelines</dt><dd>The times on these pages are calendar time, from our first call to your final files, feedback rounds included.</dd></div>
        <div><dt>What I need from you</dt><dd>[TBC: what clients supply, such as existing brand files, figures and who signs work off]</dd></div>
        <div><dt>Quotes and invoices</dt><dd>A fixed quote for the agreed scope, sent within three working days of our call. [TBC: deposit, invoice stages and whether prices include VAT]</dd></div>
      </dl>
    </section>

    <section class="proc wrap" aria-labelledby="proc-h">
      <div class="proc__side">
        <h2 class="h2" id="proc-h">For procurement teams</h2>
        <p>What your finance team needs to set me up as a supplier. The supplier pack has all of it in one PDF.</p>
        <p><a class="link" href={`mailto:${email}?subject=Supplier%20pack`}>Ask for the supplier pack<span class="arrow" aria-hidden="true">→</span></a></p>
      </div>
      <dl class="proc__list">
        {procurement.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </section>

    <Enquiry heading="Ask for a quote" />
  </main>
</Site>

<style>
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .intro { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 24px; padding-top: 160px; }
  .intro__lead { grid-column: 1 / span 8; font-size: 24px; line-height: 1.4; letter-spacing: -0.01em; font-weight: 500; max-width: 40ch; text-wrap: pretty; }
  .intro__note { grid-column: 1 / span 6; margin-top: 24px; font-size: 20px; line-height: 1.45; color: var(--ink-2); }

  /* One ruled row per service: the Framer card's head (title left, price right, hairline) without the image. */
  .svc { padding-top: 120px; }
  .svc__row { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 24px; row-gap: 12px; padding-block: 0 72px; }
  .svc__row::before { content: ''; grid-column: 1 / -1; grid-row: 2; height: 0; border-top: 1px solid var(--ink); margin-block: 4px 12px; }
  .svc__name { grid-column: 1 / span 7; grid-row: 1; font-size: 40px; line-height: 1.2; font-weight: 700; letter-spacing: -0.045em; }
  .svc__name a { text-decoration: none; }
  .svc__from { grid-column: 8 / -1; grid-row: 1; justify-self: end; align-self: end; padding-bottom: 6px; font-size: 20px; line-height: 1.3; font-weight: 500; text-align: right; }
  .svc__from span { color: var(--ink-2); font-weight: 400; }
  .svc__line { grid-column: 1 / span 6; grid-row: 3; font-size: 20px; line-height: 1.45; }
  .svc__go { grid-column: 8 / -1; grid-row: 3; justify-self: end; align-self: start; }

  .ret { padding-top: 120px; scroll-margin-top: 24px; }
  .ret__head { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 24px; margin-bottom: 32px; align-items: end; }
  .ret__head h2 { grid-column: 1 / span 4; }
  .ret__head p { grid-column: 6 / -1; font-size: 18px; line-height: 1.5; color: var(--ink-2); max-width: 56ch; }

  .how { padding-top: 160px; }
  .how__h { margin-bottom: 24px; }
  .how__terms { margin: 56px 0 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .how__terms dt { font-size: 16px; font-weight: 600; margin-bottom: 6px; }
  .how__terms dd { margin: 0; font-size: 16px; line-height: 1.5; color: var(--ink-2); max-width: 36ch; }

  .proc { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 24px; padding-top: 160px; padding-bottom: 160px; }
  .proc__side { grid-column: 1 / span 4; display: flex; flex-direction: column; gap: 14px; align-self: start; position: sticky; top: 32px; }
  .proc__side p { font-size: 18px; line-height: 1.5; max-width: 32ch; }
  .proc__list { grid-column: 6 / -1; margin: 0; border-top: 1px solid var(--ink); }
  .proc__list div { display: grid; grid-template-columns: 200px 1fr; gap: 24px; padding-block: 14px; border-bottom: 1px solid color-mix(in srgb, var(--ink) 18%, transparent); }
  .proc__list dt { font-size: 16px; font-weight: 600; line-height: 1.5; }
  .proc__list dd { margin: 0; font-size: 16px; line-height: 1.5; }

  @media (max-width: 1099.98px) {
    .intro__lead { grid-column: 1 / -1; font-size: 24px; }
    .intro__note { grid-column: 1 / span 9; }
    .proc__side { grid-column: 1 / -1; position: static; margin-bottom: 32px; }
    .proc__list { grid-column: 1 / -1; }
    .ret__head h2, .ret__head p { grid-column: 1 / -1; }
    .ret__head p { margin-top: 12px; }
  }
  @media (max-width: 759.98px) {
    .intro { padding-top: 112px; }
    .intro__lead { font-size: 20px; line-height: 1.45; }
    .intro__note { grid-column: 1 / -1; font-size: 18px; }
    .svc { padding-top: 80px; }
    .svc__row { grid-template-columns: 1fr; padding-block: 0 56px; row-gap: 8px; }
    .svc__row::before { grid-row: 2; margin-block: 2px 8px; }
    .svc__name { grid-row: 1; }
    .svc__from { grid-row: 3; }
    .svc__line { grid-row: 4; }
    .svc__go { grid-row: 5; }
    .svc__name, .svc__from, .svc__line, .svc__go { grid-column: 1; justify-self: start; text-align: left; }
    .svc__name { font-size: 30px; }
    .svc__line { font-size: 18px; }
    .svc__go { margin-top: 10px; }
    .how, .proc { padding-top: 112px; }
    .proc { padding-bottom: 112px; }
    .how__terms { grid-template-columns: 1fr; }
    .proc__list div { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
