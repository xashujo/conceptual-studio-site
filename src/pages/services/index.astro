---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Masthead from '../../components/Masthead.astro';
import Icon from '../../components/Icon.astro';
import { settings, price } from '../../lib/site.js';
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const c = settings.company;
---
<Base title="Services and prices" description="Brand identity and data visualisation for colleges and public institutions, with starting prices, how projects work and supplier details for procurement teams.">
  <Masthead page title="Two services, done properly." meta={[{ label: 'Services', note: 'And prices' }, { label: 'Brand identity · Data visualisation' }, { label: 'Fixed quotes' }]} lead="Most of my clients are colleges and public institutions, so the work is built for procurement and for deadlines that don’t move." />
  <section class="wrap" aria-label="Services">
    <div class="price-list">
      {services.map((s) => (
        <article class="service">
          <div class="service__head"><h2 class="display" style="font-size: clamp(2rem, 1.4rem + 1.6vw, 3rem)">{s.data.title}</h2><a class="arrow-link label" href={`/services/${s.id}/`}>Options in detail <Icon name="arrow" /></a></div>
          <p class="secondary">{s.data.short}</p>
          <ul class="tiers" role="list">
            {s.data.tiers.map((t) => <li><span class="tier__name">{t.name}</span><span class="tier__price">{t.price ? <><small>From</small>£{price(t.price)}</> : 'Quote'}</span><span class="tier__time label">{t.timeline ?? 'Scoped with you'}</span></li>)}
          </ul>
        </article>
      ))}
    </div>
    <div class="quote-strip"><p>{settings.pricesNote}</p><a class="button" href="/contact/">Ask for a quote</a></div>
  </section>
  <section class="section wrap" aria-labelledby="proc-title">
    <div class="bar label"><span>For procurement teams <span class="note">(Supplier details)</span></span><span></span></div>
    <div class="two-col" style="margin-top: 2rem">
      <h2 id="proc-title">Everything finance will ask for.</h2>
      <dl class="procurement">
        <dt class="label">Supplier</dt><dd>{c.name}, a London-based, UK-registered small business. Registered in {c.registeredIn}{c.number && `, company number ${c.number}`}.</dd>
        <dt class="label">VAT</dt><dd>{c.vat ? `VAT number ${c.vat}` : 'Not VAT registered'}</dd>
        <dt class="label">Quotes</dt><dd>A fixed written quote for every project, set out for your quote process on request.</dd>
        <dt class="label">Invoices</dt><dd>30-day payment terms. E-invoices accepted.</dd>
        <dt class="label">Data</dt><dd>Your data is used only for your project and handled under UK GDPR.</dd>
        <dt class="label">References</dt><dd>References from education clients on request.</dd>
      </dl>
    </div>
  </section>
</Base>
