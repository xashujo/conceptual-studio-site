---
// Case study template (brief 6.3) in the home page's design language (Josh, 2 Nov). Bands alternate day and
// night: the opening plate with the credits and the lead image; the problem and what I did; the work;
// what happened; the next project; then the close. The project's own words and images come from
// Pages CMS > Projects; the headings from Pages CMS > Case study pages.
import { Image, getImage } from 'astro:assets';
import Studio from '../../layouts/Studio.astro';
import Band from '../../components/studio/Band.astro';
import PlateCaption from '../../components/PlateCaption.astro';
import Carousel from '../../components/Carousel.astro';
import { caseStudies, bySlug, type Plate } from '../../data/work';
import { caseStudyPage as t } from '../../lib/pages';
import { bento, ratioOf } from '../../lib/bento';
import sharp from 'sharp';

export function getStaticPaths() {
  return caseStudies.map((cs) => ({ params: { slug: cs.slug }, props: { cs } }));
}
const { cs } = Astro.props;
const p = bySlug(cs.slug);
const next = bySlug(cs.next);
const cap = (pl: Plate) => ({ title: p.client.startsWith(p.title) ? `${p.title}, ${p.year}` : `${p.title}, ${p.client}, ${p.year}`, medium: pl.medium });
// Credits sit on one line each (Josh, 4 Nov: the four-column row with the outcome felt stuffy). The outcome
// field still shows on the home page's Selected Work cards.
// Bento (lib/bento.ts, Josh 4 Nov: Apple-style, and the Oxford School of English way across every case study).
// Artwork sits whole on a flat field of its own edge colour with room around it, never cropped to the tile.
// A photograph (its edges vary) fills its tile instead when that trims less than 45%.
// Charts and screens (the data projects) are never cropped (Josh, 4 Nov): they always sit padded.
const charts = p.tags.includes('data');
const edge = async (img: ImageMetadata) => {
  const { data, info } = await sharp((img as ImageMetadata & { fsPath: string }).fsPath).resize(48, 48, { fit: 'fill' }).removeAlpha().raw().toBuffer({ resolveWithObject: true });
  const ring: number[][] = [[], [], []];
  for (let y = 0; y < info.height; y++) for (let x = 0; x < info.width; x++) {
    if (x > 1 && y > 1 && x < info.width - 2 && y < info.height - 2) continue;
    for (let c = 0; c < 3; c++) ring[c].push(data[(y * info.width + x) * 3 + c]);
  }
  const spread = ring.reduce((sum, v) => { const m = v.reduce((a, b) => a + b, 0) / v.length; return sum + Math.sqrt(v.reduce((a, b) => a + (b - m) ** 2, 0) / v.length); }, 0) / 3;
  const photo = !charts && spread > 6;
  // Artwork: find where the art itself sits inside its flat margin, so every piece gets the same breathing room.
  let box = { x: 0, y: 0, w: 1, h: 1 };
  if (!photo) {
    const small = await sharp((img as ImageMetadata & { fsPath: string }).fsPath).resize(400, 400, { fit: 'inside' }).toBuffer({ resolveWithObject: true });
    const t = await sharp(small.data).trim({ threshold: 24 }).toBuffer({ resolveWithObject: true }).catch(() => undefined);
    if (t && t.info.trimOffsetLeft !== undefined) {
      const W = small.info.width, H = small.info.height;
      box = { x: -t.info.trimOffsetLeft! / W, y: -t.info.trimOffsetTop! / H, w: t.info.width / W, h: t.info.height / H };
    }
  }
  return { bg: `rgb(${ring.map((v) => v.sort((a, b) => a - b)[v.length >> 1]).join(' ')})`, photo, box };
};
// A tile is a picture (with an optional silent loop) or words: the outcome, a figure, a quote, a paragraph.
type Words = { kind: 'headline'; text: string } | { kind: 'stat'; value: string; label: string } | { kind: 'quote'; quote: string; by: string };
type Piece = { kind: 'image'; plate: Plate & { video?: string }; label: string } | Words;
// The shape each kind of words would like, and how little a poor fit matters to it.
const wordShape = { headline: [3.2, 1], stat: [1.8, 0.4], quote: [1.5, 0.5] } as const;
const layout = async (pieces: Piece[], flip = false) => {
  const looks = await Promise.all(pieces.map((pc) => (pc.kind === 'image' ? edge(pc.plate.image) : undefined)));
  const items = pieces.map((pc, i) => pc.kind === 'image'
    ? { ratio: (pc.plate.image.width * looks[i]!.box.w) / (pc.plate.image.height * looks[i]!.box.h), weight: looks[i]!.photo ? 3 : 1 }
    : { ratio: wordShape[pc.kind][0], weight: wordShape[pc.kind][1] });
  return bento(items, flip).map((tile) => {
    const pc = pieces[tile.index], look = looks[tile.index];
    const fit = items[tile.index].ratio / ratioOf(tile);
    const fill = !!look?.photo && Math.min(fit, 1 / fit) > 0.55;
    // CSS for the art: its trimmed box, centred and contained in the tile's padded area (see .tile__art).
    const b = look?.box ?? { x: 0, y: 0, w: 1, h: 1 };
    const art = pc.kind === 'image' && !fill
      ? `--bg: ${look!.bg}; --r: ${items[tile.index].ratio.toFixed(4)}; --R: ${(pc.plate.image.width / pc.plate.image.height).toFixed(4)}; --bx: ${b.x.toFixed(4)}; --by: ${b.y.toFixed(4)}; --bw: ${b.w.toFixed(4)}; --bh: ${b.h.toFixed(4)}`
      : `--bg: ${look?.bg ?? 'transparent'}`;
    return { ...tile, pc, art, fill, bg: look?.bg };
  });
};
const shots = (plates: Plate[]): Piece[] => plates.map((pl) => ({ kind: 'image', plate: pl, label: pl.medium }));
const chapters = await Promise.all(cs.chapters.map(async (ch, i) => ({ ...ch, tiles: await layout(shots(ch.plates), i % 2 === 1) })));
// Outcomes (Josh, 4 Nov): one bento of what the work did. The figures lead when there are any (the data
// projects); otherwise the one-line outcome does. Then feedback, before and after, and the work in the world.
const bare = (x: string) => x.replace(/\W/g, '').toLowerCase();
const same = (a: string, b: string) => !!b && (bare(a).includes(bare(b)) || bare(b).includes(bare(a)));
const [beforeLabel, afterLabel] = t.beforeAfterHeading.split('&').map((x) => x.trim());
const outcomePieces: Piece[] = [
  ...(cs.stats.length ? [] : cs.outcome ? [{ kind: 'headline', text: cs.outcome } as const] : []),
  ...cs.stats.map((x) => ({ kind: 'stat', ...x } as const)),
  ...cs.quotes.map((q) => ({ kind: 'quote', quote: q.quote, by: [q.name, q.role, q.organisation].filter(Boolean).join(', ') } as const)),
  ...(cs.before ? [{ kind: 'image', plate: cs.before.before, label: beforeLabel || cs.before.before.medium } as const, { kind: 'image', plate: cs.before.after, label: afterLabel || cs.before.after.medium } as const] : []),
  ...cs.outcomeImages.map((pl) => ({ kind: 'image', plate: pl, label: pl.medium } as const)),
];
const outcomes = await layout(outcomePieces, cs.chapters.length % 2 === 1);
// What Happened sits beside the heading, like a chapter's words, unless it only repeats the outcome line.
const happened = cs.happened.filter((x) => !same(x, cs.outcome));
const credits = [[t.clientLabel, p.client], [t.disciplinesLabel, p.disciplines.join(', ')]].filter(([, v]) => v);
// Opener: the project's title graphic when it has one (Josh, 4 Nov: a photo of the work in a street is a weak
// opener), else the cover. The title graphic gets no second caption line (Josh, 4 Nov: "(Title graphic)" said nothing).
const lead = p.thumb
  ? { image: p.thumb, alt: `${p.title} title graphic`, medium: '' }
  : { image: p.image, alt: p.alt, medium: p.medium };
// The opening clip plays once and holds its last frame; the poster is that frame, so nothing jumps.
const heroPoster = cs.heroVideo ? (await getImage({ src: cs.heroVideo.poster, width: 1080, format: 'webp' })).src : undefined;
---
<Studio title={p.title} description={p.summary} current="/work/" closeText={t.closeText}>
  <Band opening class="cs-open" labelledby="cs-h">
    <div class="ph__plate glass cs-plate" data-lens>
      <a class="btn cs-back" href="/work/"><span class="arrow arrow--back" aria-hidden="true">←</span> {t.backLabel}</a>
      <h1 class="ph__h cs-h" id="cs-h">{p.title}</h1>
      <p class="ph__p">{p.summary}</p>
      <dl class="cs-credits">
        {credits.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
        <div><dt>Year</dt><dd>{p.year}</dd></div>
      </dl>
      {cs.demo && <a class="btn btn--solid cs-demo" href={cs.demo.href} target="_blank" rel="noopener">{cs.demo.label} <span class="arrow arrow--out" aria-hidden="true">↗</span></a>}
    </div>
    <figure class="cs-lead">
      {cs.heroVideo ? (
        <video class="cs-lead__video" data-reveal-video muted playsinline preload="metadata" poster={heroPoster} aria-label={cs.heroVideo.alt} width={cs.heroVideo.poster.width} height={cs.heroVideo.poster.height}>
          <source src={cs.heroVideo.video} type="video/mp4" />
        </video>
      ) : (
        <Image src={lead.image} alt={lead.alt} widths={[800, 1400, 2000]} sizes="(min-width: 1200px) 1140px, 95vw" loading="eager" fetchpriority="high" />
      )}
      <PlateCaption {...cap(lead)} />
    </figure>
  </Band>

  {(cs.problem.length > 0 || cs.did.length > 0) && (
    <Band night label={`${t.problemHeading}, ${t.didHeading}`}>
      <div class="cs-two">
        {cs.problem.length > 0 && <div class="pane glass" data-lens data-reveal><h2 class="mid">{t.problemHeading}</h2><div class="flow cs-text">{cs.problem.map((x) => (x.startsWith('- ') ? <ul class="cs-list">{x.split('\n').map((l) => <li>{l.replace(/^-\s*/, '')}</li>)}</ul> : <p>{x}</p>))}</div></div>}
        {cs.did.length > 0 && <div class="pane glass" data-lens data-reveal style="--i: 1"><h2 class="mid">{t.didHeading}</h2><div class="flow cs-text">{cs.did.map((x) => (x.startsWith('- ') ? <ul class="cs-list">{x.split('\n').map((l) => <li>{l.replace(/^-\s*/, '')}</li>)}</ul> : <p>{x}</p>))}</div></div>}
      </div>
    </Band>
  )}

  <Band labelledby="the-work">
    <h2 class="big" id="the-work">{t.workHeading}</h2>
    <!-- Chapters (Katseye-style, Josh 4 Nov): a short heading and paragraph, then that chapter's images.
         On a phone each chapter's images become one swipeable gallery (Carousel.astro); from 760px up, a bento. -->
    {chapters.map((ch, i) => (
      <section class:list={['cs-chapter', { 'cs-chapter--titled': ch.heading }]} aria-label={ch.heading ?? undefined}>
        {ch.heading && (
          <div class="cs-chapter__head" data-reveal>
            <h3 class="mid">{ch.heading}</h3>
            {ch.text.length > 0 && <div class="flow cs-text">{ch.text.map((x) => <p>{x}</p>)}</div>}
          </div>
        )}
        <Carousel label={`${ch.heading ?? t.workHeading}: gallery`}>
          <div class="bento">
            {ch.tiles.map(({ pc, bg, art, fill, col, row, w, h }) => pc.kind === 'image' && (
              <figure class:list={['tile', 'glass', { 'tile--fill': fill }]} style={`grid-area: ${row} / ${col} / span ${h} / span ${w}; --tile: ${bg}; ${art}`}>
                <div class="tile__art"><Image src={pc.plate.image} alt={pc.plate.alt} widths={[600, 1000, 1600, 2200]} sizes={`(min-width: 760px) ${Math.round((w / 6) * 1140)}px, 100vw`} /></div>
                <PlateCaption {...cap(pc.plate)} />
              </figure>
            ))}
          </div>
        </Carousel>
      </section>
    ))}
  </Band>

  {outcomes.length > 0 && (
    <Band night labelledby="outcomes">
      <div class:list={['cs-outcomes__head', { 'cs-outcomes__head--text': happened.length }]}>
        <h2 class="big" id="outcomes">{t.happenedHeading}</h2>
        {happened.length > 0 && <div class="flow cs-text" data-reveal>{happened.map((x) => (x.startsWith('- ') ? <ul class="cs-list">{x.split('\n').map((l) => <li>{l.replace(/^-\s*/, '')}</li>)}</ul> : <p>{x}</p>))}</div>}
      </div>
      <div class="bento-wrap"><div class="bento bento--outcomes">
        {outcomes.map(({ pc, bg, art, fill, col, row, w, h }) => {
          const area = `grid-area: ${row} / ${col} / span ${h} / span ${w}`;
          if (pc.kind === 'image') return (
            <figure class:list={['tile', 'glass', { 'tile--fill': fill }]} style={`${area}; --tile: ${bg}; ${art}`}>
              <div class="tile__art">
                {pc.plate.video
                  ? <video data-loop muted loop playsinline preload="none" poster={pc.plate.image.src} aria-label={pc.plate.alt}><source src={pc.plate.video} type="video/mp4" /></video>
                  : <Image src={pc.plate.image} alt={pc.plate.alt} widths={[600, 1000, 1600, 2200]} sizes={`(min-width: 760px) ${Math.round((w / 6) * 1140)}px, 100vw`} />}
              </div>
              {pc.label && <figcaption class="tile__label">{pc.label}</figcaption>}
            </figure>
          );
          return (
            <div class:list={['tile', 'glass', 'tile--words', `tile--${pc.kind}`]} style={area}>
              {pc.kind === 'headline' && <p class="tile__headline">{pc.text}</p>}
              {pc.kind === 'stat' && <p class="tile__stat"><b>{pc.value}</b><span>{pc.label}</span></p>}
              {pc.kind === 'quote' && <blockquote class="tile__quote"><p>{pc.quote}</p><footer>{pc.by}</footer></blockquote>}
            </div>
          );
        })}
      </div></div>
    </Band>
  )}

  <Band label={t.nextLabel}>
    <a class="next glass" href={`/work/${next.slug}/`} data-lens data-reveal>
      <Image class="next__img" src={next.thumb ?? next.image} alt="" widths={[400, 700]} sizes="(min-width: 760px) 360px, calc(100vw - 76px)" style={!next.thumb && next.position ? `object-position: ${next.position}` : undefined} />
      <span class="next__text">
        <span class="next__label">{t.nextLabel}</span>
        <span class="next__title">{next.title}</span>
        <span class="next__line">{next.summary}</span>
      </span>
      <!-- A small round button instead of a display-size arrow (Josh, 4 Nov); it goes dark on hover like the pills. -->
      <span class="next__go" aria-hidden="true"><svg viewBox="0 0 20 20" width="20" height="20"><path d="M4 10h11M11 5.5 15.5 10 11 14.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
    </a>
  </Band>
</Studio>

<script>
  // Play the opening clip once, unless the visitor has asked for less motion (they keep the still).
  const v = document.querySelector<HTMLVideoElement>('[data-reveal-video]');
  if (v && !matchMedia('(prefers-reduced-motion: reduce)').matches) v.play().catch(() => {});
  // Outcome loops play like a GIF while on screen, and not at all for visitors who ask for less motion.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver((es) => es.forEach((e) => { const el = e.target as HTMLVideoElement; e.isIntersecting ? el.play().catch(() => {}) : el.pause(); }));
    document.querySelectorAll<HTMLVideoElement>('[data-loop]').forEach((el) => io.observe(el));
  }
</script>

<style>
  .cs-plate { gap: 18px; }
  .cs-back { --fill: color-mix(in srgb, var(--paper) 55%, transparent); gap: 8px; }
  @media (hover: hover) { .cs-back:hover .arrow { --turn: -45deg; } }
  .cs-h { font-size: clamp(52px, 6.6vw, 104px); max-width: 16ch; }
  .cs-credits { display: flex; flex-wrap: wrap; justify-content: center; gap: 16px 64px; width: 100%; margin: 10px 0 0; padding-top: 28px; border-top: 1px solid color-mix(in srgb, var(--ink) 18%, transparent); text-align: center; }
  .cs-credits dt { font-size: 15px; color: var(--ink-2); }
  .cs-credits dd { margin: 4px 0 0; white-space: nowrap; font-size: 19px; line-height: 1.35; font-weight: 500; letter-spacing: -0.01em; }
  /* The lead exhibit keeps its own shape (a portrait poster stays portrait), as tall as the screen allows. */
  .cs-lead { margin-top: var(--sp-gap); text-align: center; }
  .cs-lead__video { display: block; width: auto; max-width: 100%; height: auto; max-height: 86svh; margin-inline: auto; border-radius: var(--radius-inner); background: #000; }
  .cs-lead img { width: auto; max-width: 100%; height: auto; max-height: 86svh; margin-inline: auto; border-radius: var(--radius-inner); }

  .cs-two { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-gap); align-items: start; }
  .cs-two .mid, .cs-happened .mid { margin-bottom: 20px; }
  .cs-text p, .cs-list { font-size: 19px; line-height: 1.55; max-width: 62ch; }
  /* A paragraph whose lines start with "- " is a bulleted list (Josh, 4 Nov). */
  .cs-list { margin: 0; padding-left: 1.2em; display: grid; gap: 8px; }
  .cs-happened { max-width: 820px; }

  /* Bento (lib/bento.ts places every tile). Six columns, tight even gutters, rows three quarters of a column
     tall, so tile shapes hold at any width. Captions sit inside the tile as a small pill, as on Apple's grids. */
  .bento { --g: 12px; --u: calc((100cqi - 5 * var(--g)) / 6); display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); grid-auto-rows: calc(0.75 * var(--u)); gap: var(--g); }
  @media (min-width: 760px) {
    :global(.carousel):has(> .carousel__track > .bento) { container-type: inline-size; margin-top: var(--sp-head); }
    .bento-wrap { container-type: inline-size; }
  }
  .bento-wrap { margin-top: var(--sp-head); }
  /* Every tile is a glass panel (Josh, 4 Nov: "The Bento cards should be Glass"). The work sits inside it on
     its own colour, one even step in from the glass edge. */
  .tile { --in: 10px; position: relative; display: flex; flex-direction: column; min-width: 0; min-height: 0; margin: 0; border-radius: 24px; }
  /* The Oxford way: flat colour all round the artwork, never touching the tile's edge. */
  /* The art's own box (bx, by, bw, bh: fractions of the image) is scaled to fit the area inside the padding,
     then the whole image is placed so that box sits in the middle. Its margin is the tile's colour anyway. */
  /* Shown small with generous room (TASTE: never too large): the art takes at most 56% of the width and 52% of the height. */
  .tile__art { --lift: 10px; --cw: min(56cqw, 52cqh * var(--r)); }
  .tile__art :is(img, video) { position: absolute; display: block; max-width: none; width: calc(var(--cw) / var(--bw)); height: calc(var(--cw) / var(--bw) / var(--R)); left: calc(50% - var(--cw) / var(--bw) * (var(--bx) + var(--bw) / 2)); top: calc(50% - var(--lift) - var(--cw) / var(--bw) / var(--R) * (var(--by) + var(--bh) / 2)); }
  .tile--fill .tile__art :is(img, video) { inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .tile__art { position: absolute; inset: var(--in); overflow: hidden; border-radius: calc(24px - var(--in)); background: var(--tile); container-type: size; }
  .tile :global(.plate), .tile__label { position: absolute; left: calc(var(--in) + 10px); bottom: calc(var(--in) + 10px); margin: 0; padding: 6px 12px; border-radius: 999px; background: rgb(255 255 255 / 0.78); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); color: #1c1a17; font-size: 12px; line-height: 1.3; font-weight: 600; letter-spacing: 0.02em; text-transform: none; }
  .tile :global(.plate b) { display: none; }
  .tile :global(.plate span) { font-weight: 600; color: inherit; }
  .tile :global(.plate span::before), .tile :global(.plate span::after) { content: none; }
  /* Words tiles: the outcome, a figure, a quote, a paragraph. Type scales with the tile. */
  /* Words tiles are plain glass (Josh, 4 Nov: no pictures behind words). */
  .tile--words { justify-content: flex-end; padding: clamp(28px, 7cqmin, 48px); container-type: size; }
  .tile--words p, .tile__quote { margin: 0; }
  .tile--headline { justify-content: center; }
  .tile__headline { font-family: var(--display); font-size: clamp(30px, min(30cqh, 7cqw), 92px); line-height: 1.02; letter-spacing: -0.01em; max-width: 22ch; }
  .tile__stat b { display: block; font-family: var(--display); font-weight: 400; font-size: clamp(56px, min(62cqh, 40cqw), 180px); line-height: 0.95; letter-spacing: -0.02em; font-variant-numeric: lining-nums; }
  .tile__stat span { display: block; margin-top: 10px; font-size: clamp(15px, 5cqmin, 19px); line-height: 1.35; color: var(--ink-2); max-width: 24ch; }
  .tile--quote { justify-content: space-between; }
  .tile__quote p { font-family: var(--display); font-size: clamp(19px, 8cqmin, 34px); line-height: 1.25; }
  .tile__quote p::before { content: '\201C'; } .tile__quote p::after { content: '\201D'; }
  .tile__quote footer { margin-top: 16px; font-size: 14px; font-weight: 600; color: var(--ink-2); }
  .cs-outcomes__head--text { display: grid; grid-template-columns: 5fr 7fr; gap: var(--sp-gap); align-items: end; }
  .cs-outcomes__head--text .big { margin: 0; }
  /* A titled chapter: heading left, a short paragraph right, on one hairline, then its images. */
  .cs-chapter--titled { margin-top: clamp(80px, 9vw, 120px); }
  .big + .cs-chapter--titled { margin-top: var(--sp-head); }
  .cs-chapter__head { display: grid; grid-template-columns: 5fr 7fr; gap: var(--sp-gap); align-items: baseline; padding-top: 24px; border-top: 1px solid color-mix(in srgb, var(--ink) 18%, transparent); }
  .cs-chapter__head .mid { margin: 0; }

  .next { position: relative; display: grid; grid-template-columns: 360px minmax(0, 1fr) auto; gap: 32px; align-items: center; padding: 12px; border-radius: var(--radius); text-decoration: none; transition: background-color 300ms ease-out; }
  .next__img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border-radius: var(--radius-inner); }
  .next__text { display: grid; gap: 10px; padding-right: 20px; }
  .next__label { font-size: 15px; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 600; color: var(--ink-2); }
  .next__title { font-family: var(--display); font-size: clamp(36px, 4.4vw, 64px); line-height: 1; letter-spacing: -0.01em; }
  /* The round button sits on the card like the other buttons: lit top edge, contact shadow, soft lift. */
  .next__go { display: grid; place-items: center; width: 56px; height: 56px; margin-right: 20px; border-radius: 50%; background: color-mix(in srgb, #FFFAF0 70%, var(--paper)); box-shadow: inset 0 1px 0 rgb(255 252 245 / 0.9), inset 0 -1px 0 rgb(40 24 8 / 0.10), 0 0 0 1px rgb(110 80 36 / 0.12), 0 1px 2px rgb(40 24 8 / 0.16), 0 8px 16px -6px rgb(40 24 8 / 0.32); color: var(--ink); transition: background-color 200ms ease-out, color 200ms ease-out, box-shadow 200ms ease-out; }
  .next__go svg { transition: transform 180ms ease-out; }
  .next__line { font-size: 18px; line-height: 1.45; color: var(--ink-2); max-width: 52ch; }
  @media (hover: hover) { .next:hover { background: color-mix(in srgb, var(--paper) 90%, transparent); } .next:hover .next__go { background: var(--ink); color: var(--paper); } .next:hover .next__go svg { transform: rotate(-45deg); } }
  .next:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }

  @media (max-width: 1099.98px) { .cs-two { grid-template-columns: 1fr; } }
  @media (max-width: 759.98px) {
    .cs-h { font-size: 44px; }
