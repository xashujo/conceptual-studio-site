---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { paras, ROMAN, categoryName } from '../../lib/site.js';
import art from '../../assets/art/engraved/wedding.webp';

export async function getStaticPaths() {
  const all = (await getCollection('projects')).sort((a, b) => Number(a.data.archive) - Number(b.data.archive) || a.data.order - b.data.order);
  const testimonials = await getCollection('testimonials');
  return all.map((project, i) => {
    const t = project.data.testimonial ? project.data.testimonial.split('/').pop()!.replace(/\.json$/, '') : null;
    return { params: { slug: project.id }, props: { project, next: all[(i + 1) % all.length], testimonial: testimonials.find((x) => x.id === t) ?? null } };
  });
}
const { project, next, testimonial } = Astro.props;
const p = project.data;
let plate = 0;
const cap = (c?: string) => (c ? { no: `Plate ${ROMAN[plate++] ?? plate}`, text: c } : null);
const sections = [
  { id: 'problem', title: 'The problem', body: p.problem },
  { id: 'approach', title: p.archive ? 'About the work' : 'What I did', body: p.approach },
];
---
<Base title={p.title} description={p.summary} image={p.cover}>
  <article>
    <section class="page-head">
      <div class="engraving"><Image src={art} alt="" widths={[1200, 1800, 2600]} sizes="100vw" loading="eager" /></div>
      <div class="wrap page-head__inner">
        <p class="micro micro--gold">{categoryName[p.category]} · {p.year}</p>
        <h1>{p.title}</h1>
        <p class="lead">{p.summary}</p>
        <dl class="case-facts glass">
          <dt>Client</dt><dd>{p.client}</dd>
          <dt>Year</dt><dd>{p.year}</dd>
          <dt>Work</dt><dd>{p.disciplines.join(', ')}</dd>
          {p.context && <><dt>Context</dt><dd>{p.context}</dd></>}
        </dl>
      </div>
    </section>
    <figure class="wrap case-cover">
      <div class="frame"><Image src={p.cover} alt={p.coverAlt} widths={[800, 1400, 2000, 2600]} sizes="100vw" loading="eager" fetchpriority="high" style={`view-transition-name: cover-${project.id}`} /></div>
    </figure>

    {sections.filter((s) => s.body).map((s) => (
      <section class="wrap case-section" aria-labelledby={s.id}>
        <h2 id={s.id}>{s.title}</h2>
        <div class="prose">{paras(s.body).map((t) => <p>{t}</p>)}</div>
      </section>
    ))}

    {p.blocks.length > 0 && (
      <section class="wrap case-blocks" aria-label="The work">
        {p.blocks.map((b) => {
          if (b.type === 'image') { const c = cap(b.caption); return (
            <figure class={`block block--${b.size}`}>
              <div class="frame"><Image src={b.src} alt={b.alt} widths={[700, 1200, 1800, 2400]} sizes={b.size === 'narrow' ? '(max-width: 900px) 100vw, 900px' : '100vw'} /></div>
              {c && <figcaption class="micro muted">{c.no} — {c.text}</figcaption>}
            </figure>
          ); }
          if (b.type === 'pair') { const l = cap(b.left.caption); const r = cap(b.right.caption); return (
            <div class="block--pair">
              <figure class="block"><div class="frame"><Image src={b.left.src} alt={b.left.alt} widths={[600, 1000, 1500]} sizes="(max-width: 900px) 100vw, 50vw" /></div>{l && <figcaption class="micro muted">{l.no} — {l.text}</figcaption>}</figure>
              <figure class="block"><div class="frame"><Image src={b.right.src} alt={b.right.alt} widths={[600, 1000, 1500]} sizes="(max-width: 900px) 100vw, 50vw" /></div>{r && <figcaption class="micro muted">{r.no} — {r.text}</figcaption>}</figure>
            </div>
          ); }
          if (b.type === 'text') return (
            <div class="block--text">{b.heading && <h3>{b.heading}</h3>}<div class="prose">{paras(b.body).map((t) => <p>{t}</p>)}</div></div>
          );
          if (b.type === 'stat') return (
            <div class="block--stat glass"><p class="stat__value">{b.value}</p><p class="stat__label">{b.label}</p></div>
          );
          if (b.type === 'video') { const c = cap(b.caption); return (
            <figure class="block block--full">
              {b.mp4 && <video controls playsinline preload="none" poster={b.poster?.src} width="1920" height="1092" aria-label={b.alt}><source src={b.mp4} type="video/mp4" /></video>}
              {!b.mp4 && b.youtube && <a class="video-card" href={b.youtube}>{b.poster && <Image src={b.poster} alt={b.alt ?? ''} widths={[1200, 2000]} sizes="100vw" />}<span class="video-card__label button button--glass"><Icon name="play" /> Watch on YouTube</span></a>}
              {c && <figcaption class="micro muted">{c.no} — {c.text}</figcaption>}
            </figure>
          ); }
        })}
      </section>
    )}

    {p.outcome && (
      <section class="wrap case-section" aria-labelledby="outcome">
        <h2 id="outcome">What happened</h2>
        <div class="prose">{paras(p.outcome).map((t) => <p>{t}</p>)}{p.link && <p style="margin-top: 1.5rem"><a class="button button--glass" href={p.link.url} rel="noopener">{p.link.label} <Icon name="arrow" /></a></p>}</div>
      </section>
    )}

    {testimonial && (
      <div class="wrap page-section" style="padding-top: 0">
        <figure class="case-quote glass">
          <span class="quote__mark" aria-hidden="true">“</span>
          <blockquote><p>{testimonial.data.quote}</p></blockquote>
          <figcaption>{testimonial.data.name}, <span>{testimonial.data.role}, {testimonial.data.organisation}</span></figcaption>
        </figure>
      </div>
    )}

    <section class="wrap page-section" aria-label="Next project">
      <a class="next glass" href={`/work/${next.id}/`}>
        <span><span class="micro micro--gold" style="padding: 1rem 1rem 0; display: block">Next project · {categoryName[next.data.category]}</span><span class="next__title" style="display: block">{next.data.title}</span></span>
        <span class="card__frame"><Image src={next.data.cover} alt="" widths={[600, 1000]} sizes="(max-width: 900px) 100vw, 45vw" /></span>
      </a>
    </section>
  </article>
</Base>
