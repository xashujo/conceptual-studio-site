---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { categoryName } from '../../lib/site.js';
const all = (await getCollection('projects')).sort((a, b) => Number(a.data.archive) - Number(b.data.archive) || a.data.order - b.data.order || b.data.year - a.data.year);
const filters = [['all', 'All'], ['brand', 'Brand identity'], ['data', 'Data visualisation'], ['motion', '3D and motion'], ['archive', 'Earlier work']];
const current = all.filter((p) => !p.data.archive);
---
<Base title="Work" description="Brand identity and data visualisation for colleges and public institutions, plus 3D and motion work. Projects by Conceptual Studio, London.">
  <section class="page-head wrap grid">
    <h1>Work</h1>
    <p class="lead">Identities, reports, maps and films, mostly for colleges and public institutions.</p>
    <div class="page-head__side">
      <ul class="filters" data-filters aria-label="Filter projects">
        {filters.map(([key, label]) => <li><button type="button" data-filter={key} aria-pressed={key === 'all' ? 'true' : 'false'}>{label}</button></li>)}
      </ul>
      <p class="small muted" role="status" data-filter-status>{current.length} projects shown</p>
    </div>
  </section>
  <section class="wrap" aria-label="Projects" style="padding-bottom: var(--section)">
    <ul class="index">
      {all.map((p, i) => (
        <li class="index__item" data-category={p.data.category} data-archive={String(p.data.archive)} hidden={p.data.archive}>
          <ProjectCard project={p} eager={i < 2} sizes="(max-width: 900px) 100vw, 55vw" />
          <span class="small muted">{categoryName[p.data.category]} · {p.data.year}</span>
        </li>
      ))}
      <li class="index__empty muted" data-empty hidden>Nothing here yet.</li>
    </ul>
  </section>
</Base>
