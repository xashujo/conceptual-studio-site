---
// /glass/: the glass over the three grounds it has to survive, with live sliders for Josh's glass
// dials. Not in the nav, not indexed. The sliders only preview: the saved values live in Pages CMS,
// Site settings > Glass.
import { glassStyle } from '../lib/site';
import '../styles/tokens.css';
import '../styles/components.css';
import { Image } from 'astro:assets';
import etching from '../assets/art/engraved/jardin-quiet.jpg';
import lemoyne from '../assets/art/engraved/lemoyne-night.jpg';

const dials = [
  ['bend', 'Bend', 'How strongly the edges bend what is behind'],
  ['frost', 'Frost', 'How much paper colour fills the glass'],
  ['blur', 'Blur', 'How soft things look through the glass'],
  ['shine', 'Shine', 'How bright the light catches on the rim'],
  ['reach', 'Reach', 'How far in from the edge the bend travels'],
];
const grounds = [
  { id: 'painting', title: 'Over a painting', note: 'Le Jardin Chinois, as on the home page.' },
  { id: 'paper', title: 'Over paper', note: 'Specimen only: the site never puts glass on flat paper' },
  { id: 'black', title: 'Over black', note: 'A night chapter: the Lemoyne close, then plain warm black' },
];
---
<!doctype html>
<html lang="en-GB" style={glassStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Glass</title>
    <link rel="preload" href="/fonts/inter-4-variable.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <main>
      {grounds.map((g) => (
        <section class:list={['ground', `ground--${g.id}`, g.id === 'black' && 'night']} aria-labelledby={`t-${g.id}`}>
          {g.id === 'painting' && <Image class="ground__art" src={etching} alt="" widths={[800, 1600, 2400]} sizes="100vw" loading="eager" />}
          {g.id === 'black' && <Image class="ground__art ground__art--top" src={lemoyne} alt="" widths={[800, 1600, 2400]} sizes="100vw" loading="eager" />}

          {['lens'].map(() => (
            <div class="bar glass" data-lens>
              <span class="bar__mark">Conceptual Studio</span>
              <ul class="bar__links"><li>Work</li><li>Services</li><li>About</li><li>Contact</li></ul>
              <span class="btn btn--solid bar__cta">Start a project</span>
            </div>
          ))}

          <div class="row">
            <div class="dock glass" data-lens><ul><li>Work</li><li>Services</li><li>About</li><li>Contact</li></ul></div>
          </div>
          <div class="row">
            <span class="round glass" data-lens aria-hidden="true">↗</span>
            <span class="round glass" data-lens aria-hidden="true">↓</span>
            <span class="round glass round--wide" data-lens>Taking new projects</span>
          </div>

          <p class="plate ground__label"><b id={`t-${g.id}`}>{g.title}</b><span>({g.note})</span></p>
        </section>
      ))}
    </main>

    <aside class="dials" aria-labelledby="dials-h">
      <h2 class="dials__h" id="dials-h">Glass dials</h2>
      <p class="dials__p">Drag to try. 100 is as designed. Nothing is saved here: put the numbers you like into Pages CMS, Site settings, Glass.</p>
      {dials.map(([key, label, hint]) => (
        <label class="dial">
          <span class="dial__top"><span>{label}</span><output data-out={key}>100</output></span>
          <input type="range" min="0" max="200" step="5" value="100" data-dial={key} aria-describedby={`hint-${key}`} />
          <span class="dial__hint" id={`hint-${key}`}>{hint}</span>
        </label>
      ))}
      <div class="dials__btns">
        <button class="btn dials__reset" type="button" data-default>Reset to the original look</button>
        <button class="btn dials__reset" type="button" data-reset>Back to the saved values</button>
      </div>
    </aside>

    <script>
      // Live preview of the dials: set the CSS variables on <html> and tell the glass scripts.
      const root = document.documentElement;
      const saved = Object.fromEntries(['bend', 'frost', 'blur', 'shine', 'reach'].map((k) => [k, root.style.getPropertyValue(`--g-${k}`)]));
      const inputs = [...document.querySelectorAll<HTMLInputElement>('[data-dial]')];
      const show = (input: HTMLInputElement) => { document.querySelector(`[data-out="${input.dataset.dial}"]`)!.textContent = input.value; };
      const apply = (input: HTMLInputElement) => {
        root.style.setProperty(`--g-${input.dataset.dial}`, String(Number(input.value) / 100));
        show(input);
        window.dispatchEvent(new Event('glass-dials'));
      };
      inputs.forEach((input) => {
        const v = parseFloat(saved[input.dataset.dial!]);
        input.value = String(Math.round((Number.isFinite(v) ? v : 1) * 100));
        show(input);
        input.addEventListener('input', () => apply(input));
      });
      document.querySelector('[data-default]')!.addEventListener('click', () => {
        inputs.forEach((input) => { input.value = '100'; apply(input); });
      });
      document.querySelector('[data-reset]')!.addEventListener('click', () => {
        inputs.forEach((input) => { const v = parseFloat(saved[input.dataset.dial!]); input.value = String(Math.round((Number.isFinite(v) ? v : 1) * 100)); apply(input); });
      });
    </script>
    <script>
      import { mountLens } from '../scripts/lens.js';
      document.querySelectorAll<HTMLElement>('[data-lens]').forEach((el) => {
        const image = el.closest('.ground')?.querySelector<HTMLImageElement>('.ground__art');
        mountLens(el, image, image?.classList.contains('ground__art--top') ? [0.7, 1] : undefined); // the night art fades out from 70%
      });
    </script>
  </body>
</html>

<style>
  .ground { position: relative; isolation: isolate; overflow: hidden; min-height: 620px; padding: 48px var(--margin); display: grid; align-content: space-between; gap: 40px; background: var(--paper); color: var(--ink); }
  .ground__art { position: absolute; inset: 0; z-index: -1; width: 100%; height: 100%; object-fit: cover; }
  .ground--painting .ground__art { object-position: 50% 30%; }
  .ground__art--top { height: 58%; object-position: 50% 0; mask-image: linear-gradient(#000 70%, transparent); }

  .bar, .dock, .round { position: relative; } /* holds the WebGL canvas */
  /* Shapes from the glass spec: bars 60px at 28px radius, the dock 60px with round ends. Contents are placeholders until step 2. */
  .bar { height: 60px; border-radius: 28px; display: flex; align-items: center; gap: 24px; padding: 0 8px 0 24px; }
  .bar__mark { font-family: var(--display); font-size: 24px; letter-spacing: -0.02em; margin-right: auto; }
  .bar__links { list-style: none; display: flex; gap: 28px; margin: 0; padding: 0; font-size: 18px; font-weight: 500; }
  .bar__cta { min-height: 44px; font-size: 16px; }
  .dock { justify-self: center; height: 60px; border-radius: var(--pill); padding: 0 6px; display: flex; align-items: center; }
  /* Each label is its own 44px target; 12px each side gives 24px between words and 18px at the ends. */
  .dock ul { list-style: none; display: flex; margin: 0; padding: 0; font-size: 16px; font-weight: 500; }
  .dock li { display: grid; place-items: center; min-height: 44px; padding: 0 12px; }
  .ground__label { margin: 0; }
  /* The dials: a plain paper panel (not glass, so it never changes while you tune), pinned bottom right. */
  .dials { position: fixed; z-index: 20; right: 16px; bottom: 16px; width: min(320px, calc(100vw - 32px)); max-height: calc(100svh - 32px); overflow: auto; padding: 20px; border-radius: 24px; background: var(--paper); color: var(--ink); box-shadow: 0 0 0 1px rgb(110 80 36 / 0.2), 4px 14px 36px -12px rgb(40 24 8 / 0.4); display: grid; gap: 14px; }
  .dials__h { font-size: 20px; font-weight: 700; letter-spacing: -0.02em; }
  .dials__p { font-size: 14px; line-height: 1.45; color: var(--ink-2); }
  .dial { display: grid; gap: 6px; }
  .dial__top { display: flex; justify-content: space-between; font-size: 16px; font-weight: 600; }
  .dial__top output { font-variant-numeric: tabular-nums; }
  .dial input { width: 100%; accent-color: var(--ink); }
  .dial__hint { font-size: 13px; color: var(--ink-2); }
  .dials__btns { display: flex; flex-wrap: wrap; gap: 8px; }
  .dials__reset { justify-self: start; min-height: 40px; padding: 0 16px; font-size: 15px; }
  .row { display: flex; flex-wrap: wrap; justify-content: center; gap: 16px; }
  .round { width: 56px; height: 56px; border-radius: 50%; display: grid; place-items: center; font-size: 22px; }
  .round--wide { width: auto; padding: 0 20px; border-radius: var(--pill); font-size: 16px; font-weight: 500; }

  @media (max-width: 760px) {
    .ground { min-height: 520px; padding-block: 24px; }
    .bar { padding-left: 18px; }
    .bar__mark { font-size: 21px; }
    .bar__links { display: none; }
    .dock li { padding: 0 10px; }
  }
</style>
