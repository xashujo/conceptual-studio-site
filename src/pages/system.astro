---
// /system/: the design system at real size. Not in the nav, not indexed.
import '../styles/tokens.css';
import '../styles/components.css';
import { Image } from 'astro:assets';
import FooterEngraving from '../components/FooterEngraving.astro';
import PlateCaption from '../components/PlateCaption.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Control from '../components/system/Control.astro';
import archGold from '../assets/art/painted/lairesse-arch-gold.jpg';
import minervaGold from '../assets/art/painted/lairesse-minerva-gold.jpg';
import minervaNight from '../assets/art/painted/lairesse-minerva-night.jpg';
import flourish from '../assets/brand/gold-flourish.png';
import busShelter from '../assets/work/oxford-school-of-english/bus-shelter.webp';

const email = 'joshuamcdonald099@gmail.com'; // as on the Framer contact page; TBC if a studio address replaces it
const lairesse = {
  title: 'Allegory of the Sciences (detail), Gerard de Lairesse, c. 1675–83',
  medium: 'Oil on canvas, grisaille. Rijksmuseum SK-A-4177, CC0. Duotoned',
};
const states = ['Rest', 'Hover', 'Focus', 'Pressed'] as const;
const rows = [{ label: 'Primary', kind: 'primary' }, { label: 'Pill', kind: 'pill' }, { label: 'Link', kind: 'link' }] as const;
const nightRows = [{ label: 'Primary on night', kind: 'primary' }, { label: 'Pill on night', kind: 'pill' }] as const;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>System</title>
    <link rel="preload" href="/fonts/agatho-medium-subset.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-4-variable.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <main>
      <!-- The page's one big Agatho word, standing on a hairline (TASTE 3), over the credits row (19). -->
      <header class="open">
        <div class="open__art" aria-hidden="true"><Image src={archGold} alt="" widths={[800, 1440]} sizes="100vw" loading="eager" /></div>
        <div class="wrap">
        <h1 class="open__word">System</h1>
        <hr class="rule" />
        <div class="credits">
          <p>Conceptual Studio</p>
          <p>Colour, type, glass and controls, at the size they are used</p>
          <p><a class="link" href="/">Back to home<span class="arrow" aria-hidden="true">→</span></a></p>
        </div>
        </div>
      </header>

      <!-- Colour on real surfaces. -->
      <section class="sec wrap" aria-labelledby="colour">
        <div class="grid">
          <div class="side">
            <h2 class="h2" id="colour">Colour</h2>
            <p class="note">One ground, one ink, one gold. Surfaces are told apart by tone, never by a line.</p>
          </div>
          <div class="swatches">
            <div class="sw sw--paper">
              <div class="sw__field">
                <p class="sw__text">Every page sits on paper. Text on it is black, and anything secondary is black mixed into paper, so even the quiet lines stay warm.</p>
                <div>
                  <p class="sw__text sw__text--2">Secondary text is 62% ink, 5.6:1.</p>
                  <hr class="rule sw__rule" />
                  <p class="sw__text sw__text--2">The hairline is 1px ink. On a page it runs margin to margin, like the one under System.</p>
                </div>
              </div>
              <p class="sw__label"><b>Paper #F1DFC8</b><span>The ground. Black text at 16.1:1</span></p>
            </div>
            <div class="sw sw--paper2">
              <div class="sw__field">
                <span class="avail" tabindex="0"><span class="avail__dot" aria-hidden="true"></span><span class="swap"><span>Available to book a call</span><span aria-hidden="true">↗ Email me</span></span></span>
                <button class="btn" type="button" data-copy={email}><span data-copy-label>Copy email</span></button>
              </div>
              <p class="sw__label"><b>Paper 2 #E8D3B8</b><span>Cards, pills and fields. 14.4:1</span></p>
            </div>
            <div class="sw sw--night">
              <div class="sw__field night">
                <p class="sw__gold" aria-hidden="true">Gold</p>
                <p class="sw__text">Night chapters are warm black, lit in amber. Gold is the same in both.</p>
              </div>
              <p class="sw__label"><b>Night #14110D · Gold #926E34</b><span>Paper text at 14.5:1. Gold for graphics and large type only, 4.0:1</span></p>
            </div>
          </div>
        </div>
      </section>

      <!-- Agatho at display size against small Inter, then Inter at reading size. -->
      <section class="sec wrap" aria-labelledby="type">
        <div class="grid">
          <div class="side">
            <h2 class="h2" id="type">Type</h2>
            <p class="note">Two sizes do the work: Agatho at word scale and Inter at 18 to 24px. Card titles at 40px are the only size between.</p>
          </div>
          <div class="display">
            <p class="display__big">Brand identity</p>
            <p class="display__small">Agatho Medium, 160px, tracking −2%. Display only: one weight, no italic, never in body text.</p>
          </div>
        </div>
        <div class="grid body-spec">
          <div class="side">
            <p class="note">Inter 4 at 18px on 28px, black on paper. A line runs 60 to 70 characters.</p>
          </div>
          <div class="body-spec__text">
            <p>I design brand identities and data visualisation. Most of my clients are colleges and public bodies, so a lot of what I make has to be understood quickly by people who are busy: reports, infographics, signs on a wall. I also work with companies abroad, like Fou Answer in Tokyo, and with artists on 3D and motion.</p>
          </div>
          <div class="body-spec__list">
            <p>For Oxford School of English, the identity covered:</p>
            <ul>
              <li>A lion crest inside a shield</li>
              <li>A palette of Oxford Gold and Oxford White</li>
              <li>Type that mixes classic and modern forms</li>
              <li>Signage, student ID cards and posters</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- A threshold: one painted detail, duotoned gold on paper and faded into the page. Light plate glass in its quiet part. -->
      <section class="art" aria-labelledby="painting">
        <h2 class="h2 wrap art__h" id="painting">Painting and glass</h2>
        <figure class="art__fig">
          <div class="art__frame" id="art-gold">
            <Image class="art__img" src={minervaGold} alt="Detail of a grisaille painting: the head of Minerva in a plumed helmet against a cracked marble niche, toned in gold on cream" widths={[800, 1100]} sizes="100vw" />
            <div class="plate-glass art__plate" data-liquid="art-gold" data-tone="light">
              <h3 class="plate__h">Tell me about your project</h3>
              <p>A short call is the quickest way to find out if I'm the right fit.</p>
              <div class="plate__row">
                <a class="avail" href={`mailto:${email}`}><span class="avail__dot" aria-hidden="true"></span><span class="swap"><span>Available to book a call</span><span aria-hidden="true">↗ Email me</span></span></a>
              </div>
            </div>
          </div>
          <div class="wrap"><PlateCaption {...lairesse} /></div>
        </figure>
      </section>

      <!-- Night chapter: warm black, the work lit from the top left. -->
      <div class="night nightch">
        <section class="sec wrap" aria-labelledby="night">
          <div class="grid">
            <div class="side">
              <h2 class="h2" id="night">Night</h2>
              <p class="note">Agatho in paper on warm black. Paper and ink swap; gold does not.</p>
            </div>
            <div class="display">
              <p class="display__big">Data visualisation</p>
              <p class="display__small">The same 160px, set in paper. Small Inter beside it at 16px, so the scale reads.</p>
            </div>
          </div>
        </section>

        <figure class="obj wrap" aria-labelledby="flourish">
          <h2 class="h2 obj__h" id="flourish">The gold flourish</h2>
          <div class="obj__piece">
            <Image class="obj__img" src={flourish} alt="The Conceptual Studio gold flourish: a whiplash line of liquid gold with a drop at each end" widths={[700, 1346]} sizes="(min-width: 760px) 72vw, 100vw" />
            <PlateCaption title="The gold flourish, Conceptual Studio" medium="Brand mark, rendered as liquid gold. Lit from the top left" />
          </div>
        </figure>

        <section class="art art--night" aria-labelledby="glass-night">
          <h2 class="h2 wrap art__h" id="glass-night">Glass over black</h2>
          <figure class="art__fig">
            <div class="art__frame" id="art-night">
              <Image class="art__img" src={minervaNight} alt="The same detail of Minerva, toned in cream and gold on warm black" widths={[800, 1100]} sizes="100vw" />
              <div class="plate-glass art__plate" data-liquid="art-night" data-tone="dark">
                <h3 class="plate__h">Start a project</h3>
                <p>Send me the brief, or just the problem. I'll come back with questions.</p>
                <div class="plate__row">
                  <a class="btn btn--solid" href="/contact/"><span class="swap"><span>Book a call</span><span aria-hidden="true">Contact me ↗</span></span></a>
                </div>
              </div>
              <!-- Tier B, chrome glass: the dock, as it passes over a picture. -->
              <nav class="dock glass" aria-label="Dock specimen" data-refract>
                <a href="/" aria-label="Home"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10.5 12 4l8 6.5V20h-5v-6H9v6H4z"/></svg></a>
                <a href="/about/" aria-label="About"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="9" r="3.5"/><path d="M5 20c1.2-3.5 4-5 7-5s5.8 1.5 7 5"/></svg></a>
                <a href="/work/" aria-label="Work"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 6.5h6l2 2h9v10h-17z"/></svg></a>
                <a href="/contact/" aria-label="Contact"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 6.5h17v11h-17z"/><path d="m3.5 7 8.5 6.5L20.5 7"/></svg></a>
                <a href="#menu" aria-label="Menu"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14M5 12h14M5 16h14"/></svg></a>
              </nav>
            </div>
            <div class="wrap"><PlateCaption {...lairesse} medium="Oil on canvas, grisaille. Rijksmuseum SK-A-4177, CC0. Duotoned for night" /></div>
          </figure>
        </section>
      </div>

      <!-- One exhibit in the Framer card. -->
      <section class="sec wrap" aria-labelledby="card">
        <h2 class="h2 sec__h" id="card">Project card</h2>
        <ProjectCard
          title="Oxford School of English"
          year={2023}
          href="/work/oxford-school-of-english/"
          disciplines={['Visual identity', 'Branding']}
          summary="A new identity for a private English school in Oxford, now a UK-registered trademark."
          image={busShelter}
          alt="Oxford School of English poster in a bus shelter on an Oxford street, beside a red double-decker bus"
          caption={{ title: 'Oxford School of English, 2023', medium: 'Visual identity, on a bus shelter poster' }}
          position="50% 46%"
        />
      </section>

      <!-- Controls in every state. Only the Rest column is live. -->
      <section class="sec wrap" aria-labelledby="controls">
        <div class="grid">
          <div class="side">
            <h2 class="h2" id="controls">Buttons and links</h2>
            <p class="note">The offer at rest, the action on hover. Arrows turn from → to ↗ in 180ms. Pressing sinks the fill and the size by 3%.</p>
          </div>
          <div class="states">
            <div class="states__head" aria-hidden="true">{states.map((s) => <p>{s}</p>)}</div>
            {rows.map((r) => (
              <div class="states__row">
                <p class="states__label">{r.label}</p>
                {states.map((st) => <Control kind={r.kind} state={st} />)}
              </div>
            ))}
            <div class="night states__night">
              {nightRows.map((r) => (
                <div class="states__row">
                  <p class="states__label">{r.label}</p>
                  {states.map((st) => <Control kind={r.kind} state={st} />)}
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
      <p class="sr" aria-live="polite" data-copy-status></p>
    </main>
    <footer><FooterEngraving /></footer>

    <script>
      import { mountLiquidGlass } from '../scripts/liquid-glass.js';
      import { mountRefraction } from '../scripts/refraction.js';

      // Tier A: plate glass samples the painting behind it.
      document.querySelectorAll<HTMLElement>('[data-liquid]').forEach((panel) => {
        const image = document.getElementById(panel.dataset.liquid!)?.querySelector('img');
        const opacity = panel.dataset.opacity ? Number(panel.dataset.opacity) : undefined;
        mountLiquidGlass(panel, { image, tone: panel.dataset.tone, opacity });
      });
      // Tier B: CSS glass, with edge refraction in Chromium.
      document.querySelectorAll<HTMLElement>('[data-refract]').forEach((el) => mountRefraction(el));

      // Copy email: label swaps, reverts after 1.55s, announced politely.
      const status = document.querySelector<HTMLElement>('[data-copy-status]');
      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
        const label = btn.querySelector<HTMLElement>('[data-copy-label]')!;
        let timer = 0;
        btn.addEventListener('click', async () => {
          try { await navigator.clipboard.writeText(btn.dataset.copy!); } catch { return; }
          label.textContent = 'Email copied';
          if (status) status.textContent = 'Email address copied';
          clearTimeout(timer);
          timer = window.setTimeout(() => { label.textContent = 'Copy email'; if (status) status.textContent = ''; }, 1550);
        });
      });
    </script>

    <style>
      .grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 24px; }
      .side { grid-column: 1 / span 3; padding-right: 24px; }
      .note { margin-top: 12px; font-size: 16px; line-height: 1.5; color: var(--ink-2); max-width: 30ch; }
      .sec { padding-block: 160px 0; }
      .sec__h { margin-bottom: 32px; }
      .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

      /* Opening: cap height at least 20× the body's (TASTE 3). */
      .open { position: relative; isolation: isolate; padding-block: 136px 120px; }
      .open + .sec { padding-top: 40px; }
      /* The threshold (TASTE 1, 2): a quiet passage of the painting, the word set straight onto it, no scrim. */
      .open__art { position: absolute; z-index: -1; inset: 0; }
      .open__art img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 100%; -webkit-mask-image: linear-gradient(to bottom, transparent, #000 14%, #000 66%, transparent); mask-image: linear-gradient(to bottom, transparent, #000 14%, #000 66%, transparent); }
      .open__word { font-family: var(--display); font-weight: 500; font-size: clamp(104px, 27.5vw, 420px); line-height: 0.8; letter-spacing: -0.035em; margin-left: -0.04em; padding-bottom: 0.17em; }
      .credits { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; padding-top: 14px; font-size: 24px; line-height: 1.3; letter-spacing: -0.01em; }
      .credits p:nth-child(2) { color: var(--ink-2); }
      .credits p:last-child { justify-self: end; }
      .credits .link { min-height: 0; }

      /* Colour: three real surfaces, gutterless (LOEWE grid). */
      .swatches { grid-column: 4 / -1; display: grid; grid-template-columns: 4fr 3fr 5fr; }
      .sw { display: flex; flex-direction: column; }
      .sw__field { flex: 1; min-height: 340px; padding: 28px; display: flex; flex-direction: column; justify-content: space-between; gap: 24px; }
      .sw--paper .sw__field { padding-left: 0; }
      .sw--paper2 .sw__field { background: var(--paper-2); justify-content: flex-end; align-items: flex-start; }
      .sw--paper2 .btn { --fill: var(--paper); --fill-hover: color-mix(in srgb, var(--ink) 6%, var(--paper)); }
      .sw--paper2 .avail { --fill: var(--paper); }
      .sw__text { font-size: 18px; line-height: 28px; max-width: 34ch; }
      .sw__text--2 { color: var(--ink-2); }
      .sw__rule { margin: 12px 0; }
      .sw__gold { font-family: var(--display); font-size: clamp(88px, 11vw, 168px); line-height: 0.8; letter-spacing: -0.03em; color: var(--gold); margin-top: -0.06em; }
      .sw__label { padding: 14px 0 0; font-size: 16px; line-height: 1.45; }
      .sw--paper2 .sw__label, .sw--night .sw__label { padding-left: 28px; }
      .sw__label b { display: block; font-weight: 600; font-variant-numeric: tabular-nums; }
      .sw__label span { display: block; color: var(--ink-2); }

      /* Display type next to small Inter. */
      .display { grid-column: 4 / -1; display: grid; grid-template-columns: minmax(0, 1fr) 210px; align-items: end; gap: 24px; }
      .display__big { font-family: var(--display); font-size: clamp(44px, 11.2vw, 160px); line-height: 0.92; letter-spacing: -0.02em; }
      .display__small { font-size: 16px; line-height: 1.45; color: var(--ink-2); padding-bottom: 0.4em; }
      .body-spec { margin-top: 96px; }
      .body-spec__text { grid-column: 4 / span 5; font-size: 18px; line-height: 28px; }
      .body-spec__list { grid-column: 10 / span 3; font-size: 18px; line-height: 28px; }
      .body-spec__list ul { margin-top: 8px; padding-left: 1.1em; }
      .body-spec__list li + li { margin-top: 4px; }

      /* Painting: full bleed, faded top and bottom into the page like the footer engraving. */
      .art { padding-top: 160px; }
      .art__h { margin-bottom: 8px; }
      .art__fig { position: relative; }
      .art__frame { position: relative; height: min(56vw, 820px); min-height: 520px; }
      .art__img { width: 100%; height: 100%; object-fit: cover; object-position: 30% 30%; -webkit-mask-image: linear-gradient(to bottom, transparent, #000 22%, #000 80%, transparent); mask-image: linear-gradient(to bottom, transparent, #000 22%, #000 80%, transparent); }
      .art__plate { position: absolute; right: calc(var(--margin) + 4vw); top: 50%; transform: translateY(-50%); width: min(400px, 36vw); padding: 28px; display: grid; gap: 14px; font-size: 18px; line-height: 1.5; }
      .plate__h { font-size: 24px; line-height: 1.25; font-weight: 600; letter-spacing: -0.01em; }
      .plate__row { margin-top: 8px; display: flex; flex-wrap: wrap; gap: 10px; }
      .art__plate .avail { --fill: color-mix(in srgb, var(--paper) 55%, transparent); }

      /* Night chapter. */
      .nightch { margin-top: 160px; padding-bottom: 160px; }
      .nightch > .sec { padding-top: 160px; }
      .obj { padding-top: 200px; display: grid; justify-items: center; }
      .obj__h { justify-self: start; margin-bottom: 72px; }
      .obj__piece { width: min(72vw, 1040px); }
      .obj__img { width: 100%; filter: drop-shadow(28px 40px 36px rgb(0 0 0 / 0.55)); }
      .obj__piece :global(.plate) { margin-top: 56px; }
      .art--night { padding-top: 200px; }
      .art--night .art__img { object-position: 30% 30%; }
      .dock { position: absolute; right: calc(var(--margin) + 4vw); bottom: 10%; display: flex; gap: 6px; height: 60px; padding: 6px 12px; border-radius: var(--pill); align-items: center; }
      .dock a { display: grid; place-items: center; width: 52px; height: 48px; border-radius: var(--pill); color: color-mix(in srgb, var(--ink) 55%, transparent); transition: color 120ms ease-out; }
      .dock a:hover { color: var(--ink); }
      .dock svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linejoin: round; stroke-linecap: round; }

      /* States table. */
      .states { grid-column: 4 / -1; }
      .states__head, .states__row { display: grid; grid-template-columns: 120px repeat(4, minmax(0, 1fr)); align-items: center; gap: 16px; }
      .states__head { padding-left: 160px; padding-right: 24px; grid-template-columns: repeat(4, minmax(0, 1fr)); font-size: 16px; color: var(--ink-2); padding-bottom: 12px; }
      .states__row { min-height: 96px; padding-inline: 24px; }
      .states__label { font-size: 16px; color: var(--ink-2); }
      .states__night { margin-top: 24px; padding-block: 16px; }
      .states :is(.btn, .link) { justify-self: start; }

      footer { margin-top: 160px; }

      @media (max-width: 1099.98px) {
        .side { grid-column: 1 / -1; padding: 0 0 32px; }
        .swatches, .display, .states { grid-column: 1 / -1; }
        .swatches { grid-template-columns: 1fr 1fr; }
        .sw--paper { grid-column: 1 / -1; margin-bottom: 48px; }
        .sw--paper .sw__field { min-height: 0; flex-direction: row; align-items: flex-end; padding-bottom: 8px; }
        .body-spec__text { grid-column: 1 / span 7; }
        .body-spec__list { grid-column: 9 / -1; }
        /* Below 1100 the four states sit two by two, each with its state named on the specimen row's label. */
        .states__head { display: none; }
        .states__row { grid-template-columns: repeat(2, minmax(0, 1fr)); padding-block: 20px; gap: 20px 16px; }
        .states__label { grid-column: 1 / -1; }
      }
      @media (max-width: 759.98px) {
        .sec { padding-top: 112px; }
        .credits { grid-template-columns: 1fr; gap: 6px; font-size: 20px; }
        .open { padding-block: 96px 96px; }
        .open__art img { object-position: 32% 100%; }
        .credits p:last-child { justify-self: start; }
        .swatches { grid-template-columns: 1fr; }
        .sw__field { min-height: 240px; }
        .sw--paper .sw__field { min-height: 0; padding-bottom: 8px; flex-direction: column; align-items: stretch; }
        .sw--paper2 .sw__label, .sw--night .sw__label { padding-left: 0; padding-bottom: 24px; }
        .display { grid-template-columns: 1fr; }
        .body-spec { margin-top: 56px; row-gap: 32px; }
        .body-spec__text, .body-spec__list { grid-column: 1 / -1; font-size: 18px; }
        .art { padding-top: 112px; }
        .art__frame { height: 560px; min-height: 0; }
        .art__img { object-position: 58% 30%; }
        .art__plate { left: var(--margin); right: var(--margin); width: auto; top: auto; bottom: 12%; transform: none; padding: 22px; }
        .obj { padding-top: 112px; }
                .obj__piece { width: 100%; }
        .dock { right: auto; left: var(--margin); bottom: auto; top: 13%; }
        .art--night .art__img { object-position: 62% 30%; }
        .states__row { grid-template-columns: repeat(2, minmax(0, 1fr)); padding-inline: 16px; }
        .nightch { margin-top: 112px; padding-bottom: 112px; }
        .nightch > .sec { padding-top: 112px; }
      }
    </style>
  </body>
</html>
