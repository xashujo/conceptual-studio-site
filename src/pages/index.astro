---
import '../styles/tokens.css';
import FooterEngraving from '../components/FooterEngraving.astro';
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Conceptual Studio</title>
    <link rel="preload" href="/fonts/agatho-medium-subset.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body style="margin:0">
    <main style="min-height:80vh;display:grid;place-items:center">
      <h1 style="font-family:var(--display);font-weight:500">Conceptual Studio</h1>
    </main>
    <footer><FooterEngraving /></footer>
  </body>
</html>
