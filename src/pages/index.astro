---
// Home (brief 6.1), built on the chosen direction: Prototype A, the quiet etching (DECISIONS, 26 Oct).
// Pass 1 of 2 (Josh, 28 Oct): sticky nav, stats, filtered compact work grid, services accordion,
// all in the shared glass, over the etching carried down behind them.
import Tune from '../components/Tune.astro';
import Logo from '../components/Logo.astro';
import Favicons from '../components/Favicons.astro';
import { glassStyle } from '../lib/site';
import '../styles/tokens.css';
import '../styles/components.css';
import { Image, getImage } from 'astro:assets';
import { email, startHref, quoteHref, sentence, trustedBy } from '../data/site';
import { availability, homeQuotes, responseTime, home } from '../lib/site';
import { featured, projectHref, homeFilters, bySlug } from '../data/work';
import { services, isLane } from '../data/services';
import { servicesPage } from '../lib/pages';
import closeArt from '../assets/art/engraved/lemoyne-night.jpg';
// Behind the sections: plain canvas, or the running painting (CMS "Background", Josh 2 Nov).
const painting = home.backdrop === 'painting';
const canvas = `url(${(await getImage({ src: home.canvasImage, format: 'webp' })).src})`;

const headline = home.headline; // Pages CMS: Home page (option 3, Josh, 26 Oct)
const links = [['Work', '#work'], ['Services', '#services'], ['About', '#about'], ['Start a Project', '#contact']];

// Title Case for headings, buttons and labels (Josh, 28 Oct): every word capitalised except the small
// ones, never the first or last; "and" becomes "&". Capitals already there (KUT) are kept.
const small = new Set(['a', 'an', 'the', 'of', 'to', 'in', 'on', 'for', 'at', 'by', 'or', 'but', 'with', 'as']);
const titleCase = (s: string) => s.replace(/\band\b/gi, '&').split(' ')
  .map((w, i, all) => (i > 0 && i < all.length - 1 && small.has(w.toLowerCase()) ? w.toLowerCase() : w.charAt(0).toUpperCase() + w.slice(1)))
  .join(' ');

// Pages CMS: Home page > Stats. Placeholder figures from Josh's brief (28 Oct), not yet confirmed: replace before launch.
const stats = home.stats.map((s) => ({ n: s.number, after: s.after, label: s.label }));

// Featured work and the services come from Pages CMS (Projects and Services).
// The first six by home page position show (two rows of three); any more wait behind "Show More".
const SHOWN = 6;
const cards = featured.map((p) => ({
  title: p.title, year: p.year, href: projectHref(p), image: p.thumb ?? p.image, alt: p.alt,
  position: p.thumb ? undefined : p.homePosition ?? p.position, filter: p.homeFilter, student: p.student, label: p.label, outcome: p.outcome, brief: p.summary,
}));
// Social media videos (Pages CMS: Home page > Social media videos), after the projects under Social Media.
const videos = await Promise.all(home.socialVideos.map(async (v) => ({ ...v, poster: (await getImage({ src: v.poster, width: 720, format: 'webp' })).src })));
// Why clients choose us (pass 2): the two case studies' own summaries from the CMS, beside the quote.
const results = home.results.map(bySlug) // Pages CMS: Home page > Why Clients Choose Us
  .map((p) => ({ client: p.client, title: p.title, line: p.summary, href: projectHref(p) }));
// The lanes are the services with a page of their own; the rest (monthly plans, video) sit in a short row under them.
const lanes = services.filter(isLane);
const more = services.filter((s) => !lanes.includes(s));
---
<!doctype html>
<html lang="en-GB" style={glassStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Conceptual Studio: brand identity and data visualisation, London</title>
    <meta name="description" content={sentence} />
    <Favicons />
    <link rel="preload" href="/fonts/agatho-medium-subset.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-4-variable.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <!-- Sticky glass nav. It turns light over the night chapters (script below). -->
    <nav class="nav glass glass--nav" aria-label="Main" data-nav>
      <Logo />
      <ul class="nav__links">
        <li><a class="glass-pill" href="#top" aria-current="true">Home</a></li>
        {links.map(([l, h]) => <li><a class="glass-pill" href={h}>{l}</a></li>)}
      </ul>
      <button class="nav__menu glass-pill" type="button" popovertarget="site-menu">Menu</button>
    </nav>
    <!-- Phone menu: a glass sheet under the nav (Josh, 28 Oct). A native popover, so Escape and tapping outside close it. -->
    <div class="menu glass" id="site-menu" popover>
      <ul>
        <li><a class="glass-pill" href="#top">Home</a></li>
        {links.map(([l, h]) => <li><a class="glass-pill" href={h}>{l}</a></li>)}
      </ul>
    </div>
    <main>
      <!-- Opening: the etching fills the screen; the hero plate is glass over it. -->
      <header class="hero" id="top">
        {painting ? <Image class="hero__art" src={home.pageImage} alt="" widths={[1100, 1600]} quality={55} sizes="100vw" loading="eager" fetchpriority="high" /> : <div class="hero__art canvas" style={`--canvas: ${canvas}`} aria-hidden="true" />}
        <!-- Landing view (Josh, 2 Nov): one plate that says what clients get, with the big Start a Project. The stats moved to the proof (Josh, 3 Nov). -->
        <div class="hero__bento">
        <div class="hero__plate glass" data-lens>
          <h1 class="hero__h">{headline}</h1>
          <p class="hero__p">{sentence}</p>
          <div class="acts">
            <a class="btn btn--solid hero__start" href={startHref}><span class="swap"><span>{home.startButton}</span><span aria-hidden="true">Contact Us ↗</span></span></a>
            {availability.on && <a class="avail" href={`mailto:${email}`}><span class="avail__dot" aria-hidden="true"></span><span class="swap"><span>{titleCase(availability.text)}</span><span aria-hidden="true">↗ Email Us</span></span></a>}
            <a class="btn hero__work" href="#work">{home.workButton} <span class="hero__down" aria-hidden="true">→</span></a>
          </div>
          <!-- Tags (Design Laboratory, Josh 2 Nov): what the studio does at a glance; each opens the work filtered to it. -->
          <ul class="tags">{homeFilters.map((f) => <li><a class="btn tag-btn" href="#work" data-tag={f}>{f}</a></li>)}</ul>
        </div>
        </div>
      </header>

      <!-- Art behind the glass, so every pane has something to bend (Josh, 28 Oct). Two bands that scroll with
           the page, each its own etching (pass 2, Josh: the held image made the page feel like it wasn't moving). -->
      <div class="field">
        <!-- The site's two duotones, so any background uploaded in the CMS comes out toned like the rest:
             gold on the light bands, the close's warm dark on the night ones. Same colours as the toning script. -->
        <svg class="tones" aria-hidden="true">
          <filter id="tone-day" color-interpolation-filters="sRGB">
            <feColorMatrix type="matrix" values=".2126 .7152 .0722 0 0  .2126 .7152 .0722 0 0  .2126 .7152 .0722 0 0  0 0 0 1 0" />
            <feComponentTransfer><feFuncR type="table" tableValues=".361 .808 .969" /><feFuncG type="table" tableValues=".267 .690 .886" /><feFuncB type="table" tableValues=".133 .522 .776" /></feComponentTransfer>
          </filter>
          <filter id="tone-night" color-interpolation-filters="sRGB">
            <feColorMatrix type="matrix" values=".2126 .7152 .0722 0 0  .2126 .7152 .0722 0 0  .2126 .7152 .0722 0 0  0 0 0 1 0" />
            <feComponentTransfer><feFuncR type="table" tableValues=".161 .404 .553" /><feFuncG type="table" tableValues=".133 .329 .451" /><feFuncB type="table" tableValues=".094 .227 .310" /></feComponentTransfer>
          </filter>
        </svg>
        <!-- The sections alternate night and day (Josh, 28 Oct): Work night, Services day, Why Clients night,
             About day, then the close at night to the end. Each night band has its own night engraving. -->
        <div class="band night">
        <div class:list={["band__art", { canvas: !painting }]} style={painting ? undefined : `--canvas: ${canvas}`} aria-hidden="true">{painting && <Image src={home.pageImage} alt="" widths={[1100, 1600]} quality={55} sizes="100vw" />}</div>

        <section class="fw wrap" id="work" aria-labelledby="fw-h">
          <h2 class="fw__h big" id="fw-h">{home.workHeading}</h2>
          <div class="fw__tools">
          <div class="filterbar glass" role="group" aria-label={`Filter ${home.workHeading.toLowerCase()}`} data-lens data-filters hidden>
            <button class="glass-pill" type="button" data-filter="all" aria-pressed="true">All</button>
            {homeFilters.map((f) => <button class="glass-pill" type="button" data-filter={f} aria-pressed="false">{f}</button>)}
          </div>
            <!-- Grid or list view (Josh, 2 Nov): the icon shows the view you'd switch to. -->
            <button class="fw__view glass" data-lens type="button" aria-label="List view" title="List view" data-view>
              <svg class="fw__list" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 4h14M2 9h14M2 14h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
              <svg class="fw__tiles" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 2h5.5v5.5H2zM10.5 2H16v5.5h-5.5zM2 10.5h5.5V16H2zM10.5 10.5H16V16h-5.5z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
            </button>
          </div>
          <ul class="fw__grid" data-grid>
            {cards.map((c, i) => (
              <li data-filter={c.filter ?? ''} data-more={i >= SHOWN ? '' : undefined}>
                <a class="card glass" href={c.href} data-lens>
                  <Image class="card__img" src={c.image} alt={c.alt} widths={[400, 700, 1100]} sizes="(min-width: 1100px) 380px, (min-width: 760px) 47vw, calc(100vw - 32px)" style={c.position ? `object-position: ${c.position}` : undefined} />
                  <span class="card__head"><span class="card__t" title={c.title}>{c.title}</span><span class="card__y">{c.year}</span></span>
                  <span class="card__row">
                    <span class="card__tags">
                      {c.filter && <span class="tag">{c.filter}</span>}
                      {c.label && <span class="tag">{c.label}</span>}
                    </span>
                  </span>
                  <span class="card__out">{c.outcome}</span>
                </a>
              </li>
            ))}
            {videos.map((v) => (
              <li class="fw__vid" data-filter="Social Media" data-more="">
                <div class="card glass" data-lens>
                  <div class="vid">
                    <video class="card__img vid__v" src={v.video} poster={v.poster} preload="none" playsinline aria-label={v.alt}></video>
                    <button class="vid__play" type="button" aria-label={`Play ${v.title}`} data-play><span class="vid__icon glass-button" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24"><path d="M7 4.5v15l12-7.5z" fill="currentColor"/></svg></span></button>
                  </div>
                  <span class="card__row">
                    <span class="card__t">{v.title}</span>
                    <span class="card__y">{v.year}</span>
                  </span>
                </div>
              </li>
            ))}
          </ul>
          <!-- List view: the same projects as Services-style rows; each opens to its brief, image and link. -->
          <div class="acc glass fw__list-view" data-lens data-acc data-list hidden>
            {cards.map((c, i) => (
              <div class="acc__row" data-filter={c.filter ?? ''} data-more={i >= SHOWN ? '' : undefined}>
                <h3 class="acc__h">
                  <button class="acc__btn" type="button" id={`fwl-${i}-btn`} aria-controls={`fwl-${i}`} aria-expanded="true">
                    <span class="fwl__t">{c.title}</span>
                    <span class="fwl__tags">{c.filter && <span class="tag">{c.filter}</span>}{c.label && <span class="tag">{c.label}</span>}</span>
                    <span class="acc__from">{c.year}</span><span class="acc__icon" aria-hidden="true"></span>
                  </button>
                </h3>
                <div class="acc__panel" id={`fwl-${i}`} role="region" aria-labelledby={`fwl-${i}-btn`}>
                  <div class="acc__inner">
                    <div class="acc__body fwl__body">
                      <Image class="fwl__img" src={c.image} alt={c.alt} widths={[400, 700]} sizes="(min-width: 760px) 360px, calc(100vw - 76px)" style={c.position ? `object-position: ${c.position}` : undefined} />
                      <p class="acc__text">{c.brief}</p>
                      <a class="btn glass-button acc__go" href={c.href}>View Project <span class="arrow" aria-hidden="true">→</span></a>
                    </div>
                  </div>
                </div>
              </div>
            ))}
            {videos.map((v, i) => (
              <div class="acc__row" data-filter="Social Media" data-more="">
                <h3 class="acc__h">
                  <button class="acc__btn" type="button" id={`fwv-${i}-btn`} aria-controls={`fwv-${i}`} aria-expanded="true">
                    <span class="fwl__t">{v.title}</span>
                    <span class="fwl__tags"><span class="tag">Social Media</span></span>
                    <span class="acc__from">{v.year}</span><span class="acc__icon" aria-hidden="true"></span>
                  </button>
                </h3>
                <div class="acc__panel" id={`fwv-${i}`} role="region" aria-labelledby={`fwv-${i}-btn`}>
                  <div class="acc__inner">
                    <div class="acc__body fwl__body">
                      <video class="fwl__img fwl__vid" src={v.video} poster={v.poster} preload="none" playsinline controls aria-label={v.alt}></video>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
          <p class="fw__empty" data-empty hidden>No projects under this filter yet.</p>
          <div class="fw__foot">
            <button class="btn glass-button" type="button" data-show-more hidden>Show More</button>
            <a class="btn glass-button" href="/work/">{home.allProjects} <span class="arrow" aria-hidden="true">→</span></a>
          </div>
        </section>
        </div>

        <div class="band">
        <div class:list={["band__art", { canvas: !painting }]} style={painting ? undefined : `--canvas: ${canvas}`} aria-hidden="true">{painting && <Image src={home.pageImage} alt="" widths={[1100, 1600]} quality={55} sizes="100vw" />}</div>
        <section class="services wrap" id="services" aria-labelledby="services-h">
          <h2 class="big services__h" id="services-h">Services</h2>
          <p class="services__intro">Every project is priced on its scope, so these are starting points. You'll get a fixed quote after our first call.</p>
          {servicesPage.quoteNote && <p class="services__intro services__note">{servicesPage.quoteNote}</p>}
          <!-- The two lanes in large type; hovering or focusing one shows its first example beside the list (WECOMEET,
               Josh 2 Nov). Without hover the example sits under each lane. Examples: Pages CMS > Services and prices. -->
          <div class="svc">
            <ul class="svc__list">
              {lanes.map((s) => (
                <li class="svc__row">
                  <a class="svc__link" href={s.href ?? '/services/'}>
                    <span class="svc__name">{titleCase(s.name)}</span>
                    <span class="svc__line">{s.line}</span>
                    <span class="svc__price">{s.home.price}{s.home.time && <span>, {s.home.time}</span>}</span>
                  </a>
                  {s.examples[0] && <Image class="svc__ex" src={s.examples[0].img} alt={s.examples[0].alt} widths={[600, 1100]} sizes="(min-width: 960px) 520px, calc(100vw - 32px)" style={`object-position: ${s.examples[0].pos ?? '50% 50%'}`} />}
                </li>
              ))}
            </ul>
          </div>
          <ul class="svc__more">
            {more.map((s) => <li><a href={s.href ?? '/services/'}><b>{titleCase(s.name)}</b> <span>{s.home.price}{s.home.time && `, ${s.home.time}`}</span> <span class="arrow" aria-hidden="true">→</span></a></li>)}
          </ul>
          <div class="quote glass" data-lens>
            <h3 class="quote__h">Need Something Else?</h3>
            <p class="quote__p">A mix of these, or something we haven't listed? Tell us what you need and we'll send a fixed quote {responseTime}.</p>
            <a class="btn glass-button" href={quoteHref}>Ask for a Custom Quote <span class="arrow" aria-hidden="true">→</span></a>
          </div>
        </section>

        </div>

        <div class="band night">
        <div class:list={["band__art", { canvas: !painting }]} style={painting ? undefined : `--canvas: ${canvas}`} aria-hidden="true">{painting && <Image src={home.pageImage} alt="" widths={[1100, 1600]} quality={55} sizes="100vw" />}</div>
        <!-- Why clients choose us (pass 2): one client's words in the large pane, two results stacked beside it.
             Inside the field so the glass has the etching behind it. -->
        <section class="proof wrap" aria-labelledby="proof-h">
          <h2 class="big proof__h" id="proof-h">Why Clients Choose Us</h2>
          <!-- Credibility, then what sets us apart, then the proof (Josh, 2 Nov). The clients stay small and quiet:
               a logo if one is uploaded in Clients, toned to one cream, otherwise the name. -->
          {trustedBy.length > 0 && (
            <div class="trusted">
              <p class="trusted__l">{home.trustedByLabel}</p>
              <ul class="trusted__list">
                {trustedBy.map((c) => <li>{c.logo ? <img src={c.logo.src} alt={c.name} width={Math.round(c.logoHeight * c.logo.width / c.logo.height)} height={c.logoHeight} style={`--h: ${c.logoHeight}px`} loading="lazy" /> : c.name}{c.logo && c.label && <span aria-hidden="true">{c.label}</span>}</li>)}
              </ul>
            </div>
          )}
          <section class="stats" aria-label="The studio in numbers">
            <ul class="stats__list">
              {stats.map((s, i) => (
                <li class="stat glass" data-lens style={`--i: ${i}`}>
                  <p class="stat__n"><span aria-hidden="true"><span data-count={s.n} data-i={i}>{s.n.toLocaleString('en-GB')}</span><span class={s.after === '+' ? 'stat__plus' : undefined}>{s.after}</span></span><span class="sr-only">{s.n.toLocaleString('en-GB')}{s.after}</span></p>
                  <p class="stat__l">{s.label}</p>
                </li>
              ))}
            </ul>
          </section>
          <ul class="approach" style={`--n: ${home.approach.length}`}>
            {home.approach.map((a) => <li><h3 class="approach__t">{a.title}</h3><p>{a.text}</p></li>)}
          </ul>
          <!-- One quote: the large pane beside the two results. Two or three quotes: a row of quotes over a row of results. -->
          <div class:list={["proof__grid", { 'proof__grid--two': homeQuotes.length === 2, 'proof__grid--three': homeQuotes.length > 2 }]}>
            {homeQuotes.map((q) => (
              <figure class="proof__quote glass" data-lens>
                <blockquote><p>“{q.quote}”</p></blockquote>
                <figcaption><b>{q.name}</b>{q.role ? `${q.role}, ` : ''}{q.organisation}</figcaption>
              </figure>
            ))}
            {results.map((r) => (
              <a class="result glass" href={r.href} data-lens>
                <span class="result__who">{r.client}</span>
                <span class="result__line">{r.line}</span>
                <span class="result__go">Read the Case Study <span class="arrow" aria-hidden="true">→</span></span>
              </a>
            ))}
          </div>
          <a class="btn glass-button proof__go" href={startHref}>Start a Project <span class="arrow" aria-hidden="true">→</span></a>
        </section>
        </div>

        <div class="band">
        <div class:list={["band__art", { canvas: !painting }]} style={painting ? undefined : `--canvas: ${canvas}`} aria-hidden="true">{painting && <Image src={home.pageImage} alt="" widths={[1100, 1600]} quality={55} sizes="100vw" />}</div>
        <!-- About: who the studio is and why it exists; the process lives in How We Work. -->
        <section class="about wrap" id="about" aria-labelledby="about-h">
          <h2 class="big about__h" id="about-h">About</h2>
          <div class="about__text">
            <p class="about__lead">{home.aboutLead}</p>
            <a class="btn glass-button" href="/about/">More About the Studio <span class="arrow" aria-hidden="true">→</span></a>
          </div>
        </section>
        </div>
      </div>
    </main>

    <!-- Close and footer: one night chapter to the end of the page, the garden engraving rising from the bottom. -->
    <div class="night end">
      <!-- Lemoyne's ceiling, toned gold on warm black. It now fills the close and footer to the very bottom,
           with the copyright on it (Josh's mockup, 28 Oct). -->
      <div class="close__art" aria-hidden="true"><Image src={closeArt} alt="" widths={[800, 1400, 1900]} sizes="100vw" /></div>
      <section class="close wrap" id="contact" aria-labelledby="close-h">
        <h2 class="close__h big" id="close-h">Start a Project</h2>
        <div class="close__body glass" data-lens>
          <p class="close__p">{home.closeText}</p>
          <div class="acts">
            <a class="btn btn--solid" href={startHref}><span class="swap"><span>{home.startButton}</span><span aria-hidden="true">Email Us ↗</span></span></a>
            <button class="btn" type="button" data-copy={email}><span data-label>Copy Email</span></button>
            <span class="sr-only" aria-live="polite" data-status></span>
          </div>
        </div>
      </section>
      <!-- Footer links and the garden engraving removed (Josh, 28 Oct): only the copyright stays, centred under the close. -->
      <footer class="footer"><p>© 2026 Conceptual Studio Limited</p></footer>
    </div>

        <script>
      import { mountLens } from '../scripts/lens.js';
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const ease = 'cubic-bezier(0.16, 1, 0.3, 1)';

      // Lens glass. The hero plate can use the WebGL glass over its painting in Firefox and Safari;
      // the field panes move over live content, so there they keep the clear CSS glass.
      // Light glass (glass-light, Josh 28 Oct): only small chrome bends, three pieces at most, nav first;
      // big panes are plain blurred glass (lens.js decides).
      document.querySelector<HTMLElement>('[data-filters]')!.hidden = false; // shown before the lens counts its height
      mountLens(document.querySelector('.hero__plate'), null); // over the running painting, so CSS glass like the panes
      document.querySelectorAll<HTMLElement>('.field [data-lens], .stat, .close__body').forEach((el) => mountLens(el, null));

      // The running painting: it starts at the top of the opening, and each band's slice starts where the band sits.
      const hero = document.querySelector<HTMLElement>('.hero')!;
      const field = document.querySelector<HTMLElement>('.field')!;
      let width = 0;
      const place = () => {
        // Sized once per page width, with room to spare, so opening a service never zooms it (Josh, 2 Nov).
        // All reads, then all writes: one layout instead of one per band.
        const top = hero.offsetHeight - field.offsetTop;
        const ys = [...field.querySelectorAll<HTMLElement>('.band')].map((b) => [b, top + b.offsetTop] as const);
        if (innerWidth !== width) {
          width = innerWidth;
          document.documentElement.style.setProperty('--run-h', `${Math.round((hero.offsetHeight + field.offsetHeight) * 1.25)}px`);
        }
        ys.forEach(([b, y]) => b.style.setProperty('--y', `${y}px`));
      };
      const ro = new ResizeObserver(place);
      ro.observe(hero);
      ro.observe(field);

      // Nav: light over the night chapters, dark over paper. Watches a 1px line across the nav's middle.
      const nav = document.querySelector<HTMLElement>('[data-nav]')!;
      const nights = [...document.querySelectorAll('.night')];
      const under = new Set<Element>();
      let watch: IntersectionObserver | undefined;
      const watchNav = () => {
        watch?.disconnect(); under.clear();
        const r = nav.getBoundingClientRect();
        const y = Math.round(r.top + r.height / 2);
        watch = new IntersectionObserver((entries) => {
          entries.forEach((e) => (e.isIntersecting ? under.add(e.target) : under.delete(e.target)));
          nav.classList.toggle('is-dark', under.size > 0);
        }, { rootMargin: `-${y}px 0px -${Math.max(0, innerHeight - y - 1)}px 0px` });
        nights.forEach((n) => watch!.observe(n));
      };
      watchNav();
      addEventListener('resize', watchNav);

      // Stats count up once, when they come into view, each starting as its card fades in (STAT_IN, as in the CSS).
      // The final figure is in the page for screen readers.
      const STAT_IN = (i: number) => 500 + i * 140;
      if (!still) {
        const counter = new IntersectionObserver((entries) => entries.forEach((e) => {
          if (!e.isIntersecting) return;
          counter.unobserve(e.target);
          const el = e.target as HTMLElement;
          const to = Number(el.dataset.count);
          const t0 = performance.now() + STAT_IN(Number(el.dataset.i));
          const step = (t: number) => {
            const k = Math.min(1, Math.max(0, (t - t0) / 1400));
            const text = Math.round(to * (1 - (1 - k) ** 3)).toLocaleString('en-GB'); // 20000 shows as 20,000
            if (el.textContent !== text) el.textContent = text; // only touch the page when the figure changes
            if (k < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        }), { threshold: 0.6 });
        document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => { el.textContent = '0'; counter.observe(el); });
      }

      // Featured work filters: the grid updates in place with a short fade and scale.
      const bar = document.querySelector<HTMLElement>('[data-filters]')!;
      const grid = document.querySelector<HTMLElement>('[data-grid]')!;
      const list = document.querySelector<HTMLElement>('[data-list]')!;
      const views = [[...grid.children], [...list.children]] as HTMLElement[][];
      const viewBtn = document.querySelector<HTMLButtonElement>('[data-view]')!;
      const more = document.querySelector<HTMLButtonElement>('[data-show-more]')!;
      const empty = document.querySelector<HTMLElement>('[data-empty]')!;
      let current = 'all';
      let all = false;
      const show = () => {
        let match: HTMLElement[] = [];
        views.forEach((items) => { // the grid and the list filter alike
          match = items.filter((li) => current === 'all' || li.dataset.filter === current);
          const shown = all ? match : match.slice(0, 6);
          items.forEach((li) => { li.hidden = !shown.includes(li); });
        });
        more.hidden = all || match.length <= 6;
        empty.hidden = match.length > 0;
      };
      const pane = () => (list.hidden ? grid : list); // the view on screen
      const swap = async (update = show) => {
        if (still) return update();
        await pane().animate([{ opacity: 1 }, { opacity: 0, transform: 'scale(0.98)' }], { duration: 140, easing: 'ease-in' }).finished;
        update();
        pane().animate([{ opacity: 0, transform: 'scale(0.98)' }, { opacity: 1, transform: 'none' }], { duration: 320, easing: ease });
      };
      bar.hidden = false;
      bar.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
        if (!btn || btn.dataset.filter === current) return;
        current = btn.dataset.filter!;
        all = false;
        bar.querySelectorAll('[data-filter]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        swap();
      });
      more.addEventListener('click', () => { all = true; show(); });
      document.querySelectorAll<HTMLAnchorElement>('[data-tag]').forEach((a) => a.addEventListener('click', () => bar.querySelector<HTMLButtonElement>(`[data-filter="${a.dataset.tag}"]`)?.click()));
      viewBtn.addEventListener('click', () => swap(() => {
        const toList = list.hidden;
        list.hidden = !toList; grid.hidden = toList;
        viewBtn.ariaLabel = viewBtn.title = toList ? 'Grid view' : 'List view';
        viewBtn.toggleAttribute('data-list-on', toList);
        document.querySelectorAll<HTMLVideoElement>('#work video').forEach((v) => v.pause());
      }));
      show();

      // Social media videos play in their card on click, with controls from then on; one plays at a time.
      const vids = [...document.querySelectorAll<HTMLVideoElement>('#work video')];
      grid.querySelectorAll<HTMLButtonElement>('[data-play]').forEach((btn) => btn.addEventListener('click', () => {
        const v = btn.previousElementSibling as HTMLVideoElement;
        btn.remove();
        v.controls = true;
        v.play();
      }));
      vids.forEach((v) => v.addEventListener('play', () => vids.forEach((o) => o !== v && o.pause())));

      // Services accordion: one row open at a time; closed rows are inert so focus skips them.
      // The work list (list view) uses the same rows: one open at a time within each list.
      const setRow = (row: HTMLElement, open: boolean) => {
        row.querySelector('.acc__btn')!.setAttribute('aria-expanded', String(open));
        const panel = row.querySelector<HTMLElement>('.acc__panel')!;
        panel.toggleAttribute('data-closed', !open);
        panel.inert = !open;
      };
      document.querySelectorAll('[data-acc]').forEach((acc) => {
        const rows = [...acc.querySelectorAll<HTMLElement>('.acc__row')];
        rows.forEach((row) => {
          setRow(row, false); // all closed on load (Josh, 28 Oct)
          row.querySelector('.acc__btn')!.addEventListener('click', () => {
            const open = row.querySelector('.acc__btn')!.getAttribute('aria-expanded') !== 'true';
            rows.forEach((r) => setRow(r, r === row && open));
            if (!open) row.querySelector('video')?.pause();
          });
        });
      });

      // Copy email: the label confirms, a polite live region announces it, then it reverts.
      const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
      const label = btn?.querySelector<HTMLElement>('[data-label]');
      const status = document.querySelector<HTMLElement>('[data-status]');
      btn?.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(btn.dataset.copy!); } catch { location.href = `mailto:${btn.dataset.copy}`; return; }
        btn.style.minWidth = `${btn.offsetWidth}px`; label!.textContent = 'Copied!'; status!.textContent = 'Email address copied';
        setTimeout(() => { label!.textContent = 'Copy Email'; status!.textContent = ''; }, 2000); // width held so the button doesn't jump (Josh, 28 Oct)
      });

      // Phone menu: a link closes the sheet as it jumps to its section.
      const menu = document.querySelector<HTMLElement>('#site-menu')!;
      menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) menu.hidePopover(); });

      // The nav's current pill follows the section in view (Josh, 28 Oct: it stayed on Home all the way down).
      const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('.nav__links a')];
      const sections = navLinks.map((a) => document.querySelector<HTMLElement>(a.hash)).filter(Boolean) as HTMLElement[];
      const spy = () => {
        const line = innerHeight * 0.35;
        const current = sections.filter((s) => s.getBoundingClientRect().top <= line).pop() ?? sections[0];
        navLinks.forEach((a) => (a.hash === `#${current.id}` ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
      };
      spy();
      let spying = 0; // once per frame, however fast the scroll events come
      addEventListener('scroll', () => { spying ||= requestAnimationFrame(() => { spying = 0; spy(); }); }, { passive: true });
    </script>
    <Tune />
  </body>
</html>

<style>
  /* One spacing scale for the home page (Josh, 28 Oct): section top, heading to content, grid gaps, card padding. */
  :global(:root) { --sp-section: 140px; --sp-head: 40px; --sp-gap: 24px; --sp-card: 32px; }
  @media (max-width: 759.98px) { :global(:root) { --sp-section: 112px; --sp-head: 28px; --sp-gap: 16px; --sp-card: 22px; } }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  /* Every section heading, one size: the Selected Work heading's (Josh, 28 Oct). */
  .big { font-family: var(--display); font-weight: 500; font-size: clamp(56px, 7.8vw, 120px); letter-spacing: -0.015em; line-height: 0.92; }
  .acts { display: flex; flex-wrap: wrap; align-items: center; gap: var(--btn-gap); }
  html { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  [id] { scroll-margin-top: 96px; } /* anchors land below the sticky nav */

  /* Nav: sticky glass for the whole page (Josh, 28 Oct; replaces "scrolls away with the opening").
     It sits at the top, and .is-dark turns it light over the night chapters. */
  .nav { position: fixed; z-index: 50; top: 14px; left: var(--margin); right: var(--margin); height: 60px; border-radius: var(--radius); display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 0 8px 0 24px; transition: color 300ms ease-out, background-color 300ms ease-out, box-shadow 300ms ease-out; }
  .nav.is-dark { color: #F1DFC8; }
  .nav__mark { font-family: var(--display); font-size: 24px; letter-spacing: -0.01em; text-decoration: none; }
  .nav__links { list-style: none; display: flex; gap: 2px; margin: 0; padding: 0; }
  .nav__menu { display: none; }

  /* Opening: the quiet etching fills the screen, the plate centred over the trees and sky. */
  .hero { position: relative; isolation: isolate; min-height: 100svh; padding: 116px var(--margin) 40px; display: grid; align-content: center; } /* the bento as one centred block */
  /* The opening is the first stretch of the running painting (Josh, 2 Nov), toned and quiet like the bands. */
  .hero { overflow: clip; }
  .hero__art { position: absolute; top: 0; left: 0; z-index: -1; width: 100%; height: var(--run-h, 100%); object-fit: cover; object-position: 50% 0; opacity: 0.45; filter: url(#tone-day); }
  .hero__bento { align-self: center; justify-self: center; width: min(1140px, 100%); display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--sp-gap); }
  .hero__plate { position: relative; grid-column: 1 / -1; padding: 64px 56px 56px; display: grid; justify-items: center; gap: 26px; border-radius: var(--radius); text-align: center; } /* type and space carry it: one centred statement */
  .hero__h { font-family: var(--display); font-weight: 500; font-size: clamp(44px, 5.2vw, 76px); line-height: 1.06; letter-spacing: -0.01em; text-wrap: balance; }
  .hero__p { max-width: 50ch; font-size: 20px; line-height: 1.5; text-wrap: pretty; }
  .hero__plate .acts { justify-content: center; margin-top: 6px; }
  /* The three hero buttons share one shape: the .btn's height, padding and type (Josh, 28 Oct). */
  .hero__plate .avail { --fill: color-mix(in srgb, var(--paper) 55%, transparent); }
  .hero__plate .btn { min-height: var(--btn-h-sm); padding: 0 var(--btn-px-sm); font-size: 16px; } /* the availability pill's size, so all three fit one row */
  .hero__work { --fill: color-mix(in srgb, var(--paper) 55%, transparent); gap: 8px; }
  /* The arrow points down where there's no hover (phones, tablets); with a mouse it points right and turns down on hover. */
  .hero__down { display: inline-block; transform: rotate(90deg); transition: transform 280ms var(--ease-out); }
  @media (hover: hover) {
    .hero__down { transform: none; }
    .hero__work:hover .hero__down { transform: rotate(90deg); }
  }

  /* The field: an etching behind each band of glass, scrolling with it. */
  .band { position: relative; isolation: isolate; padding-bottom: 160px; }
  /* Each band is its own painting with a clean edge (Josh, 2 Nov: "hard lines, like separate paintings",
     as Apple's pages do). The art fills its band edge to edge and stops there; no fades between sections. */
  .band__art { position: absolute; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; }
  .band.night { --ink-2: color-mix(in srgb, var(--ink) 86%, var(--paper)); } /* secondary text 5:1 or better over the art */
  /* One painting runs down the whole field (Josh, 2 Nov): every band holds the same image, sized to the opening plus the field
     and shifted up by the band's own offset (--y, set below), so each shows the next stretch of it. */
  .band__art img { position: absolute; left: 0; top: 0; transform: translateY(calc(-1 * var(--y, 0px))); width: 100%; height: var(--run-h, 100%); object-fit: cover; object-position: 50% 0; opacity: 0.25; filter: url(#tone-day); } /* 25%, day and night (Josh, 2 Nov) */
  .band.night .band__art img { opacity: 0.25; filter: url(#tone-night); }
  /* Plain canvas (Josh, 2 Nov: simpler): the weave only, toned per band like the painting. A tile, so nothing zooms. */
  /* Soft-light over the band's own paper, so the weave reads on cream and on warm black without shifting either
     colour: a tactile ground for the glass to bend (Josh, 2 Nov: "plain colour... glass just falls apart"). */
  .canvas { background: var(--canvas) 0 0 / 510px repeat; mix-blend-mode: soft-light; opacity: 0.9; }
  .hero__art.canvas { height: 100%; }
  .hero:has(.canvas), .band:has(> .canvas) { background: var(--paper); } /* the paper the weave blends into */
  .band.night .canvas { opacity: 1; }
  .tones { position: absolute; width: 0; height: 0; }

  /* One centred column for everything under the opening (Josh, 28 Oct: "centred to the page").
     Headings stay left-aligned inside it. 1140px lets both rows of work fit one screen at 1440. */
  .band > section { box-sizing: content-box; max-width: 1140px; margin-inline: auto; }

  /* Stats: four glass cards, a large number over a short label, straight under the hero plate (Josh, 28 Oct). */
  .stats { margin-top: var(--sp-head); } /* in the proof, beside the clients (Josh, 3 Nov) */
  .stats__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--sp-gap); }
  .stat { position: relative; display: grid; align-content: space-between; gap: 20px; min-height: 160px; padding: 26px 28px 24px; border-radius: var(--radius); }
  /* After the hero has landed, the stat cards rise in one by one, left to right (Josh, 2 Nov). Delay matches STAT_IN in the script. */
  @media (prefers-reduced-motion: no-preference) { .stat { animation: stat-in 700ms var(--ease-out) calc(500ms + var(--i) * 140ms) both; } }
  @keyframes stat-in { from { opacity: 0; transform: translateY(18px); } }
  .stat__n { font-family: var(--display); font-weight: 500; font-size: clamp(48px, 4.2vw, 62px); line-height: 0.9; letter-spacing: 0.01em; font-variant-numeric: tabular-nums; }
  .stat__plus { margin-left: 0.12em; -webkit-text-stroke: 0.03em currentColor; } /* half a space off the figure, and stroked to the digits' weight: Agatho has no bolder cut (Josh, 28 Oct) */
  .stat__l { font-size: 18px; line-height: 1.35; font-weight: 500; text-wrap: balance; }

  /* Featured work: heading, the filter bar, then compact landscape cards three to a row (Josh, 28 Oct), all the same shape. */
  .fw { padding-top: var(--sp-section); }
  .filterbar { position: relative; display: inline-flex; gap: 2px; margin-top: var(--sp-head); padding: 6px; border-radius: var(--pill); max-width: 100%; overflow-x: auto; scrollbar-width: none; }
  .filterbar[hidden] { display: none; }
  .fw__grid { list-style: none; margin: var(--sp-gap) 0 0; padding: 0; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--sp-gap); }
  .fw__grid > [hidden] { display: none; }
  /* Projects span four of twelve columns (three to a row, two on tablets, one on phones); videos are vertical,
     so they take three: four to a row (two on phones). */
  .fw__grid > li { grid-column: span 4; }
  .fw__grid > .fw__vid { grid-column: span 3; }
  /* Narrow cards: the year sits under the title, so a longer title never pushes it to a line of its own. */
  .fw__vid .card__row { flex-direction: column; align-items: start; gap: 2px; }
  .fw__vid .card__y { margin-left: 0; }
  .fw__vid .card__t { font-size: 20px; }
  .vid { position: relative; }
  .card .vid__v { display: block; aspect-ratio: 9 / 16; background: #000; }
  .vid__play { position: absolute; inset: 0; display: grid; place-items: center; border: 0; padding: 0; border-radius: var(--radius-inner); background: none; cursor: pointer; }
  .vid__icon { display: grid; place-items: center; width: 64px; height: 64px; padding-left: 3px; border-radius: 50%; transition: transform 300ms ease-out; }
  @media (hover: hover) { .vid__play:hover .vid__icon { transform: scale(1.08); } }
  .vid__play:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  .card { position: relative; display: grid; align-content: start; gap: 12px; height: 100%; padding: 12px 12px 16px; border-radius: var(--radius); text-decoration: none; transition: background-color 300ms ease-out, color 300ms ease-out; }
  .card__img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border-radius: var(--radius-inner); } /* concentric: 28px card, 12px inset */
  .card__row { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; padding: 0 8px 2px; }
  .card__y { margin-left: auto; }
  .card__t { font-size: 20px; line-height: 1.2; font-weight: 600; letter-spacing: -0.02em; }
  .card__y { font-size: 17px; font-weight: 600; color: var(--ink-2); letter-spacing: -0.01em; } /* proportional figures: tabular ones left gaps (Josh, 28 Oct) */
  .card__tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .card__out { display: block; margin-top: -8px; padding: 0 8px 2px; font-size: 17px; line-height: 1.4; color: var(--ink-2); }
  /* One fixed shape for every project card (Josh, 28 Oct): the title on one line, then badges left and the year
     right, then the outcome held to two lines (space kept even when empty), so rows line up and stay short. */
  .card__head { display: flex; align-items: baseline; gap: 12px; padding: 0 8px; }
  .card__head .card__t { min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .card__head + .card__row { margin-top: -6px; flex-wrap: nowrap; }
  .card__row .card__tags { flex-wrap: nowrap; overflow: hidden; }
  .card > .card__out { min-height: 2.8em; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
  .tag { padding: 5px 11px; border-radius: var(--pill); background: color-mix(in srgb, var(--ink) 7%, transparent); font-size: 14px; font-weight: 500; line-height: 1.2; }
  /* Hover (Josh, 28 Oct): no rise; the card turns to its day glass, like the buttons in the night bands. */
  @media (hover: hover) { .fw .card.glass:hover { color-scheme: light; background: color-mix(in srgb, var(--paper) 90%, transparent); } } /* beats the night pane glass */
  .card:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  .fw__empty { margin-top: 32px; font-size: 20px; }
  .fw__foot [hidden] { display: none; }
  .fw__foot { display: flex; flex-wrap: wrap; align-items: center; gap: var(--btn-gap); margin-top: var(--btn-space); font-size: 20px; }
  /* Grid or list view (Josh, 2 Nov). The list is the Services accordion: title, tags and year, opening to the brief. */
  /* The toggle is its own glass circle beside the filters, so the filters can scroll on phones without hiding it. */
  .fw__tools { display: flex; align-items: center; gap: 10px; margin-top: var(--sp-head); }
  .fw__tools .filterbar { margin-top: 0; min-width: 0; }
  .fw__view { position: relative; flex: none; display: grid; place-items: center; width: 56px; height: 56px; padding: 0; border: 0; border-radius: 50%; color: inherit; cursor: pointer; }
  @media (hover: hover) { .fw__view:hover { color-scheme: light; background: color-mix(in srgb, var(--paper) 90%, transparent); color: var(--ink); } }
  .fw__view:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  .fw__view .fw__tiles, .fw__view[data-list-on] .fw__list { display: none; }
  .fw__view[data-list-on] .fw__tiles { display: block; }
  .fw__grid[hidden], .fw__list-view[hidden], .fw__list-view > [hidden] { display: none; }
  .fw__list-view { margin-top: var(--sp-gap); }
  .fwl__t { flex: 1 1 auto; min-width: 0; }
  .fwl__tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .fw__list-view [aria-expanded='true'] > .acc__from { opacity: 1; } /* the year stays: nothing inside repeats it */
  .fwl__body { grid-template-columns: minmax(0, 1fr) 360px; align-items: start; }
  .fwl__body .acc__text { grid-row: 1; }
  .fwl__body .acc__go { grid-column: 1; justify-self: start; }
  .fwl__img { grid-column: 2; grid-row: 1 / span 2; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border-radius: var(--radius-inner); }
  .fwl__vid { grid-column: 1; grid-row: 1; width: 220px; aspect-ratio: 9 / 16; background: #000; } /* social videos play in the open row */

  /* Services: the same heading as Featured Work, then full-width rows that open one at a time. */
  .services { padding-top: var(--sp-section); }
  .tags { list-style: none; margin: 4px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .tag-btn { --fill: color-mix(in srgb, var(--paper) 55%, transparent); } /* frosted like the hero buttons, dark on hover like every .btn (Josh, 4 Nov) */
  /* Services as a ruled list in large type (WECOMEET): the row in hand turns full ink and its example shows to the
     right; with none in hand the first shows. Plain CSS, so it works without script. */
  .svc { position: relative; margin-top: var(--sp-head); }
  .svc__list { list-style: none; margin: 0; padding: 0; }
  .svc__row { position: relative; } /* each example sits beside its own row (Josh, 4 Nov) */
  .svc__link { width: 56%; border-top: 1px solid color-mix(in srgb, var(--ink) 22%, transparent); }
  .svc__row:last-child .svc__link { border-bottom: 1px solid color-mix(in srgb, var(--ink) 22%, transparent); }
  .svc__link { display: grid; gap: 10px; padding: 28px 0 30px; color: color-mix(in srgb, var(--ink) 55%, transparent); text-decoration: none; transition: color 200ms ease-out, transform 300ms var(--ease-out); }
  .svc__name { font-family: var(--display); font-weight: 500; font-size: clamp(44px, 5vw, 76px); line-height: 1; letter-spacing: -0.01em; }
  .svc__line { font-size: 20px; line-height: 1.45; max-width: 44ch; color: var(--ink); }
  .svc__price { font-size: 18px; font-weight: 600; color: var(--ink); font-variant-numeric: tabular-nums; }
  .svc__price span { font-weight: 400; color: var(--ink-2); }
  .svc__ex { position: absolute; top: 50%; right: 0; width: 40%; height: auto; aspect-ratio: 4 / 3; translate: 0 -50%; object-fit: cover; border-radius: var(--radius); opacity: 0; transition: opacity 300ms ease-out; pointer-events: none; }
  .svc__row:is(:hover, :focus-within) .svc__link { color: var(--ink); transform: translateX(8px); }
  .svc:not(:has(.svc__row:is(:hover, :focus-within))) .svc__row:first-child .svc__link { color: var(--ink); }
  .svc__row:is(:hover, :focus-within) .svc__ex,
  .svc:not(:has(.svc__row:is(:hover, :focus-within))) .svc__row:first-child .svc__ex { opacity: 1; }
  .svc__link:focus-visible { outline: 2px solid var(--ink); outline-offset: 4px; border-radius: 8px; }
  .svc__more { list-style: none; margin: 20px 0 0; padding: 0; display: grid; gap: 6px; }
  .svc__more a { font-size: 18px; color: inherit; text-decoration: none; }
  .svc__more span { color: var(--ink-2); }
  @media (hover: hover) { .svc__more a:hover .arrow { transform: rotate(-45deg); } }
  @media (max-width: 959.98px) {
    .svc__link { width: auto; color: var(--ink); }
    .svc__row:is(:hover, :focus-within) .svc__link { transform: none; }
    .svc__ex { position: static; translate: none; display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; margin-bottom: 28px; opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) { .svc__link, .svc__ex { transition: none; } .svc__row:is(:hover, :focus-within) .svc__link { transform: none; } }
  .services__intro { margin-top: 20px; max-width: 46ch; font-size: 20px; line-height: 1.45; }
  .services__note { margin-top: 8px; font-weight: 600; }
  .acc { position: relative; margin-top: var(--sp-head); padding: 4px var(--sp-card); border-radius: var(--radius); }
