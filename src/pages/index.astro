---
// Home (brief 6.1), built on the chosen direction: Prototype A, the quiet etching (DECISIONS, 26 Oct).
// Pass 1 of 2 (Josh, 28 Oct): sticky nav, stats, filtered compact work grid, services accordion,
// all in the shared glass, over the etching carried down behind them.
import Tune from '../components/Tune.astro';
import { glassStyle } from '../lib/site';
import '../styles/tokens.css';
import '../styles/components.css';
import { Image } from 'astro:assets';
import { email, startHref, quoteHref, sentence, clientGroups, trustedBy } from '../data/site';
import { availability, homeQuote, responseTime } from '../lib/site';
import { featured, projectHref, homeFilters } from '../data/work';
import { services } from '../data/services';
import heroArt from '../assets/art/engraved/jardin-quiet.jpg';
import footerArt from '../assets/art/engraved/garden-night.webp';
import closeArt from '../assets/art/engraved/lemoyne-night.jpg';

const headline = 'Brands & Data, Made Clear'; // option 3 (Josh, 26 Oct)
const links = [['Work', '#work'], ['Services', '#services'], ['About', '#about'], ['Contact', '#contact']];

// Title Case for headings, buttons and labels (Josh, 28 Oct): every word capitalised except the small
// ones, never the first or last; "and" becomes "&". Capitals already there (KUT) are kept.
const small = new Set(['a', 'an', 'the', 'of', 'to', 'in', 'on', 'for', 'at', 'by', 'or', 'but', 'with', 'as']);
const titleCase = (s: string) => s.replace(/\band\b/gi, '&').split(' ')
  .map((w, i, all) => (i > 0 && i < all.length - 1 && small.has(w.toLowerCase()) ? w.toLowerCase() : w.charAt(0).toUpperCase() + w.slice(1)))
  .join(' ');

// Placeholder figures from Josh's brief (28 Oct), not yet confirmed. Replace each before launch.
const stats = [
  { n: 50, unit: '', plus: true, label: 'Projects Delivered' }, // CONFIRM
  { n: 1, unit: 'M', plus: true, label: 'Data Points Visualised' }, // CONFIRM
  { n: 48, unit: 'hr', plus: false, label: 'First-Concept Turnaround' }, // CONFIRM
  { n: 90, unit: '%', plus: false, label: 'of Clients Return for More Work' }, // CONFIRM
];

// Featured work and the services come from Pages CMS (Projects and Services).
// The first four by home page position show; any more wait behind "Show More".
const SHOWN = 4;
const cards = featured.map((p) => ({
  title: p.title, year: p.year, href: projectHref(p), image: p.image, alt: p.alt,
  position: p.homePosition ?? p.position, filter: p.homeFilter, student: p.student,
}));
// How I work (outside pass 1, unchanged).
const steps = [
  ['Call and brief', 'We talk through what you need, your budget, the formats, and what you want the work to achieve, so we both know what to expect before I start.'],
  ['Design and feedback', 'I share work in progress and we go back and forth on it, so nothing reaches the final round as a surprise.'],
  ['Revisions and finishing', 'I make your changes and finish every detail before anything is signed off.'],
  ['Handover', 'You get the final files in whatever format and by whatever method suits your team.'],
];
const menu = services.map((s) => ({ id: s.id, name: titleCase(s.name), price: s.home.price, time: s.home.time, href: s.href ?? '/services/', link: titleCase(s.home.link), text: s.line }));
---
<!doctype html>
<html lang="en-GB" style={glassStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Conceptual Studio: brand identity and data visualisation, London</title>
    <meta name="description" content={sentence} />
    <link rel="preload" href="/fonts/agatho-medium-subset.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-4-variable.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <!-- Sticky glass nav. It turns light over the night chapters (script below). -->
    <nav class="nav glass" aria-label="Main" data-lens data-nav>
      <a class="nav__mark" href="/">Conceptual Studio</a>
      <ul class="nav__links">
        <li><a class="glass-pill" href="/" aria-current="page">Home</a></li>
        {links.map(([l, h]) => <li><a class="glass-pill" href={h}>{l}</a></li>)}
      </ul>
      <a class="nav__menu glass-pill" href="#site-links">Menu</a>
    </nav>
    <main>
      <!-- One painting held behind the opening, stats, work and services (Josh, 28 Oct: it must not repeat).
           It stays put while the page scrolls over it, so every pane of glass has the same art behind it. -->
      <div class="field">
      <div class="field__track" aria-hidden="true"><div class="field__art"><Image class="hero__art" src={heroArt} alt="" widths={[640, 1024, 1600, 2400]} sizes="100vw" loading="eager" fetchpriority="high" /></div></div>
      <header class="hero">
        <div class="hero__plate glass" data-lens>
          <h1 class="hero__h">{headline}</h1>
          <p class="hero__p">{sentence}</p>
          <div class="acts">
            <a class="btn btn--solid" href={startHref}><span class="swap"><span>Start a Project</span><span aria-hidden="true">Contact Me ↗</span></span></a>
            {availability.on && <a class="avail" href={`mailto:${email}`}><span class="avail__dot" aria-hidden="true"></span><span class="swap"><span>{titleCase(availability.text)}</span><span aria-hidden="true">↗ Email Me</span></span></a>}
            <a class="btn glass-button" href="#work">See the Work <span class="arrow" aria-hidden="true">→</span></a>
          </div>
        </div>
        {trustedBy.length > 0 && (
          <p class="trusted glass" data-lens><b>Trusted By</b> {trustedBy.join(', ')} &amp; More</p>
        )}
      </header>


        <section class="stats wrap" aria-label="The studio in numbers">
          <ul class="stats__list">
            {stats.map((s) => (
              <li class="stat glass" data-lens>
                <p class="stat__n"><span aria-hidden="true"><span data-count={s.n}>{s.n}</span>{s.unit && <span class="stat__unit">{s.unit}</span>}{s.plus && <span class="stat__plus">+</span>}</span><span class="sr-only">{`${s.n}${s.unit}${s.plus ? '+' : ''}`}</span></p>
                <p class="stat__l">{s.label}</p>
              </li>
            ))}
          </ul>
        </section>

        <section class="fw wrap" id="work" aria-labelledby="fw-h">
          <h2 class="fw__h big" id="fw-h">Featured Work</h2>
          <div class="filterbar glass" role="group" aria-label="Filter featured work" data-lens data-filters hidden>
            <button class="glass-pill" type="button" data-filter="all" aria-pressed="true">All</button>
            {homeFilters.map((f) => <button class="glass-pill" type="button" data-filter={f} aria-pressed="false">{f}</button>)}
          </div>
          <ul class="fw__grid" data-grid>
            {cards.map((c, i) => (
              <li data-filter={c.filter ?? ''} data-more={i >= SHOWN ? '' : undefined}>
                <a class="card glass" href={c.href} data-lens>
                  <Image class="card__img" src={c.image} alt={c.alt} widths={[400, 700, 1100]} sizes="(min-width: 760px) min(580px, 47vw), calc(100vw - 32px)" style={c.position ? `object-position: ${c.position}` : undefined} />
                  <span class="card__row">
                    <span class="card__t">{c.title}</span>
                    <span class="card__tags">
                      {c.filter && <span class="tag">{c.filter}</span>}
                      {c.student && <span class="tag">Student Work</span>}
                    </span>
                    <span class="card__y">{c.year}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <p class="fw__empty" data-empty hidden>No projects under this filter yet.</p>
          <div class="fw__foot">
            <button class="btn glass-button" type="button" data-show-more hidden>Show More</button>
            <a class="link" href="/work/">All Projects<span class="arrow" aria-hidden="true">→</span></a>
          </div>
        </section>

        <section class="services wrap" id="services" aria-labelledby="services-h">
          <h2 class="big services__h" id="services-h">Services</h2>
          <p class="services__intro">Every project is priced on its scope, so these are starting points. You'll get a fixed quote after our first call.</p>
          <!-- All closed on load; one open at a time (Josh, 28 Oct). Without script every row shows open. -->
          <noscript><style>.acc__panel[data-closed] { grid-template-rows: 1fr; } .acc__icon { display: none; }</style></noscript>
          <div class="acc glass" data-lens data-acc>
            {menu.map((s) => (
              <div class="acc__row">
                <h3 class="acc__h">
                  <button class="acc__btn" type="button" id={`svc-${s.id}-btn`} aria-controls={`svc-${s.id}`} aria-expanded="false">
                    <span>{s.name}</span><span class="acc__icon" aria-hidden="true"></span>
                  </button>
                </h3>
                <div class="acc__panel" id={`svc-${s.id}`} role="region" aria-labelledby={`svc-${s.id}-btn`} data-closed>
                  <div class="acc__inner">
                    <div class="acc__body">
                      <p class="acc__text">{s.text}</p>
                      <p class="acc__price">{s.price}{s.time && <span>{s.time}</span>}</p>
                      <a class="btn glass-button acc__go" href={s.href} aria-label={s.link}>View Prices <span class="arrow" aria-hidden="true">→</span></a>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
          <div class="quote glass" data-lens>
            <h3 class="quote__h">Need Something Else?</h3>
            <p class="quote__p">A mix of these, or something we haven't listed? Tell us what you need and we'll send a fixed quote {responseTime}.</p>
            <a class="btn glass-button" href={quoteHref}>Ask for a Custom Quote <span class="arrow" aria-hidden="true">→</span></a>
          </div>
        </section>
      </div>

<!-- Proof: who I work with, in plain names, and one client's words set large. -->
      <section class="proof wrap" aria-labelledby="proof-h">
        <div class="proof__who">
          <h2 class="h2" id="proof-h">Who I work with</h2>
          <p class="proof__line">I work with further education colleges and adult learning services, a language school in Oxford, a tech startup in Tokyo and corporate clients.</p>
          <div class="proof__names">
            {clientGroups.map((g) => (
              <ul><li class="proof__kind">{g.kind}</li>{g.names.map((n) => <li>{n}</li>)}</ul>
            ))}
          </div>
        </div>
        {homeQuote && (
          <figure class="proof__quote">
            <blockquote><p>"{homeQuote.quote}"</p></blockquote>
            <figcaption><b>{homeQuote.name}</b>{homeQuote.role}, {homeQuote.organisation}</figcaption>
          </figure>
        )}
      </section>

      <!-- How I work: a real ordered list, the order carried by position, not numerals. -->
      <section class="how wrap" aria-labelledby="how-h">
        <div class="how__head">
          <h2 class="h2" id="how-h">How I work</h2>
          <p>How a project runs, from the first call to the files you keep.</p>
        </div>
        <ol class="how__list">
          {steps.map(([t, d]) => <li><h3 class="how__t">{t}</h3><p>{d}</p></li>)}
        </ol>
      </section>

      <!-- About: the plain facts. TBC: a photograph of me (brief 6.1). -->
      <section class="about wrap" id="about" aria-labelledby="about-h">
        <div class="about__text">
          <h2 class="h2" id="about-h">About</h2>
          <p class="about__lead">I trained at Kingston School of Art, led design at a tech startup in Tokyo, and have run Conceptual Studio full time since January 2026.</p>
          <a class="link" href="/about/">More about me<span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <dl class="about__facts">
          <div><dt>Studio</dt><dd>Conceptual Studio Limited, London</dd></div>
          <div><dt>Trained</dt><dd>Kingston School of Art</dd></div>
          <div><dt>Before</dt><dd>Design lead at a tech startup in Tokyo</dd></div>
          <div><dt>Full time since</dt><dd>January 2026</dd></div>
        </dl>
      </section>
    </main>

    <!-- Close and footer: one night chapter to the end of the page, the garden engraving rising from the bottom. -->
    <div class="night end">
      <section class="close wrap" id="contact" aria-labelledby="close-h">
        <!-- Lemoyne's ceiling, cropped to Jupiter and the gods, toned gold on warm black and faded into the night (Josh, 26 Oct). -->
        <div class="close__art" aria-hidden="true"><Image src={closeArt} alt="" widths={[800, 1400, 1900]} sizes="100vw" /></div>
        <h2 class="close__h big" id="close-h">Start a project</h2>
        <div class="close__body">
          <p class="close__p">If you're collecting quotes for a project, I'd be glad to be one of them. Send me a short note and I'll reply {responseTime}.</p>
          <div class="acts">
            <a class="btn btn--solid" href={startHref}><span class="swap"><span>Start a project</span><span aria-hidden="true">Email me ↗</span></span></a>
            <button class="btn" type="button" data-copy={email}><span data-label>Copy email</span></button>
            <span class="sr-only" aria-live="polite" data-status></span>
          </div>
        </div>
      </section>
      <footer class="footer">
        <div class="footer__text wrap">
          <p class="footer__name">Conceptual Studio Limited, London</p>
          <ul class="footer__links" id="site-links">
            {links.map(([l, h]) => <li><a href={h}>{l}</a></li>)}
          </ul>
          <p class="footer__small">© 2026 Conceptual Studio Limited</p>
        </div>
        <div class="footer__land" aria-hidden="true"><Image src={footerArt} alt="" widths={[800, 1600, 2400]} sizes="100vw" /></div>
      </footer>
    </div>

        <script>
      import { mountLens } from '../scripts/lens.js';
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const ease = 'cubic-bezier(0.16, 1, 0.3, 1)';

      // One glass for every pane (Josh, 28 Oct). Chromium bends the live page; Firefox and Safari bend the
      // held painting with the WebGL glass. Panes hidden for now (filtered cards) size themselves when shown.
      const heroArt = document.querySelector<HTMLImageElement>('.hero__art');
      document.querySelector<HTMLElement>('[data-filters]')!.hidden = false; // shown before mounting so it has a size
      document.querySelectorAll<HTMLElement>('[data-nav], .field [data-lens]').forEach((el) => mountLens(el, heroArt, undefined, true));

      // Nav: light over the night chapters, dark over paper. Checked on every scroll against the nav's middle
      // line; an IntersectionObserver band missed big jumps (it stayed dark after jumping up from the footer).
      const nav = document.querySelector<HTMLElement>('[data-nav]')!;
      const nights = [...document.querySelectorAll<HTMLElement>('.night')];
      const tone = () => {
        const r = nav.getBoundingClientRect();
        const y = r.top + r.height / 2;
        nav.classList.toggle('is-dark', nights.some((n) => { const b = n.getBoundingClientRect(); return b.top <= y && b.bottom >= y; }));
      };
      tone();
      addEventListener('scroll', tone, { passive: true });
      addEventListener('resize', tone);

      // Scroll edge: once the hero plate reaches the nav, paper fills in behind the nav so its labels
      // never sit on other words or on photos. Over the opening it stays clear glass.
      const plate = document.querySelector<HTMLElement>('.hero__plate')!;
      const edge = () => nav.classList.toggle('is-over', plate.getBoundingClientRect().top < nav.getBoundingClientRect().bottom + 8);
      edge();
      addEventListener('scroll', edge, { passive: true });

      // Stats count up once, when they come into view. The final figure is in the page for screen readers.
      if (!still) {
        const counter = new IntersectionObserver((entries) => entries.forEach((e) => {
          if (!e.isIntersecting) return;
          counter.unobserve(e.target);
          const el = e.target as HTMLElement;
          const to = Number(el.dataset.count);
          const t0 = performance.now();
          const step = (t: number) => {
            const k = Math.min(1, (t - t0) / 1400);
            el.textContent = String(Math.round(to * (1 - (1 - k) ** 3)));
            if (k < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        }), { threshold: 0.6 });
        document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => { el.textContent = '0'; counter.observe(el); });
      }

      // Featured work filters: the grid updates in place with a short fade and scale.
      const bar = document.querySelector<HTMLElement>('[data-filters]')!;
      const grid = document.querySelector<HTMLElement>('[data-grid]')!;
      const items = [...grid.children] as HTMLElement[];
      const more = document.querySelector<HTMLButtonElement>('[data-show-more]')!;
      const empty = document.querySelector<HTMLElement>('[data-empty]')!;
      let current = 'all';
      let all = false;
      const show = () => {
        const match = items.filter((li) => current === 'all' || li.dataset.filter === current);
        const shown = all ? match : match.slice(0, 4);
        items.forEach((li) => { li.hidden = !shown.includes(li); });
        more.hidden = all || match.length <= 4;
        empty.hidden = match.length > 0;
      };
      const swap = async () => {
        if (still) return show();
        await grid.animate([{ opacity: 1 }, { opacity: 0, transform: 'scale(0.98)' }], { duration: 140, easing: 'ease-in' }).finished;
        show();
        grid.animate([{ opacity: 0, transform: 'scale(0.98)' }, { opacity: 1, transform: 'none' }], { duration: 320, easing: ease });
      };
      bar.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
        if (!btn || btn.dataset.filter === current) return;
        current = btn.dataset.filter!;
        all = false;
        bar.querySelectorAll('[data-filter]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        swap();
      });
      more.addEventListener('click', () => { all = true; show(); });
      show();

      // Services accordion: one row open at a time; closed rows are inert so focus skips them.
      const rows = [...document.querySelectorAll<HTMLElement>('[data-acc] .acc__row')];
      const setRow = (row: HTMLElement, open: boolean) => {
        row.querySelector('.acc__btn')!.setAttribute('aria-expanded', String(open));
        const panel = row.querySelector<HTMLElement>('.acc__panel')!;
        panel.toggleAttribute('data-closed', !open);
        panel.inert = !open;
      };
      rows.forEach((row) => {
        setRow(row, false);
        row.querySelector('.acc__btn')!.addEventListener('click', () => {
          const open = row.querySelector('.acc__btn')!.getAttribute('aria-expanded') !== 'true';
          rows.forEach((r) => setRow(r, r === row && open));
        });
      });

      // Copy email: the label confirms, a polite live region announces it, then it reverts.
      const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
      const label = btn?.querySelector<HTMLElement>('[data-label]');
      const status = document.querySelector<HTMLElement>('[data-status]');
      btn?.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(btn.dataset.copy!); } catch { location.href = `mailto:${btn.dataset.copy}`; return; }
        label!.textContent = 'Copied'; status!.textContent = 'Email address copied';
        setTimeout(() => { label!.textContent = 'Copy email'; status!.textContent = ''; }, 1550);
      });
    </script>
    <Tune />
  </body>
</html>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .big { font-family: var(--display); font-weight: 500; letter-spacing: -0.03em; line-height: 0.92; }
  .acts { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 14px; }
  [id] { scroll-margin-top: 96px; } /* anchors land below the sticky nav */

  /* Nav: sticky glass for the whole page (Josh, 28 Oct; replaces "scrolls away with the opening").
     It sits at the top, and .is-dark turns it light over the night chapters. */
  .nav { position: fixed; z-index: 50; top: 14px; left: var(--margin); right: var(--margin); height: 60px; border-radius: 28px; display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 0 8px 0 24px; transition: color 300ms ease-out, background-color 300ms ease-out, box-shadow 300ms ease-out; }
  .nav::before { transition: background-color 300ms ease-out; }
  /* Scroll edge (TASTE glass spec, iOS 27): once the page passes under the nav, paper fills in behind it so the
     labels never sit on bent text or busy photos. Over the opening it stays clear. */
  .nav.is-over { background-color: color-mix(in srgb, var(--paper) 78%, transparent); }
  .nav.is-over.is-lens::before, .nav.is-over[data-lens]:not(.is-lens) { background-color: color-mix(in srgb, var(--paper) 78%, transparent); }
  /* Firefox and Safari: the WebGL glass steps aside for the same paper band. */
  .nav.is-over.has-liquid { background: color-mix(in srgb, var(--paper) 78%, transparent) !important; -webkit-backdrop-filter: blur(24px) !important; backdrop-filter: blur(24px) !important; }
  .nav.is-over .lg-canvas { opacity: 0; }
  .nav.is-dark.is-over.has-liquid { background: color-mix(in srgb, var(--paper-2) 82%, transparent) !important; }
  .nav__mark { font-family: var(--display); font-size: 24px; letter-spacing: -0.02em; text-decoration: none; }
  .nav__links { list-style: none; display: flex; gap: 2px; margin: 0; padding: 0; }
  .nav__menu { display: none; }

  /* Opening: the quiet etching fills the screen, the plate centred over the trees and sky. */
  .hero { position: relative; min-height: 100svh; padding: 116px var(--margin) 40px; display: grid; grid-template-rows: 1fr auto; }
  .hero__plate { position: relative; align-self: center; justify-self: center; width: min(680px, 50vw); padding: 44px 44px 40px; display: grid; gap: 22px; border-radius: 28px; }
  .hero__h { font-family: var(--display); font-weight: 500; font-size: clamp(34px, 2.8vw, 40px); line-height: 1.06; letter-spacing: -0.02em; text-wrap: balance; }
  .hero__p { font-size: 18px; line-height: 1.5; }
  .hero__plate .avail { --fill: color-mix(in srgb, var(--paper) 55%, transparent); }
  /* Trusted By: the label sits right against the names (Josh, 28 Oct). */
  /* Trusted By: one line of glass, the label running straight into the names (Josh, 28 Oct: tighter).
     Glass because the painting now carries on behind it. */
  .trusted { position: relative; justify-self: center; width: min(1140px, 100%); margin-top: 32px; padding: 15px 24px; border-radius: 28px; font-size: 18px; line-height: 1.5; text-wrap: balance; }
  .trusted b { font-weight: 600; margin-right: 0.3em; }

  /* The field: one painting held behind the opening, stats, featured work and services. It stays put
     while the page scrolls over it, so it extends rather than repeating, and fades to paper only at the foot. */
  .field { position: relative; isolation: isolate; padding-bottom: 240px; }
  .field__track { position: absolute; inset: 0; z-index: -2; } /* keeps the sticky art inside the field */
  .field__art { position: sticky; top: 0; height: 100svh; overflow: hidden; }
  .hero__art { width: 100%; height: 100%; object-fit: cover; object-position: 50% 12%; }
  .field::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; z-index: -1; height: 280px; pointer-events: none; background: linear-gradient(transparent, var(--paper) 80%); }

  /* One centred column for everything under the opening (Josh, 28 Oct: "centred to the page").
     Headings stay left-aligned inside it. 1140px lets both rows of work fit one screen at 1440. */
  .field > section { box-sizing: content-box; max-width: 1140px; margin-inline: auto; }

  /* Stats: four glass cards, a large number over a short label. */
  .stats { padding-top: 120px; }
  .stats__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
  .stat { position: relative; display: grid; align-content: space-between; gap: 28px; min-height: 196px; padding: 28px 28px 26px; border-radius: 28px; }
  /* One setting for every figure: the same tracking, the unit set tight, the plus given a little air (Josh, 28 Oct). */
  .stat__n { font-family: var(--display); font-weight: 500; font-size: clamp(56px, 5vw, 76px); line-height: 0.9; letter-spacing: -0.01em; font-variant-numeric: lining-nums proportional-nums; white-space: nowrap; }
  .stat__unit { margin-left: 0.02em; }
  .stat__plus { margin-left: 0.08em; }
  .stat__l { font-size: 18px; line-height: 1.35; font-weight: 500; text-wrap: balance; }

  /* Featured work: heading, the filter bar, then compact cards two to a row, all the same shape. */
