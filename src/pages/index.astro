---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Icon from '../components/Icon.astro';
import { settings, price } from '../lib/site.js';

import heroArt from '../assets/art/engraved/lemoyne.webp';
import workArt from '../assets/art/engraved/wedding.webp';
import nightArt from '../assets/art/engraved/lemoyne-night.webp';
import pricesArt from '../assets/art/engraved/lairesse.webp';

const featured = (await getCollection('projects', (p) => p.data.featured && !p.data.archive)).sort((a, b) => a.data.order - b.data.order);
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const clients = await getCollection('clients');
const testimonials = await getCollection('testimonials');
const order = ['alison-arnaud', 'laura-de-vos', 'mark-silverman'];
const quotes = order.map((id) => testimonials.find((t) => t.id === id)).filter(Boolean);
const from = (s: (typeof services)[number]) => Math.min(...s.data.tiers.filter((t) => t.price).map((t) => t.price as number));

const answers = [
  { q: 'What will it cost?', a: `Brand identity from £${price(from(services[0]))}. Data visualisation from £${price(from(services[1]))}. Every project gets a fixed written quote before any work begins, so the number doesn’t move.` },
  { q: 'How long will it take?', a: 'Charts take about a week and a full report two to three. A new identity takes four to six weeks, and a rebrand with rollout eight to twelve.' },
  { q: 'Who will I actually work with?', a: 'Me. Conceptual Studio is just me, so you talk to the person doing the work, from the first call to the final file.' },
  { q: 'Do you know our sector?', a: 'Most of my clients are colleges and public institutions: strategic plans, merger consultations, learner data, and identities that end up on buses and tube platforms.' },
  { q: 'Can you work with procurement?', a: 'Yes. A formal written quote, purchase orders and invoices from a UK limited company, set out the way your finance team needs.' },
  { q: 'What do we get at the end?', a: 'Print-ready artwork, web files and guidelines, ready for your team to use. I stay on hand for rollout and the next document.' },
];
const steps = [
  ['A short call', 'Your needs, deadline and rough budget. Free.'],
  ['A fixed quote', 'Scope, timeline and price, in writing.'],
  ['First ideas', 'Early concepts. We pick a direction.'],
  ['Refine and check', 'Changes, and every number checked.'],
  ['Final files', 'Print, web and guidelines, ready to use.'],
  ['After launch', 'On hand for rollout and what’s next.'],
];
const ROMAN = ['I', 'II', 'III', 'IV', 'V', 'VI'];
---
<Base>
  <!-- Hero: an engraved ceiling, the promise, and the work in a liquid-glass viewer. -->
  <section class="hero" aria-labelledby="hero-title" data-liquid-field>
    <div class="engraving"><Image src={heroArt} alt="" widths={[1200, 1800, 2600]} sizes="100vw" loading="eager" fetchpriority="high" /></div>
    <div class="wrap hero__inner">
      <div class="hero__text">
        <p class="micro micro--gold" data-load>Conceptual Studio · Brand and data design · London</p>
        <h1 id="hero-title" data-load style="--d:80ms">Brand and data design for <em>education</em></h1>
        <p class="hero__intro" data-load style="--d:160ms">{settings.intro}</p>
        <div class="actions" data-load style="--d:240ms">
          <a class="button" href="/contact/">Start a project <Icon name="arrow" /></a>
          <a class="button button--glass" href="#prices">See prices</a>
        </div>
        <ul class="facts-row" data-load style="--d:320ms">
          <li class="glass">Fixed quotes from £{price(from(services[1]))}</li>
          <li class="glass">Replies within one working day</li>
          <li class="glass">Just me, no account managers</li>
        </ul>
      </div>

      <div class="viewer glass" data-viewer data-liquid="light" data-load style="--d:200ms">
        <div class="viewer__top">
          <span class="micro">Selected work</span>
          <span class="micro viewer__count"><span data-viewer-count>01</span> / {String(featured.length).padStart(2, '0')}</span>
          <span class="viewer__nav">
            <button class="round" type="button" data-viewer-prev aria-label="Previous project"><Icon name="prev" /></button>
            <button class="round" type="button" data-viewer-next aria-label="Next project"><Icon name="next" /></button>
          </span>
        </div>
        <div class="viewer__stage">
          {featured.map((p, i) => (
            <a class:list={['viewer__slide', i === 0 && 'is-active']} href={`/work/${p.id}/`} data-slide data-title={p.data.title} data-meta={`${p.data.client} · ${p.data.year}`} tabindex={i === 0 ? undefined : -1}>
              <Image src={p.data.cover} alt={p.data.coverAlt} widths={[600, 900, 1200]} sizes="(max-width: 900px) 92vw, 36vw" loading={i < 2 ? 'eager' : 'lazy'} />
            </a>
          ))}
        </div>
        <div class="viewer__bar" aria-hidden="true">{featured.map((_, i) => <span class:list={[i === 0 && 'is-active']}></span>)}</div>
        <div class="viewer__foot">
          <span class="viewer__caption"><span class="viewer__title" data-viewer-title>{featured[0].data.title}</span><span class="small muted" data-viewer-meta>{featured[0].data.client} · {featured[0].data.year}</span></span>
          <a class="pill" href={`/work/${featured[0].id}/`} data-viewer-link>View <Icon name="arrow" /></a>
        </div>
      </div>
    </div>

    <div class="wrap">
      <div class="marquee">
        <span class="micro">Trusted by</span>
        <div class="marquee__track">
          <ul class="marquee__list" role="list">
            {[0, 1].map((n) => clients.map((c) => <li aria-hidden={n === 1 ? 'true' : undefined}>{c.data.name}</li>))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Selected work: glass cards over an engraved chinoiserie. -->
  <section class="section work-field" aria-labelledby="work-title">
    <div class="engraving"><Image src={workArt} alt="" widths={[1200, 1800, 2400]} sizes="100vw" /></div>
    <div class="wrap">
      <div class="head">
        <p class="micro micro--gold head__label">01 — Selected work</p>
        <h2 id="work-title">The work</h2>
        <p class="head__aside muted">Identities, reports, maps and films. Most of it for colleges and public institutions.</p>
      </div>
      <ul class="cards" role="list">
        {featured.map((p, i) => <li><ProjectCard project={p} index={i} sizes="(max-width: 900px) 100vw, 46vw" /></li>)}
      </ul>
      <p class="more"><a class="button button--glass" href="/work/">All projects <Icon name="arrow" /></a></p>
    </div>
  </section>

  <!-- Straight answers to what people worry about with studios. -->
  <section class="section answers is-dark" aria-labelledby="answers-title">
    <div class="engraving"><Image src={nightArt} alt="" widths={[1200, 1800, 2600]} sizes="100vw" /></div>
    <div class="wrap">
      <div class="head">
        <p class="micro micro--gold head__label">02 — Before you ask</p>
        <h2 id="answers-title">Straight answers</h2>
        <p class="head__aside muted">The things people worry about when they hire a studio, answered up front.</p>
      </div>
      <ul class="answers__grid" role="list">
        {answers.map((x, i) => (
          <li class="answer glass" data-tone="dark">
            <span class="micro micro--gold">Q.{String(i + 1).padStart(2, '0')}</span>
            <h3>{x.q}</h3>
            <p>{x.a}</p>
          </li>
        ))}
      </ul>
      <ol class="steps" role="list" aria-label="How a project runs">
        {steps.map(([t, d], i) => <li><span class="micro">{ROMAN[i]}</span><h3>{t}</h3><p>{d}</p></li>)}
      </ol>
    </div>
  </section>

  <!-- Prices, up front. -->
  <section class="section prices" id="prices" aria-labelledby="prices-title">
    <div class="engraving"><Image src={pricesArt} alt="" widths={[800, 1400]} sizes="55vw" /></div>
    <div class="wrap">
      <div class="head">
        <p class="micro micro--gold head__label">03 — Services and prices</p>
        <h2 id="prices-title">Two services, priced up front</h2>
        <p class="head__aside muted">{settings.pricesNote}</p>
      </div>
      <div class="price-cards">
        {services.map((s, i) => (
          <article class="price-card glass">
            <div class="price-card__top"><span class="micro micro--gold">Service {String(i + 1).padStart(2, '0')}</span><span class="micro muted">From £{price(from(s))}</span></div>
            <h3>{s.data.title}</h3>
            <p class="muted">{s.data.short}</p>
            <ul class="tiers" role="list">
              {s.data.tiers.map((t) => (
                <li>
                  <span class="tier__name">{t.name}</span>
                  <span class="tier__price">{t.price ? <><small>From</small>£{price(t.price)}</> : 'Quote'}</span>
                  <span class="tier__time">{t.timeline ?? 'Scoped with you'}</span>
                </li>
              ))}
            </ul>
            <div class="actions">
              <a class="button" href={`/contact/?service=${encodeURIComponent(s.data.title)}`}>Ask for a quote</a>
              <a class="button button--glass" href={`/services/${s.id}/`}>What’s included <Icon name="arrow" /></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- In their words. -->
  <section class="section" aria-labelledby="quotes-title" style="padding-top: 0">
    <div class="wrap">
      <div class="head">
        <p class="micro micro--gold head__label">04 — In their words</p>
        <h2 id="quotes-title">What clients say</h2>
      </div>
      <div class="quotes__grid">
        {quotes.map((t, i) => (
          <figure class="quote glass">
            <span class="quote__mark" aria-hidden="true">“</span>
            <blockquote><p>{i === 0 ? t!.data.excerpt ?? t!.data.quote : t!.data.quote}</p></blockquote>
            <figcaption>{t!.data.name}<span>{t!.data.role}, {t!.data.organisation}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
</Base>
