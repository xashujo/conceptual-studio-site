---
// Home (brief 6.1), built on the chosen direction: Prototype A, the quiet etching (DECISIONS, 26 Oct).
// Pass 1 of 2 (Josh, 28 Oct): sticky nav, stats, filtered compact work grid, services accordion,
// all in the shared glass, over the etching carried down behind them.
import Tune from '../components/Tune.astro';
import { glassStyle } from '../lib/site';
import '../styles/tokens.css';
import '../styles/components.css';
import { Image } from 'astro:assets';
import { email, startHref, quoteHref, sentence, trustedBy } from '../data/site';
import { availability, homeQuote, responseTime } from '../lib/site';
import { featured, projectHref, homeFilters, bySlug } from '../data/work';
import { services } from '../data/services';
import heroArt from '../assets/art/engraved/jardin-quiet.jpg';
import workArt from '../assets/art/engraved/hunt-hills-gold.jpg'; // La Chasse Chinoise, Huquier after Boucher, The Met 53.600.1009, public domain
import closeArt from '../assets/art/engraved/lemoyne-night.jpg';

const headline = 'Brands & Data, Made Clear'; // option 3 (Josh, 26 Oct)
const links = [['Work', '#work'], ['Services', '#services'], ['About', '#about'], ['Contact', '#contact']];

// Title Case for headings, buttons and labels (Josh, 28 Oct): every word capitalised except the small
// ones, never the first or last; "and" becomes "&". Capitals already there (KUT) are kept.
const small = new Set(['a', 'an', 'the', 'of', 'to', 'in', 'on', 'for', 'at', 'by', 'or', 'but', 'with', 'as']);
const titleCase = (s: string) => s.replace(/\band\b/gi, '&').split(' ')
  .map((w, i, all) => (i > 0 && i < all.length - 1 && small.has(w.toLowerCase()) ? w.toLowerCase() : w.charAt(0).toUpperCase() + w.slice(1)))
  .join(' ');

// Placeholder figures from Josh's brief (28 Oct), not yet confirmed. Replace each before launch.
const stats = [
  { n: 50, after: '+', label: 'Projects Delivered' }, // CONFIRM
  { n: 1, after: 'M+', label: 'Data Points Visualised' }, // CONFIRM
  { n: 48, after: 'hr', label: 'First-Concept Turnaround' }, // CONFIRM
  { n: 90, after: '%', label: 'of Clients Return for More Work' }, // CONFIRM
];

// Featured work and the services come from Pages CMS (Projects and Services).
// The first four by home page position show; any more wait behind "Show More".
const SHOWN = 4;
const cards = featured.map((p) => ({
  title: p.title, year: p.year, href: projectHref(p), image: p.image, alt: p.alt,
  position: p.homePosition ?? p.position, filter: p.homeFilter, student: p.student,
}));
// Why clients choose us (pass 2): the two case studies' own summaries from the CMS, beside the quote.
const results = ['oxford-school-of-english', 'new-city-college-strategic-intent'].map(bySlug)
  .map((p) => ({ client: p.client, title: p.title, line: p.summary, href: projectHref(p) }));
// How we work (pass 2, "we" voice).
const steps = [
  ['Call & Brief', 'We talk through what you need, your budget, the formats and what the work has to achieve, so you know exactly what to expect before we start.'],
  ['Design & Feedback', 'We share work in progress and refine it with you, so nothing in the final round comes as a surprise.'],
  ['Revisions & Finishing', 'We make your changes and finish every detail before anything is signed off.'],
  ['Handover', 'You get the final files in the formats your team needs, delivered however suits you.'],
];
// About: three working principles, each resting on something the site already promises.
const values = [
  ['Clarity First', 'If a chart or a page needs explaining, it isn\'t finished yet.'],
  ['Made to Be Used', 'Files and guidelines your own team can work from, without coming back to us every time.'],
  ['Straight Answers', `A fixed quote after our first call, and a reply ${responseTime}.`],
];
const menu = services.map((s) => ({ id: s.id, name: titleCase(s.name), price: s.home.price, time: s.home.time, href: s.href ?? '/services/', link: titleCase(s.home.link), text: s.line }));
---
<!doctype html>
<html lang="en-GB" style={glassStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Conceptual Studio: brand identity and data visualisation, London</title>
    <meta name="description" content={sentence} />
    <link rel="preload" href="/fonts/agatho-medium-subset.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-4-variable.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <!-- Sticky glass nav. It turns light over the night chapters (script below). -->
    <nav class="nav glass" aria-label="Main" data-nav>
      <a class="nav__mark" href="/">Conceptual Studio</a>
      <ul class="nav__links">
        <li><a class="glass-pill" href="#top" aria-current="true">Home</a></li>
        {links.map(([l, h]) => <li><a class="glass-pill" href={h}>{l}</a></li>)}
      </ul>
      <button class="nav__menu glass-pill" type="button" popovertarget="site-menu">Menu</button>
    </nav>
    <!-- Phone menu: a glass sheet under the nav (Josh, 28 Oct). A native popover, so Escape and tapping outside close it. -->
    <div class="menu glass" id="site-menu" popover>
      <ul>
        <li><a class="glass-pill" href="#top">Home</a></li>
        {links.map(([l, h]) => <li><a class="glass-pill" href={h}>{l}</a></li>)}
      </ul>
    </div>
    <main>
      <!-- Opening: the etching fills the screen; the hero plate is glass over it. -->
      <header class="hero" id="top">
        <Image class="hero__art" src={heroArt} alt="" widths={[640, 1024, 1600, 2400]} sizes="100vw" loading="eager" fetchpriority="high" />
        <div class="hero__plate glass" data-lens>
          <h1 class="hero__h">{headline}</h1>
          <p class="hero__p">{sentence}</p>
          <div class="acts">
            <a class="btn btn--solid" href={startHref}><span class="swap"><span>Start a Project</span><span aria-hidden="true">Contact Us ↗</span></span></a>
            {availability.on && <a class="avail" href={`mailto:${email}`}><span class="avail__dot" aria-hidden="true"></span><span class="swap"><span>{titleCase(availability.text)}</span><span aria-hidden="true">↗ Email Us</span></span></a>}
            <a class="btn glass-button" href="#work">See the Work</a>
          </div>
        </div>
        {trustedBy.length > 0 && (
          <div class="hero__with">
            <p class="hero__with-h">Trusted By</p>
            <p class="hero__names">{trustedBy.join(', ')} &amp; More</p>
          </div>
        )}
      </header>

      <!-- Art behind the glass, so every pane has something to bend (Josh, 28 Oct). Two bands that scroll with
           the page, each its own etching (pass 2, Josh: the held image made the page feel like it wasn't moving). -->
      <div class="field">
        <div class="band">
        <div class="band__art" aria-hidden="true"><Image src={workArt} alt="" widths={[800, 1600]} sizes="100vw" /></div>

        <section class="stats wrap" aria-label="The studio in numbers">
          <ul class="stats__list">
            {stats.map((s) => (
              <li class="stat glass" data-lens>
                <p class="stat__n"><span aria-hidden="true"><span data-count={s.n}>{s.n}</span>{s.after}</span><span class="sr-only">{s.n}{s.after}</span></p>
                <p class="stat__l">{s.label}</p>
              </li>
            ))}
          </ul>
        </section>

        <section class="fw wrap" id="work" aria-labelledby="fw-h">
          <h2 class="fw__h big" id="fw-h">Featured Work</h2>
          <div class="filterbar glass" role="group" aria-label="Filter featured work" data-lens data-filters hidden>
            <button class="glass-pill" type="button" data-filter="all" aria-pressed="true">All</button>
            {homeFilters.map((f) => <button class="glass-pill" type="button" data-filter={f} aria-pressed="false">{f}</button>)}
          </div>
          <ul class="fw__grid" data-grid>
            {cards.map((c, i) => (
              <li data-filter={c.filter ?? ''} data-more={i >= SHOWN ? '' : undefined}>
                <a class="card glass" href={c.href} data-lens>
                  <Image class="card__img" src={c.image} alt={c.alt} widths={[400, 700, 1100]} sizes="(min-width: 760px) min(580px, 47vw), calc(100vw - 32px)" style={c.position ? `object-position: ${c.position}` : undefined} />
                  <span class="card__row">
                    <span class="card__t">{c.title}</span>
                    <span class="card__tags">
                      {c.filter && <span class="tag">{c.filter}</span>}
                      {c.student && <span class="tag">Student Work</span>}
                    </span>
                    <span class="card__y">{c.year}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <p class="fw__empty" data-empty hidden>No projects under this filter yet.</p>
          <div class="fw__foot">
            <button class="btn glass-button" type="button" data-show-more hidden>Show More</button>
            <a class="link" href="/work/">All Projects<span class="arrow" aria-hidden="true">→</span></a>
          </div>
        </section>
        </div>

        <div class="band">
        <div class="band__art" aria-hidden="true"><Image src={heroArt} alt="" widths={[800, 1600, 2400]} sizes="100vw" /></div>
        <section class="services wrap" id="services" aria-labelledby="services-h">
          <h2 class="big services__h" id="services-h">Services</h2>
          <p class="services__intro">Every project is priced on its scope, so these are starting points. You'll get a fixed quote after our first call.</p>
          <!-- One open at a time. Without script every row stays open. -->
          <div class="acc glass" data-lens data-acc>
            {menu.map((s) => (
              <div class="acc__row">
                <h3 class="acc__h">
                  <button class="acc__btn" type="button" id={`svc-${s.id}-btn`} aria-controls={`svc-${s.id}`} aria-expanded="true">
                    <span>{s.name}</span><span class="acc__icon" aria-hidden="true"></span>
                  </button>
                </h3>
                <div class="acc__panel" id={`svc-${s.id}`} role="region" aria-labelledby={`svc-${s.id}-btn`}>
                  <div class="acc__inner">
                    <div class="acc__body">
                      <p class="acc__text">{s.text}</p>
                      <p class="acc__price">{s.price}{s.time && <span>{s.time}</span>}</p>
                      <a class="btn glass-button acc__go" href={s.href} aria-label={s.link}>View Prices <span class="arrow" aria-hidden="true">→</span></a>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
          <div class="quote glass" data-lens>
            <h3 class="quote__h">Need Something Else?</h3>
            <p class="quote__p">A mix of these, or something we haven't listed? Tell us what you need and we'll send a fixed quote {responseTime}.</p>
            <a class="btn glass-button" href={quoteHref}>Ask for a Custom Quote <span class="arrow" aria-hidden="true">→</span></a>
          </div>
        </section>

        <!-- Why clients choose us (pass 2): one client's words in the large pane, two results stacked beside it.
             Inside the field so the glass has the etching behind it. -->
        <section class="proof wrap" aria-labelledby="proof-h">
          <h2 class="big proof__h" id="proof-h">Why Clients Choose Us</h2>
          <div class="proof__grid">
            {homeQuote && (
              <figure class="proof__quote glass" data-lens>
                <blockquote><p>“{homeQuote.quote}”</p></blockquote>
                <figcaption><b>{homeQuote.name}</b>{homeQuote.role}, {homeQuote.organisation}</figcaption>
              </figure>
            )}
            {results.map((r) => (
              <a class="result glass" href={r.href} data-lens>
                <span class="result__who">{r.client}</span>
                <span class="result__line">{r.line}</span>
                <span class="result__go">Read the Case Study <span class="arrow" aria-hidden="true">→</span></span>
              </a>
            ))}
          </div>
          <a class="btn glass-button proof__go" href={startHref}>Start a Project <span class="arrow" aria-hidden="true">→</span></a>
        </section>
        </div>
      </div>

      <!-- How we work: a real ordered list, the order carried by position, not numerals. -->
      <section class="how wrap" aria-labelledby="how-h">
        <div class="how__head">
          <h2 class="big how__h" id="how-h">How We Work</h2>
          <p>How a project runs, from the first call to the files you keep.</p>
        </div>
        <ol class="how__list">
          {steps.map(([t, d]) => <li><h3 class="how__t">{t}</h3><p>{d}</p></li>)}
        </ol>
      </section>

      <!-- About (pass 2): what we do for clients, not a CV. -->
      <section class="about wrap" id="about" aria-labelledby="about-h">
        <h2 class="big about__h" id="about-h">About</h2>
        <div class="about__text">
          <p class="about__lead">We make complex ideas clear. Strategies, mergers and annual figures become charts, maps and pages that people take in at a glance and remember.</p>
          <p>We build brands that get recognised before anyone reads the name, with a system clear enough to hold together from a bus shelter poster to a student ID card.</p>
          <a class="link" href="/about/">More About the Studio<span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <ul class="about__values">
          {values.map(([t, d]) => <li><h3>{t}</h3><p>{d}</p></li>)}
        </ul>
      </section>
    </main>

    <!-- Close and footer: one night chapter to the end of the page, the garden engraving rising from the bottom. -->
    <div class="night end">
      <!-- Lemoyne's ceiling, toned gold on warm black. It now fills the close and footer to the very bottom,
           with the copyright on it (Josh's mockup, 28 Oct). -->
      <div class="close__art" aria-hidden="true"><Image src={closeArt} alt="" widths={[800, 1400, 1900]} sizes="100vw" /></div>
      <section class="close wrap" id="contact" aria-labelledby="close-h">
        <h2 class="close__h big" id="close-h">Start a Project</h2>
        <div class="close__body">
          <p class="close__p">If you're collecting quotes for a project, we'd be glad to be one of them. Send us a short note and we'll reply {responseTime}.</p>
          <div class="acts">
            <a class="btn btn--solid" href={startHref}><span class="swap"><span>Start a Project</span><span aria-hidden="true">Email Us ↗</span></span></a>
            <button class="btn" type="button" data-copy={email}><span data-label>Copy Email</span></button>
            <span class="sr-only" aria-live="polite" data-status></span>
          </div>
        </div>
      </section>
      <!-- Footer links and the garden engraving removed (Josh, 28 Oct): only the copyright stays, centred under the close. -->
      <footer class="footer"><p>© 2026 Conceptual Studio Limited</p></footer>
    </div>

        <script>
      import { mountLens } from '../scripts/lens.js';
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const ease = 'cubic-bezier(0.16, 1, 0.3, 1)';

      // Lens glass. The hero plate can use the WebGL glass over its painting in Firefox and Safari;
      // the field panes move over live content, so there they keep the clear CSS glass.
      // The nav is plain frosted glass (pass 2): bent, it smeared the page scrolling under it into streaks.
      const heroArt = document.querySelector<HTMLImageElement>('.hero__art');
      mountLens(document.querySelector('.hero__plate'), heroArt, [0.58, 0.92]);
      document.querySelectorAll<HTMLElement>('.field [data-lens]').forEach((el) => mountLens(el, null));

      // Nav: light over the night chapters, dark over paper. Watches a 1px line across the nav's middle.
      const nav = document.querySelector<HTMLElement>('[data-nav]')!;
      const nights = [...document.querySelectorAll('.night')];
      const under = new Set<Element>();
      let watch: IntersectionObserver | undefined;
      const watchNav = () => {
        watch?.disconnect(); under.clear();
        const r = nav.getBoundingClientRect();
        const y = Math.round(r.top + r.height / 2);
        watch = new IntersectionObserver((entries) => {
          entries.forEach((e) => (e.isIntersecting ? under.add(e.target) : under.delete(e.target)));
          nav.classList.toggle('is-dark', under.size > 0);
        }, { rootMargin: `-${y}px 0px -${Math.max(0, innerHeight - y - 1)}px 0px` });
        nights.forEach((n) => watch!.observe(n));
      };
      watchNav();
      addEventListener('resize', watchNav);
      // Scroll edge: true once content (past the opening's art) is under the nav.
      const field = document.querySelector<HTMLElement>('.field')!;
      const edge = () => nav.classList.toggle('is-over', field.getBoundingClientRect().top < nav.getBoundingClientRect().bottom);
      edge();
      addEventListener('scroll', edge, { passive: true });

      // Stats count up once, when they come into view. The final figure is in the page for screen readers.
      if (!still) {
        const counter = new IntersectionObserver((entries) => entries.forEach((e) => {
          if (!e.isIntersecting) return;
          counter.unobserve(e.target);
          const el = e.target as HTMLElement;
          const to = Number(el.dataset.count);
          const t0 = performance.now();
          const step = (t: number) => {
            const k = Math.min(1, (t - t0) / 1400);
            el.textContent = String(Math.round(to * (1 - (1 - k) ** 3)));
            if (k < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        }), { threshold: 0.6 });
        document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => { el.textContent = '0'; counter.observe(el); });
      }

      // Featured work filters: the grid updates in place with a short fade and scale.
      const bar = document.querySelector<HTMLElement>('[data-filters]')!;
      const grid = document.querySelector<HTMLElement>('[data-grid]')!;
      const items = [...grid.children] as HTMLElement[];
      const more = document.querySelector<HTMLButtonElement>('[data-show-more]')!;
      const empty = document.querySelector<HTMLElement>('[data-empty]')!;
      let current = 'all';
      let all = false;
      const show = () => {
        const match = items.filter((li) => current === 'all' || li.dataset.filter === current);
        const shown = all ? match : match.slice(0, 4);
        items.forEach((li) => { li.hidden = !shown.includes(li); });
        more.hidden = all || match.length <= 4;
        empty.hidden = match.length > 0;
      };
      const swap = async () => {
        if (still) return show();
        await grid.animate([{ opacity: 1 }, { opacity: 0, transform: 'scale(0.98)' }], { duration: 140, easing: 'ease-in' }).finished;
        show();
        grid.animate([{ opacity: 0, transform: 'scale(0.98)' }, { opacity: 1, transform: 'none' }], { duration: 320, easing: ease });
      };
      bar.hidden = false;
      bar.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
        if (!btn || btn.dataset.filter === current) return;
        current = btn.dataset.filter!;
        all = false;
        bar.querySelectorAll('[data-filter]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        swap();
      });
      more.addEventListener('click', () => { all = true; show(); });
      show();

      // Services accordion: one row open at a time; closed rows are inert so focus skips them.
      const rows = [...document.querySelectorAll<HTMLElement>('[data-acc] .acc__row')];
      const setRow = (row: HTMLElement, open: boolean) => {
        row.querySelector('.acc__btn')!.setAttribute('aria-expanded', String(open));
        const panel = row.querySelector<HTMLElement>('.acc__panel')!;
        panel.toggleAttribute('data-closed', !open);
        panel.inert = !open;
      };
      rows.forEach((row, i) => {
        setRow(row, i === 0);
        row.querySelector('.acc__btn')!.addEventListener('click', () => {
          const open = row.querySelector('.acc__btn')!.getAttribute('aria-expanded') !== 'true';
          rows.forEach((r) => setRow(r, r === row && open));
        });
      });

      // Copy email: the label confirms, a polite live region announces it, then it reverts.
      const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
      const label = btn?.querySelector<HTMLElement>('[data-label]');
      const status = document.querySelector<HTMLElement>('[data-status]');
      btn?.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(btn.dataset.copy!); } catch { location.href = `mailto:${btn.dataset.copy}`; return; }
        label!.textContent = 'Copied'; status!.textContent = 'Email address copied';
        setTimeout(() => { label!.textContent = 'Copy Email'; status!.textContent = ''; }, 1550);
      });

      // Phone menu: a link closes the sheet as it jumps to its section.
      const menu = document.querySelector<HTMLElement>('#site-menu')!;
      menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) menu.hidePopover(); });

      // The nav's current pill follows the section in view (Josh, 28 Oct: it stayed on Home all the way down).
      const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('.nav__links a')];
      const sections = navLinks.map((a) => document.querySelector<HTMLElement>(a.hash)).filter(Boolean) as HTMLElement[];
      const spy = () => {
        const line = innerHeight * 0.35;
        const current = sections.filter((s) => s.getBoundingClientRect().top <= line).pop() ?? sections[0];
        navLinks.forEach((a) => (a.hash === `#${current.id}` ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
      };
      spy();
      addEventListener('scroll', spy, { passive: true });
    </script>
    <Tune />
  </body>
</html>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .big { font-family: var(--display); font-weight: 500; letter-spacing: -0.03em; line-height: 0.92; }
  .acts { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 14px; }
  [id] { scroll-margin-top: 96px; } /* anchors land below the sticky nav */

  /* Nav: sticky glass for the whole page (Josh, 28 Oct; replaces "scrolls away with the opening").
     It sits at the top, and .is-dark turns it light over the night chapters. */
  .nav { position: fixed; z-index: 50; top: 14px; left: var(--margin); right: var(--margin); height: 60px; border-radius: 28px; display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 0 8px 0 24px; transition: color 300ms ease-out, background-color 300ms ease-out, box-shadow 300ms ease-out; }
  .nav::before { transition: background-color 300ms ease-out; }
  /* Scroll edge (TASTE glass spec, iOS 27): once the page passes under the nav, paper fills in behind it so the
     labels never sit on bent text or busy photos. Over the opening it stays clear. */
  .nav.is-over { background-color: color-mix(in srgb, #F1DFC8 80%, transparent); }
  /* Over the night chapters: set outright, so every browser turns dark (Firefox kept it cream, with cream text). */
  .nav.is-dark, .nav.is-over.is-dark { background-color: rgb(34 29 23 / 0.8); color: #F1DFC8; }
  .nav__mark { font-family: var(--display); font-size: 24px; letter-spacing: -0.02em; text-decoration: none; }
  .nav__links { list-style: none; display: flex; gap: 2px; margin: 0; padding: 0; }
  .nav__menu { display: none; }

  /* Opening: the quiet etching fills the screen, the plate centred over the trees and sky. */
  .hero { position: relative; isolation: isolate; min-height: 100svh; padding: 116px var(--margin) 40px; display: grid; grid-template-rows: 1fr auto; }
  .hero__art { position: absolute; inset: 0; z-index: -1; width: 100%; height: 100%; object-fit: cover; object-position: 50% 12%; -webkit-mask-image: linear-gradient(to bottom, #000 58%, transparent 92%); mask-image: linear-gradient(to bottom, #000 58%, transparent 92%); } /* taste-skill-ignore: art fade into the page (DECISIONS) */
  .hero__plate { position: relative; align-self: center; justify-self: center; width: min(680px, 50vw); padding: 44px 44px 40px; display: grid; gap: 22px; border-radius: 28px; }
  .hero__h { font-family: var(--display); font-weight: 500; font-size: clamp(34px, 2.8vw, 40px); line-height: 1.06; letter-spacing: -0.02em; text-wrap: balance; }
  .hero__p { font-size: 18px; line-height: 1.5; }
  .hero__plate .avail { --fill: color-mix(in srgb, var(--paper) 55%, transparent); }
  /* Trusted By: the label sits right against the names (Josh, 28 Oct). */
  .hero__with { justify-self: center; width: min(1140px, 100%); display: flex; flex-wrap: wrap; column-gap: 12px; align-items: baseline; padding-top: 32px; font-size: 18px; line-height: 1.5; }
  .hero__with-h { font-weight: 600; white-space: nowrap; }
  .hero__names { text-wrap: balance; }

  /* The field: an etching behind each band of glass, scrolling with it. Each fades in at the top and out at
