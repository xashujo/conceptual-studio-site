---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import LiveChart from '../components/LiveChart.astro';
import { settings, price } from '../lib/site.js';

const featured = (await getCollection('projects', (p) => p.data.featured && !p.data.archive)).sort((a, b) => a.data.order - b.data.order);
// The reel opens on the identity seen in the street, then the data work.
const lead = featured.findIndex((p) => p.id === 'oxford-school-of-english');
if (lead > 0) featured.unshift(...featured.splice(lead, 1));
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const clients = await getCollection('clients');
const testimonials = await getCollection('testimonials');
const main = testimonials.find((t) => t.id === 'alison-arnaud');
const others = testimonials.filter((t) => t.id !== 'alison-arnaud');
const from = (s: (typeof services)[number]) => Math.min(...s.data.tiers.filter((t) => t.price).map((t) => t.price as number));

const answers = [
  { q: 'What will it cost?', a: `Brand identity from £${price(from(services[0]))}, data visualisation from £${price(from(services[1]))}. Every project gets a fixed written quote before any work begins, so the number doesn’t move.` },
  { q: 'How long will it take?', a: 'Charts take about a week and a full report two to three. A new identity takes four to six weeks, and a rebrand with rollout eight to twelve.' },
  { q: 'Who will I work with?', a: 'Me. Conceptual Studio is just me, so you talk to the person doing the work, from the first call to the final file.' },
  { q: 'Do you know our sector?', a: 'Most of my clients are colleges and public institutions: strategic plans, merger consultations, learner data, and identities that end up on buses and tube platforms.' },
  { q: 'Can you work with procurement?', a: 'Yes. A formal written quote, purchase orders and invoices from a UK limited company, set out the way your finance team needs.' },
  { q: 'What do we get at the end?', a: 'Print-ready artwork, web files and guidelines, ready for your team to use. I stay on hand for rollout and the next document.' },
];
---
<Base>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero__top">
      <h1 id="hero-title" data-load>{settings.headline}.</h1>
      <div class="hero__side" data-load style="--d:120ms">
        <p>{settings.intro}</p>
        <div class="actions">
          <a class="button" href="/contact/">Start a project</a>
          <a class="more-link" href="#prices">See prices <Icon name="arrow" /></a>
        </div>
      </div>
    </div>

    <div class="reel" data-reel data-load style="--d:220ms">
      <ul class="reel__track" role="list" data-reel-track aria-label="Selected work">
        {featured.map((p, i) => (
          <li class="reel__item">
            <a href={`/work/${p.id}/`}>
              <span class="reel__frame"><Image src={p.data.cover} alt={p.data.coverAlt} widths={[700, 1100, 1600, 2200]} sizes="(max-width: 900px) 86vw, min(82vw, 1060px)" loading={i < 2 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} style={`view-transition-name: cover-${p.id}`} /></span>
              <span class="reel__caption">
                <span><h3>{p.data.title}</h3><p>{p.data.client}, {p.data.year}</p></span>
                <span class="more-link">View project <Icon name="arrow" /></span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <div class="wrap reel__controls">
        <div class="reel__dots" aria-hidden="true">{featured.map((_, i) => <span class:list={[i === 0 && 'is-active']}></span>)}</div>
        <div class="reel__pad glass">
          <button class="round" type="button" data-reel-prev aria-label="Previous project" disabled><Icon name="prev" /></button>
          <button class="round" type="button" data-reel-next aria-label="Next project"><Icon name="next" /></button>
        </div>
      </div>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="clients-title">
    <div class="clients">
      <h2 id="clients-title">Trusted by colleges, companies and artists</h2>
      <ul role="list">{clients.map((c) => <li data-reveal>{c.data.name}</li>)}</ul>
    </div>
  </section>

  <section class="section wrap" id="prices" aria-labelledby="services-title">
    <div class="intro">
      <h2 id="services-title" data-reveal>Two services, priced up front.</h2>
      <p data-reveal>{settings.pricesNote}</p>
    </div>
    <div class="bento">
      {services.map((s) => (
        <article class="tile tile--service" data-reveal>
          <div class="tile__pic"><Image src={s.data.image} alt={s.data.imageAlt} widths={[700, 1100, 1500]} sizes="(max-width: 1000px) 100vw, 50vw" /></div>
          <h3>{s.data.title}</h3>
          <p class="secondary">{s.data.short}</p>
          <ul class="tiers" role="list">
            {s.data.tiers.map((t) => (
              <li><span class="tier__name">{t.name}</span><span class="tier__price">{t.price ? <><small>from</small>£{price(t.price)}</> : 'Quote'}</span><span class="tier__time">{t.timeline ?? 'Scoped with you'}</span></li>
            ))}
          </ul>
          <div class="actions">
            <a class="button" href={`/contact/?service=${encodeURIComponent(s.data.title)}`}>Ask for a quote</a>
            <a class="more-link" href={`/services/${s.id}/`}>What’s included <Icon name="arrow" /></a>
          </div>
        </article>
      ))}
      <div class="tile tile--live" data-reveal><LiveChart /></div>
      <div class="tile tile--quote" data-reveal>
        <p>A fixed written quote before any work begins.</p>
        <p class="secondary">After a short call you get the scope, timeline and price in writing, set out for procurement if you need it.</p>
        <div><a class="button button--paper" href="/contact/">Book the call</a></div>
      </div>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="answers-title">
    <div class="intro">
      <h2 id="answers-title" data-reveal>Straight answers.</h2>
      <p data-reveal>What people want to know before they hire a studio.</p>
    </div>
    <ul class="answers" role="list">{answers.map((x) => <li data-reveal><h3>{x.q}</h3><p>{x.a}</p></li>)}</ul>
  </section>

  <section class="section wrap" aria-labelledby="words-title">
    <div class="intro"><h2 id="words-title" data-reveal>What clients say.</h2></div>
    <div class="words">
      {main && (
        <figure class="words__main" data-reveal>
          <blockquote><p>“{main.data.excerpt ?? main.data.quote}”</p></blockquote>
          <figcaption>{main.data.name}<span>{main.data.role}, {main.data.organisation}</span></figcaption>
        </figure>
      )}
      <div class="words__side">
        {others.map((t) => (
          <figure data-reveal>
            <blockquote><p>“{t.data.quote}”</p></blockquote>
            <figcaption>{t.data.name}<span>{t.data.role}, {t.data.organisation}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
</Base>
