---
// Prototype C, "Live chart": the offer on the left; on the right a real, credited FE
// dataset as a table that turns into a gold-line chart when tapped.
import Proto from '../../components/prototypes/Proto.astro';
import Actions from '../../components/prototypes/Actions.astro';
import { headline, sentence, clientLine } from '../../components/prototypes/home';

// Adult (19+) government-funded FE and skills participation, England, including apprenticeships.
// Each year as first published in its own DfE release (2019/20 is the comparison in the 2020/21 release).
const rows = [
  { year: '2019/20', n: 1745800 },
  { year: '2020/21', n: 1640300 },
  { year: '2021/22', n: 1719600 },
  { year: '2022/23', n: 1818480 },
  { year: '2023/24', n: 1830650 },
  { year: '2024/25', n: 1798970 },
];
const fmt = (n: number) => n.toLocaleString('en-GB');
const millions = (n: number) => `${(n / 1e6).toFixed(2)}m`;

// Chart geometry. Not zero-based: a line chart of change, with the range stated on the axis.
const W = 640, H = 330, L = 56, R = 24, T = 28, B = 44;
const lo = 1.6e6, hi = 1.9e6;
const x = (i: number) => L + (i * (W - L - R)) / (rows.length - 1);
const y = (n: number) => T + ((hi - n) * (H - T - B)) / (hi - lo);
const path = rows.map((r, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)} ${y(r.n).toFixed(1)}`).join(' ');
const ticks = [1.6e6, 1.7e6, 1.8e6, 1.9e6];
const labelled = new Set([0, 1, rows.length - 1]); // start, the low, now
---
<Proto title="Prototype C: Live chart">
  <main class="c wrap">
    <header class="c__offer">
      <h1 class="c__h">{headline}</h1>
      <p class="c__p">{sentence}</p>
      <Actions />
      <p class="c__clients"><span>Clients include</span> {clientLine}.</p>
    </header>

    <figure class="c__fig" data-view="table">
      <div class="c__head">
        <h2 class="c__title" id="c-title">Adults in government-funded further education, England</h2>
        <button class="btn c__toggle" type="button" aria-pressed="false" aria-controls="c-body">
          <span data-label>Show as a chart</span><span class="arrow" aria-hidden="true">→</span>
        </button>
      </div>
      <div class="c__body" id="c-body">
        <table class="c__table" aria-labelledby="c-title">
          <thead><tr><th scope="col">Academic year</th><th scope="col">Learners aged 19 and over</th></tr></thead>
          <tbody>
            {rows.map((r) => <tr><th scope="row">{r.year}</th><td>{fmt(r.n)}</td></tr>)}
          </tbody>
        </table>
        <svg class="c__chart" viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="c-title c-find">
          {ticks.map((t) => (
            <g class="c__tick">
              <line x1={L} x2={W - R} y1={y(t)} y2={y(t)} />
              <text x={L - 10} y={y(t) + 4} text-anchor="end">{(t / 1e6).toFixed(1)}m</text>
            </g>
          ))}
          {rows.map((r, i) => <text class="c__x" x={x(i)} y={H - 14} text-anchor="middle"><tspan class="c__long">{r.year}</tspan><tspan class="c__short">{r.year.slice(2)}</tspan></text>)}
          <path class="c__line" d={path} pathLength="1" />
          {rows.map((r, i) => (
            <g class:list={['c__pt', { 'is-labelled': labelled.has(i) }]} tabindex="0">
              <circle class="c__hit" cx={x(i)} cy={y(r.n)} r="18" />
              <circle class="c__dot" cx={x(i)} cy={y(r.n)} r="5" />
              <text x={x(i)} y={y(r.n) + (i === 1 ? 26 : -14)} text-anchor={i === rows.length - 1 ? 'end' : i === 0 ? 'start' : 'middle'}>{millions(r.n)}</text>
              <title>{r.year}: {fmt(r.n)} learners</title>
            </g>
          ))}
        </svg>
      </div>
      <p class="c__find" id="c-find">Participation fell to 1.64 million in the first Covid year, 2020/21, and has been back at about 1.8 million since 2022/23.</p>
      <figcaption class="plate">
        <b>Further education and skills, Department for Education, 2020/21 to 2024/25</b>
        <span>(Explore education statistics. Each year as first published, apprenticeships included)</span>
      </figcaption>
    </figure>
  </main>
</Proto>

<script>
  const fig = document.querySelector<HTMLElement>('.c__fig')!;
  const btn = fig.querySelector<HTMLButtonElement>('.c__toggle')!;
  const label = btn.querySelector<HTMLElement>('[data-label]')!;
  btn.addEventListener('click', () => {
    const chart = fig.dataset.view === 'table';
    fig.dataset.view = chart ? 'chart' : 'table';
    btn.setAttribute('aria-pressed', String(chart));
    label.textContent = chart ? 'Show as a table' : 'Show as a chart';
  });
</script>

<style>
  .c { min-height: 100svh; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 24px; align-items: center; padding-block: 56px; }
  .c__offer { grid-column: 1 / span 6; display: grid; gap: 22px; align-content: center; }
  .c__h { font-family: var(--display); font-weight: 500; font-size: clamp(36px, 3.2vw, 46px); line-height: 1.04; letter-spacing: -0.025em; text-wrap: balance; }
  .c__p { font-size: 18px; line-height: 1.5; max-width: 44ch; }
  .c__clients { font-size: 16px; line-height: 1.5; color: var(--ink-2); max-width: 46ch; }
  .c__clients span { color: var(--ink); font-weight: 500; }

  /* The figure: a tone step, not a box (paper 2), with the image-corner radius. */
  .c__fig { grid-column: 8 / -1; background: var(--paper-2); border-radius: 25px; padding: 28px 28px 22px; display: grid; gap: 18px; }
  .c__head { display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .c__title { font-size: 20px; line-height: 1.3; font-weight: 600; letter-spacing: -0.01em; max-width: 26ch; }
  .c__toggle { --fill: var(--paper); --fill-hover: color-mix(in srgb, var(--ink) 6%, var(--paper)); flex: none; font-size: 16px; min-height: 44px; }
  .c__body { display: grid; min-height: 340px; }
  .c__body > * { grid-area: 1 / 1; transition: opacity 300ms ease-out; }

  /* A real table, so it keeps its rows (house rules allow lines in tables). */
  .c__table { width: 100%; border-collapse: collapse; font-size: 18px; font-variant-numeric: tabular-nums; align-self: start; }
  .c__table th, .c__table td { text-align: left; padding: 11px 0; border-bottom: 1px solid color-mix(in srgb, var(--ink) 18%, transparent); font-weight: 400; }
  .c__table thead th { font-size: 14px; color: var(--ink-2); padding-top: 0; border-bottom-color: var(--ink); }
  .c__table td { text-align: right; }
  .c__table tbody tr:last-child > * { border-bottom: 0; font-weight: 600; }

  .c__chart { width: 100%; height: auto; overflow: visible; font: 500 14px/1 var(--text); }
  .c__tick line { stroke: color-mix(in srgb, var(--ink) 14%, transparent); stroke-width: 1; }
  .c__tick text, .c__x { fill: var(--ink-2); font-variant-numeric: tabular-nums; }
  .c__line { fill: none; stroke: var(--gold); stroke-width: 2.5; stroke-linejoin: round; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; }
  .c__dot { fill: var(--gold); stroke: var(--paper-2); stroke-width: 2; opacity: 0; transition: opacity 200ms ease-out 700ms; }
  .c__hit { fill: transparent; }
  .c__pt { outline: none; cursor: default; }
  .c__pt text { fill: var(--ink); font-weight: 600; font-variant-numeric: tabular-nums; opacity: 0; transition: opacity 150ms ease-out; }
  .c__pt:is(:hover, :focus-visible) .c__dot { r: 7; }
  .c__pt:is(:hover, :focus-visible) text { opacity: 1; }
  .c__find { font-size: 16px; line-height: 1.5; }
  .c__short { display: none; }

  .c__fig[data-view='table'] .c__chart, .c__fig[data-view='table'] .c__find { opacity: 0; pointer-events: none; visibility: hidden; }
  .c__fig[data-view='table'] .c__find { display: none; }
  .c__fig[data-view='chart'] .c__table { opacity: 0; pointer-events: none; visibility: hidden; }
  /* On tap the gold line draws itself once, then the points and the three labels arrive. */
  .c__fig[data-view='chart'] .c__line { stroke-dashoffset: 0; transition: stroke-dashoffset 900ms var(--ease-out) 150ms; }
  .c__fig[data-view='chart'] .c__dot { opacity: 1; }
  .c__fig[data-view='chart'] .is-labelled text { opacity: 1; transition-delay: 800ms; }

  @media (max-width: 1099.98px) {
    .c__offer { grid-column: 1 / -1; }
    .c__fig { grid-column: 1 / -1; margin-top: 48px; }
  }
  @media (max-width: 759.98px) {
    .c { padding-block: 24px 48px; align-items: start; }
    .c__offer { gap: 18px; }
    .c__h { font-size: 31px; line-height: 1.04; }
    .c__p { font-size: 17px; }
    .c__clients { font-size: 15px; }
    .c__fig { margin-top: 40px; padding: 20px 16px 18px; border-radius: 22px; }
    .c__head { flex-direction: column; align-items: flex-start; }
    .c__title { font-size: 18px; }
    .c__table { font-size: 16px; }
    .c__body { min-height: 0; }
    .c__chart { font-size: 27px; }
    .c__line { stroke-width: 4; }
    .c__chart { align-self: center; }
    .c__long { display: none; }
    .c__short { display: inline; }
  }
</style>
