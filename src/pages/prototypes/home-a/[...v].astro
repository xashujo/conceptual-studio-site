---
// Prototype A, refined (Josh, 26 Oct): a glass nav bar, a narrower plate whose edge crosses
// the palm, client names set straight on the painting outside the glass, then featured work
// with every card in its own pane of glass over the etching.
import { Image } from 'astro:assets';
import Proto from '../../../components/prototypes/Proto.astro';
import Actions from '../../../components/prototypes/Actions.astro';
import PlateCaption from '../../../components/PlateCaption.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import { sentence, clients } from '../../../components/prototypes/home';
import jardin from '../../../assets/art/engraved/jardin-gold.jpg';
import quietArt from '../../../assets/art/engraved/jardin-quiet.jpg';
import panes from '../../../assets/art/engraved/jardin-panes.jpg';
import oxford from '../../../assets/work/oxford-school-of-english/bus-shelter.webp';
import ncc from '../../../assets/work/new-city-college-strategic-intent/02.webp';
import pandora from '../../../assets/work/sherman-poon-pandora-forever/06.webp';

// Josh, 26 Oct: "&" for "and", first letter of each word capitalised. Wording still open.
const headline = 'Brands & Data, Made Clear'; // option 3 (Josh, 26 Oct)
const hunt = { title: 'Le Jardin Chinois (The Chinese Garden), after François Boucher, after 1743', medium: 'Etching and engraving by Jacques Gabriel Huquier. The Met 53.600.1008, public domain. Duotoned' };
// Three versions of the opening (Josh, 26 Oct): full strength, quieter at full size, and the art on half the screen.
export function getStaticPaths() { return [{ params: { v: undefined } }, { params: { v: 'quiet' } }, { params: { v: 'half' } }]; }
const v = (Astro.params.v ?? 'full') as 'full' | 'quiet' | 'half';
const art = v === 'quiet' ? quietArt : jardin;
const half = v === 'half';
const links = [['Work', '#work'], ['Services', '#'], ['About', '#'], ['Contact', '#']];
---
<Proto title={`Prototype A, ${v}`}>

  <main>
    <header class:list={["a", `a--${v}`]} id="a-art">
      <nav class:list={["nav", { "plate-glass": !half }]} aria-label="Main" data-liquid={half ? undefined : "a-art"} data-tone="light" data-opacity="0.52">
        <a class="nav__mark" href="/prototypes/home-a/">Conceptual Studio</a>
        <ul class="nav__links">
          <li><a href="/prototypes/home-a/" aria-current="page">[Home]</a></li>
          {links.map(([l, h]) => <li><a href={h}>{l}</a></li>)}
        </ul>
        <a class="nav__menu" href="#">Menu</a>
      </nav>
      <Image class="a__art" src={art} alt="" widths={[800, 1600, 2400]} sizes="100vw" loading="eager" />
      {half ? (
        <>
          <div class="a__left">
            <h1 class="a__h a__h--big">{headline}</h1>
            <p class="a__p">{sentence}</p>
          </div>
          <div class="a__plate plate-glass a__cta" data-liquid="a-art" data-tone="light" data-opacity="0.52">
            <p class="a__cta-h">Have a project in mind?</p>
            <Actions />
          </div>
        </>
      ) : (
      <div class="a__plate plate-glass" data-liquid="a-art" data-tone="light" data-opacity="0.52">
          <h1 class="a__h">{headline}</h1>
          <p class="a__p">{sentence}</p>
          <Actions />
        </div>
        )}
      <!-- Outside the glass: the names straight on the faded foot of the painting (TASTE 2). -->
      <div class="a__with">
        <p class="a__with-h">Worked with</p>
        <div class="a__track">
          <ul class="a__run">{clients.map((c) => <li>{c}</li>)}</ul>
          <ul class="a__run" aria-hidden="true">{clients.map((c) => <li>{c}</li>)}</ul>
        </div>
      </div>
    </header>
    <div class="wrap a__credit"><PlateCaption {...hunt} /></div>

    <section class="fw" id="work" aria-labelledby="fw-h">
      <div class="fw__art" id="fw-art" aria-hidden="true">
        <Image src={panes} alt="" widths={[800, 1600]} sizes="100vw" />
      </div>
      <header class="fw__head wrap">
        <h2 class="fw__h" id="fw-h">Featured work</h2>
        <p class="fw__p">Recent projects, each with a line on where it was used.</p>
      </header>
      <div class="fw__cards wrap">
        <ProjectCard glass="fw-art"
          title="Oxford School of English" year={2023} href="/work/oxford-school-of-english/"
          disciplines={['Visual identity', 'Branding']}
          summary="A new identity for a private English school in Oxford, now a UK-registered trademark."
          image={oxford} alt="Oxford School of English poster in a bus shelter on an Oxford street, beside a red double-decker bus"
          caption={{ title: 'Oxford School of English, 2023', medium: 'Visual identity, on a bus shelter poster' }}
          position="50% 46%" />
        <div class="fw__pair">
          <ProjectCard glass="fw-art" size="half"
            title="Strategic Intent" year={2025} href="/work/new-city-college-strategic-intent/"
            disciplines={['Data visualisation', 'Graphic design']}
            summary="Infographics for New City College's strategic intent briefing, used in its executive merger communications."
            image={ncc} alt="Black map of east London boroughs showing the colleges that merged to form New City College, with a timeline from 1990 to 2024"
            caption={{ title: 'Strategic Intent, New City College London, 2025', medium: 'Map and timeline of the college mergers, 1990 to 2024' }}
            position="0% 50%" />
          <ProjectCard glass="fw-art" size="half"
            title="Pandora Forever" year={2023} href="/work/sherman-poon-pandora-forever/"
            disciplines={['CGI', '3D animation']}
            summary="CGI worlds for Sherman Poon's music video, shown on billboards including Times Square in Hong Kong."
            image={pandora} alt="Sherman Poon waving in front of the video on the Times Square screen in Hong Kong"
            caption={{ title: 'Pandora Forever, Sherman Poon, 2023', medium: 'CGI, on the Times Square screen, Hong Kong' }}
            position="50% 42%" />
        </div>
        <p class="fw__all"><a class="link" href="/work/">All projects<span class="arrow" aria-hidden="true">→</span></a></p>
      </div>
    </section>
  </main>
</Proto>

<style>
  /* Nav: the same plate glass as the hero card, set over the painting at the top of the page; the current page in brackets (TASTE 23). */
  .nav { position: absolute; z-index: 10; top: 14px; left: var(--margin); right: var(--margin); height: 60px; border-radius: 28px; display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 0 12px 0 24px; }
  .nav__mark { font-family: var(--display); font-size: 24px; letter-spacing: -0.02em; text-decoration: none; }
  .nav__links { list-style: none; display: flex; gap: 4px; margin: 0; padding: 0; }
  .nav__links a { display: block; padding: 10px 14px; font-size: 17px; font-weight: 500; text-decoration: none; border-radius: var(--pill); transition: background-color 200ms ease-out; }
  .nav__links a:hover { background: color-mix(in srgb, var(--ink) 6%, transparent); }
  .nav__menu { display: none; }

  /* Hero: the painting is the screen. The plate is centred (Josh, 26 Oct). */
  .a { position: relative; isolation: isolate; min-height: 100svh; padding: 116px var(--margin) 40px; display: grid; grid-template-rows: 1fr auto; }
  .a__art { position: absolute; inset: 0; z-index: -1; width: 100%; height: 100%; object-fit: cover; object-position: 50% 45%; -webkit-mask-image: linear-gradient(to bottom, #000 58%, transparent 92%); mask-image: linear-gradient(to bottom, #000 58%, transparent 92%); }
  .a__plate { align-self: center; justify-self: center; width: min(640px, 46vw); padding: 44px 44px 40px; display: grid; gap: 22px; }
  .a__h { font-family: var(--display); font-weight: 500; font-size: clamp(34px, 2.9vw, 42px); line-height: 1.06; letter-spacing: -0.02em; text-wrap: balance; }
  .a__p { font-size: 18px; line-height: 1.5; }
  .a__plate :global(.avail) { --fill: color-mix(in srgb, var(--paper) 55%, transparent); }
  .a__with { display: grid; grid-template-columns: 140px 1fr; gap: 24px; align-items: baseline; padding-top: 32px; font-size: 18px; line-height: 1.5; }
  .a__with-h { font-weight: 600; }
  /* One line that drifts left forever (Josh, 26 Oct). Two copies of the list, so the loop has no seam. */
  .a__with { min-width: 0; }
  .a__track { display: flex; overflow: hidden; -webkit-mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent); mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent); }
  .a__run { list-style: none; margin: 0; padding: 0 28px 0 0; display: flex; flex: none; gap: 56px; white-space: nowrap; animation: drift 38s linear infinite; }
  .a__with:hover .a__run { animation-play-state: paused; }
  @keyframes drift { to { transform: translateX(-100%); } }
  /* Reduced motion: still, scrollable by hand, the copy hidden. */
  @media (prefers-reduced-motion: reduce) { .a__track { overflow-x: auto; } .a__run[aria-hidden] { display: none; } }
  .a__credit { position: relative; margin-top: 8px; }

  /* Featured work: every card is its own pane over the etching, which fades but never quite leaves. */
  .fw { position: relative; isolation: isolate; padding-block: 160px 120px; }
  .fw__art { position: absolute; inset: 0; z-index: -1; overflow: hidden; }
  .fw__art img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 0%; -webkit-mask-image: linear-gradient(to bottom, transparent, #000 8%, #000 92%, transparent); mask-image: linear-gradient(to bottom, transparent, #000 8%, #000 92%, transparent); }
  .fw__head { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 24px; margin-bottom: 40px; }
  .fw__h { grid-column: 1 / span 7; font-family: var(--display); font-weight: 500; font-size: clamp(56px, 7.4vw, 112px); line-height: 0.9; letter-spacing: -0.03em; }
  .fw__p { grid-column: 1 / span 5; margin-top: 16px; font-size: 20px; line-height: 1.45; }
  .fw__cards { display: grid; gap: 24px; }
  .fw__pair { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; align-items: start; }
  .fw__all { padding-top: 8px; font-size: 20px; }

  @media (max-width: 1099.98px) {
    .nav__links li:not(:first-child) { display: none; }
    .a__plate { width: min(600px, 72vw); }
  }
  @media (max-width: 759.98px) {
    .nav { top: 10px; height: 54px; padding: 0 8px 0 18px; }
    .nav__mark { font-size: 21px; }
    .nav__links { display: none; }
    .nav__menu { display: block; padding: 9px 16px; font-weight: 500; font-size: 16px; text-decoration: none; border-radius: var(--pill); background: color-mix(in srgb, var(--ink) 6%, transparent); }
    .a { padding: 84px var(--margin) 24px; }
    .a__art { object-position: 30% 50%; }
    /* On a phone the plate takes the upper part, leaving the palm visible beside and below it. */
    .a__plate { margin: 0; width: 100%; align-self: start; padding: 24px 22px 22px; gap: 16px; border-radius: 26px; }
    .a__h { font-size: 29px; }
    .a__p { font-size: 16px; line-height: 1.45; }
    .a__with { grid-template-columns: 1fr; gap: 6px; padding-top: 24px; font-size: 15px; }
    .a__run { gap: 32px; padding-right: 16px; animation-duration: 30s; }
    .fw { padding-block: 112px 80px; }
    .fw__h, .fw__p { grid-column: 1 / -1; }
    .fw__h { font-size: 56px; }
    .fw__p { font-size: 17px; }
    .fw__cards, .fw__pair { gap: 16px; }
    .fw__pair { grid-template-columns: 1fr; }
  }
  /* Quiet: the same painting at 60% strength, cropped so the trees and sky sit behind the card. */
  .a--quiet .a__art { object-position: 50% 12%; }
  /* Half: cream on the left with the words, the painting on the right with a small glass CTA over it. */
  .a--half { grid-template-columns: 1fr 1fr; grid-template-rows: 1fr auto; column-gap: 0; padding-right: 0; }
  .a--half .a__art { inset: 0 0 0 50%; width: 50%; object-position: 30% 40%; -webkit-mask-image: linear-gradient(to bottom, #000 70%, transparent); mask-image: linear-gradient(to bottom, #000 70%, transparent); }
  .a--half .nav { background: color-mix(in srgb, var(--paper) 80%, transparent); }
  .a__left { align-self: center; display: grid; gap: 24px; padding-right: 48px; }
  .a__h--big { font-size: clamp(48px, 5.4vw, 84px); line-height: 0.98; letter-spacing: -0.03em; }
  .a__left .a__p { font-size: 20px; max-width: 34ch; }
  .a__cta { grid-column: 2; align-self: end; justify-self: center; width: min(460px, 80%); margin: 0 0 40px; padding: 28px; gap: 16px; }
  .a__cta-h { font-size: 20px; font-weight: 600; }
  .a--half .a__with { grid-column: 1 / -1; padding-right: var(--margin); }
  @media (max-width: 759.98px) {
    .a--half { grid-template-columns: 1fr; padding-right: var(--margin); }
    .a--half .a__art { inset: auto 0 0 0; width: 100%; height: 52%; }
    .a__left { padding: 0 0 24px; align-self: start; }
    .a__h--big { font-size: 44px; }
    .a__left .a__p { font-size: 17px; }
    .a__cta { grid-column: 1; width: 100%; margin: 0 0 24px; }
  }
</style>
