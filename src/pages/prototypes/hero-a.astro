---
// Prototype A, "Painting through glass" (INSPO/Kombu 01): the threshold fills the first
// screen, and one plate of glass floats over its quiet sky holding the whole offer.
import { Image } from 'astro:assets';
import Proto from '../../components/prototypes/Proto.astro';
import Actions from '../../components/prototypes/Actions.astro';
import PlateCaption from '../../components/PlateCaption.astro';
import { headline, sentence, clientLine } from '../../components/prototypes/home';
import sky from '../../assets/art/engraved/hunt-sky-gold.jpg';
---
<Proto title="Prototype A: Painting through glass">
  <main>
    <header class="a" id="a-art">
      <Image class="a__art" src={sky} alt="" widths={[800, 1600]} sizes="100vw" loading="eager" />
      <div class="a__plate plate-glass" data-liquid="a-art" data-tone="light" data-opacity="0.56">
        <h1 class="a__h">{headline}</h1>
        <p class="a__p">{sentence}</p>
        <p class="a__clients"><span>Clients include</span> {clientLine}.</p>
        <Actions />
      </div>
    </header>
    <div class="wrap a__credit">
      <PlateCaption title="La Chasse Chinoise (The Chinese Hunt), after François Boucher, after 1743" medium="Etching by Gabriel and Jacques Gabriel Huquier. The Met 53.600.1009, CC0. Duotoned" />
    </div>
    <div id="work"></div>
  </main>
</Proto>

<style>
  /* The painting is the whole first screen, faded out at its foot like the footer engraving. */
  .a { position: relative; isolation: isolate; min-height: 100svh; display: grid; place-items: center; padding: 72px var(--margin) 96px; }
  .a__art { position: absolute; inset: 0; z-index: -1; width: 100%; height: 100%; object-fit: cover; object-position: 50% 70%; -webkit-mask-image: linear-gradient(to bottom, #000 78%, transparent); mask-image: linear-gradient(to bottom, #000 78%, transparent); }
  /* The plate: the one centred moment on the page (TASTE 21), sitting in the sky above the hills. */
  .a__plate { width: min(740px, 100%); padding: 40px 44px 36px; display: grid; gap: 20px; margin-top: -6vh; }
  .a__h { font-family: var(--display); font-weight: 500; font-size: clamp(34px, 3.1vw, 44px); line-height: 1.04; letter-spacing: -0.02em; text-wrap: balance; }
  .a__p { font-size: 18px; line-height: 1.5; max-width: 52ch; }
  .a__clients { font-size: 16px; line-height: 1.5; color: var(--ink-2); }
  .a__clients span { color: var(--ink); font-weight: 500; }
  .a__plate :global(.avail) { --fill: color-mix(in srgb, var(--paper) 55%, transparent); }
  .a__credit { margin-top: -64px; position: relative; }
  @media (max-width: 759.98px) {
    .a { padding: 24px var(--margin) 80px; align-items: end; }
    .a__art { object-position: 88% 50%; }
    .a__plate { padding: 26px 22px 24px; gap: 16px; margin-top: 0; border-radius: 26px; }
    .a__h { font-size: 30px; line-height: 1.04; }
    .a__p { font-size: 17px; }
    .a__clients { font-size: 15px; }
  }
</style>
