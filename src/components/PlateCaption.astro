---
// TASTE 8: two lines under every image. Title, client and year in bold; the medium in brackets, light.
// An empty medium drops the second line. The brackets are drawn in CSS (components.css) so the phone gallery can show the medium without them.
interface Props { title: string; medium: string; }
const { title, medium } = Astro.props;
---
<figcaption class="plate"><b>{title}</b>{medium && <span>{medium}</span>}</figcaption>
