---
// The gold-flow wordmark: Josh's transparent video, rebuilt from his Framer component.
// A still shows first; the right video file is chosen in the browser and fades in once it is really playing.
const base = import.meta.env.BASE_URL;
---
<gold-flow class="gold-flow" data-hevc={`${base}media/hero/gold-flow-hevc.mp4`} data-webm={`${base}media/hero/gold-flow.webm`}>
  <img
    class="gold-flow__still"
    src={`${base}media/hero/gold-flow-final.webp`}
    data-first={`${base}media/hero/gold-flow-first.webp`}
    width="1500"
    height="400"
    alt=""
    fetchpriority="high"
    decoding="async"
  />
  <span class="visually-hidden">Conceptual Studio</span>
</gold-flow>

<script>
  import { transparentVideoKind } from '../lib/video-source.js';

  class GoldFlow extends HTMLElement {
    connectedCallback() {
      const still = this.querySelector('img');
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const saveData = (navigator as any).connection?.saveData === true;
      if (!still || reduce || saveData) return; // keep the finished wordmark as a still

      // Start from the first frame so the swap to video is seamless.
      still.src = still.dataset.first!;

      const kind = transparentVideoKind(navigator.userAgent, navigator.maxTouchPoints);
      const video = document.createElement('video');
      video.muted = true;
      video.defaultMuted = true;
      video.playsInline = true;
      video.setAttribute('playsinline', '');
      video.setAttribute('webkit-playsinline', '');
      video.setAttribute('aria-hidden', 'true');
      video.disablePictureInPicture = true;
      video.preload = 'auto';
      video.poster = still.dataset.first!;
      const source = document.createElement('source');
      source.src = kind === 'hevc' ? this.dataset.hevc! : this.dataset.webm!;
      source.type = kind === 'hevc' ? 'video/mp4; codecs="hvc1"' : 'video/webm; codecs="vp9"';
      video.append(source);
      this.append(video);

      const giveUp = () => {
        video.remove();
        still.src = still.src.replace('gold-flow-first', 'gold-flow-final');
      };
      // iOS Low Power Mode blocks autoplay without an error: if nothing plays soon, keep the finished still.
      const timer = setTimeout(giveUp, 1500);
      video.addEventListener('playing', () => { clearTimeout(timer); this.classList.add('is-playing'); }, { once: true });
      video.addEventListener('ended', () => { still.src = still.src.replace('gold-flow-first', 'gold-flow-final'); }, { once: true });
      video.addEventListener('error', () => { clearTimeout(timer); giveUp(); }, { once: true });
      video.play().catch(() => { clearTimeout(timer); giveUp(); });
    }
  }
  customElements.define('gold-flow', GoldFlow);
</script>
