---
// Shell for the /prototypes/ pages: not in the nav, not indexed (like /system/).
import '../../styles/tokens.css';
import '../../styles/components.css';
interface Props { title: string; }
const { title } = Astro.props;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <link rel="preload" href="/fonts/agatho-medium-subset.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-4-variable.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <slot />
    <script>
      import { mountLiquidGlass } from '../../scripts/liquid-glass.js';
      // Plate glass samples the art behind it: data-liquid names the element holding that <img>.
      document.querySelectorAll<HTMLElement>('[data-liquid]').forEach((panel) => {
        const image = document.getElementById(panel.dataset.liquid!)?.querySelector('img');
        const opacity = panel.dataset.opacity ? Number(panel.dataset.opacity) : undefined;
        mountLiquidGlass(panel, { image, tone: panel.dataset.tone, opacity });
      });
    </script>
  </body>
</html>
