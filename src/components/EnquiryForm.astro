---
import { settings } from '../lib/site.js';
interface Props { service?: string; heading?: string }
const { service = '', heading = 'Tell me about the project' } = Astro.props;
const options = ['Brand identity', 'Data visualisation', 'Something else'];
const budgets = ['Under £5k', '£5k to £10k', '£10k to £25k', '£25k to £50k', 'Over £50k', 'Not sure yet'];
const key = settings.web3formsKey;
---
<form class="enquiry" method="post" action={key ? 'https://api.web3forms.com/submit' : `mailto:${settings.email}`} data-enquiry data-key={key ? 'yes' : 'no'} data-email={settings.email} novalidate>
  <h2 class="head">{heading}</h2>
  <p class="muted">{settings.responseTime} Prefer email? Write to <a class="link" href={`mailto:${settings.email}`}>{settings.email}</a> and attach your brief.</p>
  {key && <input type="hidden" name="access_key" value={key} />}
  <input type="hidden" name="subject" value="New enquiry from conceptualstudio.co.uk" />
  <input type="hidden" name="from_name" value="Conceptual Studio website" />
  <div class="honeypot" aria-hidden="true"><label>Leave this empty <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" /></label></div>
  <div class="field-row">
    <div class="field"><label for="f-name">Your name</label><input id="f-name" name="name" autocomplete="name" required /></div>
    <div class="field"><label for="f-email">Work email</label><input id="f-email" name="email" type="email" autocomplete="email" required /></div>
  </div>
  <div class="field-row">
    <div class="field"><label for="f-org">Organisation</label><input id="f-org" name="organisation" autocomplete="organization" required /></div>
    <div class="field">
      <label for="f-service">What you need</label>
      <select id="f-service" name="service" required data-service-select>
        <option value="">Choose one</option>
        {options.map((o) => <option value={o} selected={o === service}>{o}</option>)}
      </select>
    </div>
  </div>
  <div class="field"><label for="f-tier">Option you're interested in <span class="muted">(optional)</span></label><input id="f-tier" name="tier" data-tier-input /></div>
  <div class="field"><label for="f-message">About the project</label><textarea id="f-message" name="message" required></textarea></div>
  <div class="field-row">
    <div class="field">
      <label for="f-budget">Budget <span class="muted">(optional)</span></label>
      <select id="f-budget" name="budget" aria-describedby="f-budget-hint"><option value="">Choose a band</option>{budgets.map((b) => <option>{b}</option>)}</select>
      <span class="hint" id="f-budget-hint">A rough band helps me suggest the right scope.</span>
    </div>
    <div class="field"><label for="f-date">Needed by <span class="muted">(optional)</span></label><input id="f-date" name="needed_by" type="date" /></div>
  </div>
  <label class="check"><input type="checkbox" name="formal_quote" value="Yes" /> <span>I need a formal written quote for procurement</span></label>
  <div class="actions">
    <button class="button" type="submit" data-submit>Send enquiry</button>
    <p class="form-status" role="status" aria-live="polite" data-status></p>
  </div>
</form>
<script>
  import '../scripts/form.js';
</script>
