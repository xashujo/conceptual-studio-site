---
// The nav wordmark: Josh's "Conceptual Studio" with the gold flow through both words (28 Oct; replaces the video).
// Ink text over paper, cream (#F1DFC8) over the night chapters. Cropped to the artwork, so the width is the logo's.
---
<a class="logo nav__mark" href="/" aria-label="Conceptual Studio">
  <img class="logo__ink" src="/brand/logo-ink.webp" alt="" width="720" height="140" />
  <img class="logo__cream" src="/brand/logo-cream.webp" alt="" width="720" height="140" />
</a>

<style>
  /* 180px wide: the text matches the old 24px text logo (Josh, 28 Oct). */
  .logo { display: grid; text-decoration: none; }
  .logo > img { grid-area: 1 / 1; width: 180px; height: auto; transition: opacity 300ms ease-out; }
  .logo__cream { opacity: 0; }
  :global(.is-dark) .logo .logo__ink { opacity: 0; }
  :global(.is-dark) .logo .logo__cream { opacity: 1; }
  @media (max-width: 759.98px) { .logo > img { width: 158px; } } /* the old 21px phone size */
</style>
