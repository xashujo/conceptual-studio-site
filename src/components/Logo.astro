---
// The nav wordmark: Josh's "Conceptual Studio" with the gold flow through both words (28 Oct; replaces the video).
// Ink text over paper, cream (#F1DFC8) over the night chapters. Cropped to the artwork, so the width is the logo's.
// The gold flow plays once through it on load (logo-flow.js), like the "Conceptual" video on Josh's old site (6 Nov).
// The videos are set in Pages CMS > Site settings > Logo animation.
import { logoFlow } from '../lib/site';
const { nav, navNight } = logoFlow;
---
<a class="logo nav__mark" href="/" aria-label="Conceptual Studio" data-flow>
  <img class="logo__ink" src="/brand/logo-ink.webp?v=9" alt="" width="720" height="144" />
  <img class="logo__cream" src="/brand/logo-cream.webp?v=9" alt="" width="720" height="144" />
  <video class="gold-flow logo__ink" muted playsinline preload="none" aria-hidden="true" width="1920" height="512" data-mov={nav.mov} data-webm={nav.webm} data-poster={nav.poster} />
  <video class="gold-flow logo__cream" muted playsinline preload="none" aria-hidden="true" width="1920" height="512" data-mov={navNight.mov} data-webm={navNight.webm} data-poster={navNight.poster} />
</a>

<style>
  /* 210px wide (Josh, 7 Nov: 180px was too small to read the gold behind the "o"). */
  .logo { display: grid; text-decoration: none; }
  .logo > * { transition: opacity 300ms ease-out; }
  .logo > img { grid-area: 1 / 1; width: 210px; height: auto; } /* the videos are placed in components.css */
  .logo__cream { opacity: 0; }
  :global(.is-dark) .logo .logo__ink { opacity: 0; }
  :global(.is-dark) .logo .logo__cream { opacity: 1; }
  @media (max-width: 759.98px) { .logo > img { width: 172px; } } /* a touch over the old 21px phone size */
</style>

<script>import '../scripts/logo-flow.js';</script>
