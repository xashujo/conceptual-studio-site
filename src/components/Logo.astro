---
// The nav wordmark: Josh's gold flow, played once on load (28 Oct). Transparent video needs two files:
// VP9 WebM with alpha for Chrome, Firefox and Android, HEVC with alpha for Safari and iOS (any app's browser).
// The stills are its last frame (ink, and cream for the night chapters), shown without script, with reduced
// motion, if playback fails, and once it ends.
---
<a class="logo nav__mark" href="/" aria-label="Conceptual Studio">
  <img class="logo__ink" src="/brand/logo-ink.webp" alt="" width="750" height="200" />
  <img class="logo__cream" src="/brand/logo-cream.webp" alt="" width="750" height="200" />
  <video class="logo__flow" muted playsinline disablepictureinpicture preload="auto" aria-hidden="true" data-webm="/brand/logo-flow.webm" data-hevc="/brand/logo-flow.mp4"></video>
</a>

<script>
  const ua = navigator.userAgent;
  // Same rule as Josh's Framer component: WebKit (every iOS browser, Safari on the Mac) only shows HEVC's alpha.
  const apple = /iP(hone|ad|od)/.test(ua) || (/Safari/.test(ua) && !/Chrome|Chromium|Android|Firefox/.test(ua));
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLElement>('.logo').forEach((logo) => {
      const v = logo.querySelector('video')!;
      const still = () => logo.classList.remove('is-playing');
      v.addEventListener('ended', still);
      v.addEventListener('error', still);
      v.src = (apple ? v.dataset.hevc : v.dataset.webm)!;
      logo.classList.add('is-playing');
      v.play().catch(still); // autoplay blocked (iOS Low Power Mode): the still stays
    });
  }
</script>

<style>
  .logo { --h: 48px; display: grid; height: var(--h); margin-left: calc(-0.157 * var(--h)); /* the files' left padding */ }
  .logo > * { grid-area: 1 / 1; width: calc(3.75 * var(--h)); height: var(--h); }
  .logo__cream, .logo__flow { visibility: hidden; }
  .logo.is-playing .logo__flow { visibility: visible; }
  .logo.is-playing .logo__ink { visibility: hidden; }
  /* Over the night chapters the text is cream (#F1DFC8): the cream still, also mid-play. */
  :global(.is-dark) .logo :is(.logo__ink, .logo__flow) { visibility: hidden; }
  :global(.is-dark) .logo .logo__cream { visibility: visible; }
  @media (max-width: 759.98px) { .logo { --h: 42px; } }
</style>
