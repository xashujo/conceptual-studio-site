---
// A drawing behind a bento tile, pushed off its right edge so only about half of it shows, the way Apple's
// bento grids crop their art (Josh, 5 Nov: "put it more into the sides, so only half shows"). Either a line
// icon cut from Josh's own work (`art`: a white shape on transparent, from scripts/silhouette.py or chart-icon.py),
// or one of the line icons below (`icon`). Both show grey in the glass (Josh, 5 Nov: "take the map outline, make it
// grey, like a standard icon"), faint enough that the words stay easy to read.
// No icon coins at the top of tiles (Josh, 5 Nov: "do not put icons in the circles like that").
// The names match ART_ICONS in content.config.ts and the select lists in .pages.yml.
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
interface Props { icon?: string | null; art?: ImageMetadata | null }
export const paths: Record<string, string> = {
  chart: 'M4 20h16M7.5 16.5v-4M12 16.5V7M16.5 16.5v-6.5',
  map: 'M9 4.5 3.5 6.8v12.7L9 17.2l6 2.3 5.5-2.3V4.5L15 6.8 9 4.5ZM9 4.5v12.7M15 6.8v12.7',
  pages: 'M8 3.5h6.5l4 4V20.5H8ZM14.5 3.5v4h4M11 12h4.5M11 15.5h4.5M5.5 7v15h10',
  papers: 'M10 2.5h7l3 3v12.5H10ZM17 2.5v3h3M13 9h4M13 12h4M13 15h2.5M7 5.5v15.5h10M4 8.5v14h10',
  formats: 'm12 3.8 8.5 4.3-8.5 4.3-8.5-4.3ZM3.5 12.2l8.5 4.3 8.5-4.3M3.5 16.2l8.5 4.3 8.5-4.3',
  buildings: 'M3.5 20.5h17M5.5 20.5V9l6.5-4.5L18.5 9v11.5M10 20.5v-5h4v5M9 11.5h.01M15 11.5h.01',
  calendar: 'M6 5h12a2.5 2.5 0 0 1 2.5 2.5v10.5A2.5 2.5 0 0 1 18 20.5H6A2.5 2.5 0 0 1 3.5 18V7.5A2.5 2.5 0 0 1 6 5ZM3.5 10h17M8 3v4M16 3v4',
  timeline: 'M3.5 12h17M6 9.5v5M12 7.5v9M18 9.5v5',
  steps: 'M3.5 19.5h5v-5h5v-5h5v-5h2',
  contrast: 'M12 3.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17ZM12 3.5v17',
  choice: 'M12 21v-7.5M12 13.5 5.5 7M12 13.5 18.5 7M5.5 11.5V7H10M18.5 11.5V7H14',
  ring: 'M12 3.5A8.5 8.5 0 1 1 3.92 14.63',
  idea: 'M9.5 17.5h5M10.5 20.5h3M12 3.5a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2v1.1h5v-1.1c0-.8.4-1.5 1-2A6 6 0 0 0 12 3.5Z',
  quote: 'M6 3.5h8.5L18 7v13.5H6ZM14.5 3.5V7H18M13.5 11.2a2 2 0 0 0-3.5 1.3v4.5M9 17h5.5M9 14h3.5',
  accessible: 'M6 3.5h8.5L18 7v13.5H6ZM14.5 3.5V7H18M9 13.5l2 2 4-4.5',
  order: 'M8 4.5H6v16h12v-16h-2M9 3.5h6V6H9ZM9 10.5h6M9 13.5h6M9 16.5h4',
  signature: 'M3.5 19.5h17M5 15.5c2-3 3-6.5 4.5-6.5s-1 6.5 1 6.5 2.5-4 4-4 .5 3 2 3 2-1 3-2',
  shield: 'M12 3.5 19 6v5.5c0 4.5-3 7.8-7 9-4-1.2-7-4.5-7-9V6ZM9.5 12l2 2 3.5-4',
  invoice: 'M6 3.5h12v17l-2-1.3-2 1.3-2-1.3-2 1.3-2-1.3-2 1.3ZM9 8h6M9 11h6M9 14h3.5',
  payment: 'M5 6h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2ZM3 10h18M6.5 14.5h4',
  discovery: 'M10.5 4a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13ZM15.2 15.2l5.3 5.3',
  direction: 'M12 3.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17ZM15.5 8.5l-2 5-5 2 2-5Z',
  development: 'M14.5 4.5l5 5L9 20H4v-5ZM12.5 6.5l5 5',
  delivery: 'M12 3.5l8 4v9l-8 4-8-4v-9ZM4 7.5l8 4 8-4M12 11.5v9',
};
const { icon, art } = Astro.props;
const d = icon ? paths[icon] : undefined;
const extra = icon === 'ring' ? 'ring' : icon === 'contrast' ? 'contrast' : '';
const img = art ? await getImage({ src: art, width: 900, format: 'webp' }) : undefined;
---
{img && (
  <span class="bento-art" aria-hidden="true"><span class:list={["bento-art__lines", { "bento-art__lines--wide": art!.width / art!.height > 1.6 }]} style={`--ar: ${(art!.width / art!.height).toFixed(3)}; --src: url('${img.src}')`}></span></span>
)}
{!img && d && (
  <span class="bento-art" aria-hidden="true">
    <svg class="bento-art__icon" viewBox="2 2 20 20" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
      <path d={d} vector-effect="non-scaling-stroke" />{extra === 'ring' && <circle cx="12" cy="12" r="8.5" opacity="0.4" vector-effect="non-scaling-stroke" />}{extra === 'contrast' && <path d="M12 3.5a8.5 8.5 0 0 1 0 17Z" fill="currentColor" stroke="none" opacity="0.5" />}
    </svg>
  </span>
)}
