---
// The glass nav from home prototype A (Josh's choice): lens glass over the page's opening art,
// the current page as the lifted glass pill, like every other page. On phones, Menu opens a glass sheet (2a7589f).
import { nav, availability } from '../lib/site';
import Logo from './Logo.astro';
interface Props { current?: string; art: string; tone?: 'light' | 'dark'; }
const { current, tone = 'light' } = Astro.props;
// The same links as every other page: Home first, and the contact link is the Start a Project button (Josh, 5 Nov).
// Procurement sits before Start a Project so finance teams find it without the footer (Josh, 6 Nov).
const links = [{ label: 'Home', href: '/' }, ...nav.flatMap((l) => l.href === '/contact/' ? [{ label: 'Procurement', href: '/procurement/' }, { label: 'Start a Project', href: l.href, cta: true }] : [l])];
---
<nav class:list={['nav glass glass--nav', { 'is-dark': tone === 'dark' }]} aria-label="Main">
  <Logo />
  <ul class="nav__links">
    {links.map((l) => <li><a class={l.cta ? 'btn nav__cta' : 'glass-pill'} href={l.href} aria-current={l.label === current ? 'page' : undefined}>{l.cta && availability.on && <span class="avail__dot nav__dot" aria-hidden="true" />}{l.label}{l.cta && availability.on && <span class="sr">, {availability.text.toLowerCase()}</span>}</a></li>)}
  </ul>
  <button class="nav__menu" type="button" popovertarget="menu">Menu</button>
</nav>
<div class="sheet glass" id="menu" popover>
  <ul>
    {links.map((l) => <li><a class={l.cta ? 'btn btn--solid menu__cta' : 'glass-pill'} href={l.href} aria-current={l.label === current ? 'page' : undefined}>{l.cta && availability.on && <span class="avail__dot nav__dot" aria-hidden="true" />}{l.label}</a></li>)}
  </ul>
</div>

<style>
  .nav { position: absolute; z-index: 10; top: 14px; left: var(--margin); right: var(--margin); height: 60px; border-radius: var(--radius); display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 0 8px 0 24px; color: var(--ink); }
  .nav__mark { font-family: var(--display); font-size: 24px; letter-spacing: -0.01em; text-decoration: none; }
  .nav__links { list-style: none; display: flex; align-items: center; gap: 2px; margin: 0; padding: 0; }
  .nav__menu { padding: 9px 16px; border: 0; border-radius: var(--pill); background: color-mix(in srgb, var(--ink) 7%, transparent); color: inherit; font: 500 16px/1.2 var(--text); cursor: pointer; }
  .nav__menu { display: none; }
  .nav a:focus-visible, .nav button:focus-visible, .sheet a:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }

  /* The phone menu: the same frosted glass sheet as every other page (Josh, 5 Nov: the clear lens let the
     page heading show through the links). Escape or tapping outside closes it, as elsewhere. */
  .sheet { position: absolute; inset: 74px 10px auto; width: auto; margin: 0; padding: 8px; border: 0; border-radius: var(--radius); color: var(--ink); }
  .sheet ul { list-style: none; margin: 0; padding: 0; display: grid; }
  .sheet .glass-pill { width: 100%; min-height: 52px; padding: 0 18px; font-size: 20px; }
  .sheet:popover-open { animation: sheet-in 400ms var(--ease-out); }
  @keyframes sheet-in { from { opacity: 0; transform: translateY(-8px) scale(0.98); } }

  @media (max-width: 759.98px) {
    .nav { top: 10px; height: 54px; padding: 0 8px 0 18px; }
    .nav__mark { font-size: 21px; }
    .nav__links { display: none; }
    .nav__menu { display: block; }
  }
</style>

<script>import '../scripts/fallbacks.js';</script>
