---
// Inner page opening: a big serif title and one sentence about the page.
interface Props { title: string; lead?: string }
const { title, lead } = Astro.props;
---
<section class="page-head wrap">
  <div class="page-head__inner">
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    {Astro.slots.has('default') && <div class="page-head__side"><slot /></div>}
  </div>
</section>
