---
// A page's threshold (TASTE 1 to 3, 19): the art behind the glass nav, the page's name as the one
// big Agatho word standing on a hairline, then the credits row and the art's plate caption.
// The art fades to paper before the rule, so the word sits on the quiet part.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Nav from './Nav.astro';
import PlateCaption from './PlateCaption.astro';
interface Props {
  word: string;
  /** 1 / the word's width in em, measured, so the word runs margin to margin. */
  fit: number;
  art: ImageMetadata;
  credit: { title: string; medium: string };
  position?: string;
  current?: string;
  /** set inside a night chapter: the nav becomes dark glass */
  night?: boolean;
  /** height of the art band above the word, as a share of the viewport height */
  tall?: number;
}
const { word, fit, art, credit, position = '50% 50%', current, night = false, tall = 0.42 } = Astro.props;
const hasCredits = Astro.slots.has('default');
// DECISIONS (/system/): a descender hangs below the hairline and the rule looks detached, so words
// with one (Colophon, Privacy, Accessibility) stand without it; the credits sit directly under.
const ruled = !/[gjpqy]/.test(word);
---
<header class="open" id="open-art" style={`--fit:${fit};--tall:${tall}`}>
  <Nav current={current} art="open-art" tone={night ? 'dark' : 'light'} />
  <Image class="open__art" src={art} alt="" widths={[800, 1600]} sizes="100vw" loading="eager" fetchpriority="high" style={`object-position:${position}`} />
  <slot name="over" />
  <h1 class:list={['open__word', { 'is-unruled': !ruled }]}>{word}</h1>
</header>
<div class="wrap open__foot">
  {ruled && <hr class="rule" />}
  {hasCredits && <div class="credits"><slot /></div>}
  <div class="open__credit"><PlateCaption {...credit} /></div>
</div>

<style>
  .open { position: relative; isolation: isolate; padding: calc(100px + var(--tall) * 100svh) var(--margin) 0; overflow: hidden; }
  .open__art { position: absolute; inset: 0; z-index: -1; width: 100%; height: 100%; object-fit: cover; -webkit-mask-image: linear-gradient(to bottom, #000 45%, transparent 96%); mask-image: linear-gradient(to bottom, #000 45%, transparent 96%); }
  /* Cap height well over 20x the body (TASTE 3); the measured fit keeps it margin to margin. */
  .open__word { position: relative; font-family: var(--display); font-weight: 500; font-size: min(509px, calc((100vw - 2 * var(--margin)) * var(--fit))); line-height: 0.74; letter-spacing: -0.015em; padding-top: 0.06em; white-space: nowrap; }
  .open__word.is-unruled { padding-bottom: 0.24em; } /* room for the descender inside the art band */
  .open__foot { padding-bottom: 8px; }
  .credits { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; align-items: start; padding-top: 18px; font-size: 24px; line-height: 1.3; letter-spacing: -0.01em; }
  .credits > :global(:last-child) { justify-self: end; }
  .open__credit { padding-top: 22px; }
  .open__credit :global(.plate) { margin-top: 0; max-width: 46em; }

  @media (max-width: 1099.98px) {
    .credits { grid-template-columns: 1fr 1fr; }
    .credits > :global(:last-child) { grid-column: 1 / -1; justify-self: start; }
  }
  @media (max-width: 759.98px) {
    .open { padding-top: calc(84px + var(--tall) * 70svh); }
    .credits { grid-template-columns: 1fr; gap: 12px; font-size: 20px; padding-top: 14px; }
    .credits > :global(:last-child) { justify-self: start; margin-top: 6px; }
  }
</style>
