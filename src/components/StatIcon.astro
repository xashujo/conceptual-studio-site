---
// Small line icons for the Outcomes figures (Josh, 5 Nov: "use some icons so they're not so dry").
// One 24px grid, 1.5 stroke, round ends, in the text colour. The names match STAT_ICONS in content.config.ts.
interface Props { name: string }
const paths: Record<string, string> = {
  chart: 'M4 20h16M7.5 16.5v-4M12 16.5V7M16.5 16.5v-6.5',
  map: 'M9 4.5 3.5 6.8v12.7L9 17.2l6 2.3 5.5-2.3V4.5L15 6.8 9 4.5ZM9 4.5v12.7M15 6.8v12.7',
  pages: 'M8 3.5h6.5l4 4V20.5H8ZM14.5 3.5v4h4M11 12h4.5M11 15.5h4.5M5.5 7v15h10',
  formats: 'm12 3.8 8.5 4.3-8.5 4.3-8.5-4.3ZM3.5 12.2l8.5 4.3 8.5-4.3M3.5 16.2l8.5 4.3 8.5-4.3',
  buildings: 'M3.5 20.5h17M5.5 20.5V9l6.5-4.5L18.5 9v11.5M10 20.5v-5h4v5M9 11.5h.01M15 11.5h.01',
  calendar: 'M6 5h12a2.5 2.5 0 0 1 2.5 2.5v10.5A2.5 2.5 0 0 1 18 20.5H6A2.5 2.5 0 0 1 3.5 18V7.5A2.5 2.5 0 0 1 6 5ZM3.5 10h17M8 3v4M16 3v4',
  timeline: 'M3.5 12h17M6 9.5v5M12 7.5v9M18 9.5v5',
  steps: 'M3.5 19.5h5v-5h5v-5h5v-5h2',
  contrast: 'M12 3.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17ZM12 3.5v17',
  choice: 'M12 21v-7.5M12 13.5 5.5 7M12 13.5 18.5 7M5.5 11.5V7H10M18.5 11.5V7H14',
};
const { name } = Astro.props;
const d = paths[name];
---
{d && (
  <span class="stat-icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="22" height="22"><path d={d} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />{name === 'contrast' && <path d="M12 3.5a8.5 8.5 0 0 1 0 17Z" fill="currentColor" />}</svg>
  </span>
)}

<style>
  /* A small glass coin on the tile: lit top edge, soft contact shadow, like the buttons. */
  .stat-icon { display: grid; place-items: center; flex: none; width: 48px; height: 48px; border-radius: 50%; color: var(--ink); background: color-mix(in srgb, var(--ink) 9%, transparent); box-shadow: inset 0 1px 0 color-mix(in srgb, var(--ink) 22%, transparent), 0 0 0 1px color-mix(in srgb, var(--ink) 10%, transparent), 0 6px 14px -8px rgb(0 0 0 / 0.5); }
  .stat-icon svg { display: block; width: 22px; height: 22px; }
</style>
