---
// One service page (brief 6.4) in the home page's design language (Josh, 2 Nov): the opening plate with the
// starting price, real examples, the prices ladder, questions, and the enquiry form preset to this service.
// Words and examples: Pages CMS > Services and prices (this service) and Services page. The "demo" slot holds a chart.
import { Image } from 'astro:assets';
import Studio from '../layouts/Studio.astro';
import Band from './studio/Band.astro';
import PlateCaption from './PlateCaption.astro';
import Ladder from './Ladder.astro';
import Enquiry from './Enquiry.astro';
import { serviceById } from '../data/services';
import { servicesPage as sp, titleCase, keepHyphens } from '../lib/pages';
import { home, responseTime } from '../lib/site';
interface Props { service: string; description: string }
const { service, description } = Astro.props;
const s = serviceById(service);
const name = titleCase(s.name);
const steps = home.steps.map((st) => ({ title: st.title, text: st.text.replaceAll('{reply time}', responseTime) }));
---
<Studio title={`${name} | Conceptual Studio`} description={description} current="/services/" turnstile closeText={sp.closeText}>
  <Band opening labelledby="svc-h">
    <div class="ph__plate glass" data-lens>
      <h1 class="ph__h sv-h" id="svc-h">{keepHyphens(name)}</h1>
      <p class="ph__p">{s.line}</p>
      {s.kinds && <p class="ph__p sv-kinds">{s.kinds}</p>}
      <p class="sv-from">{s.tiers[0].price}{s.tiers[0].time && <span>, {s.tiers[0].time}</span>}</p>
      <div class="acts">
        <a class="btn btn--solid" href="#enquire">{sp.enquiryHeading}</a>
        <a class="btn" href="#prices">See the {sp.pricesHeading}</a>
      </div>
    </div>
  </Band>

  {s.examples.length > 0 && (
    <Band night labelledby="work-h">
      <h2 class="big" id="work-h">{sp.workHeading}</h2>
      <div class="sv-ex">
        {s.examples.map((e, i) => (
          <figure data-reveal style={`--i: ${i}`}>
            <Image src={e.img} alt={e.alt} widths={[600, 900, 1400]} sizes="(min-width: 1200px) 560px, (min-width: 760px) 48vw, 100vw" style={`object-position:${e.pos ?? '50% 50%'}`} />
            <PlateCaption title={e.title} medium={e.medium} />
          </figure>
        ))}
      </div>
    </Band>
  )}

  <Band id="prices" labelledby="prices-h">
    {Astro.slots.has('demo') && <div class="sv-demo"><slot name="demo" /></div>}
    <div class="head">
      <h2 class="big" id="prices-h">{sp.pricesHeading}</h2>
      {sp.pricesNote && <p class="lede">{sp.pricesNote}</p>}
    </div>
    <Ladder service={service} />
    <!-- How a project runs, moved here from the home page (Josh, 3 Nov). Steps: Pages CMS > Home page > How We Work. -->
    <h2 class="big sv-how" id="how-h">{sp.howHeading}</h2>
    <ol class="tiles" style="margin-top: var(--sp-head)">
      {steps.map((st, i) => <li class="glass" data-lens data-reveal style={`--i: ${i % 2}`}><h3>{st.title}</h3><p>{st.text}</p></li>)}
    </ol>
  </Band>

  {s.faqs.length > 0 && (
    <Band night labelledby="faq-h">
      <h2 class="big" id="faq-h">{sp.faqHeading}</h2>
      <div class="acc acc--q glass" data-lens data-acc>
        {s.faqs.map((f) => (
          <div class="acc__row">
            <h3 class="acc__h"><button class="acc__btn" type="button" aria-expanded="true"><span>{f.q}</span><span class="acc__icon" aria-hidden="true"></span></button></h3>
            <div class="acc__panel" role="region" aria-label={f.q}><div class="acc__inner"><div class="acc__body"><p class="acc__text">{f.a}</p></div></div></div>
          </div>
        ))}
      </div>
    </Band>
  )}

  <Band label={sp.enquiryHeading}>
    <Enquiry service={service} heading={sp.enquiryHeading} />
  </Band>
</Studio>

<style>
  .sv-h { font-size: clamp(56px, 7.4vw, 116px); }
  .sv-kinds { font-size: 18px; color: var(--ink-2); }
  .sv-from { font-size: 22px; font-weight: 600; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .sv-from span { font-weight: 400; color: var(--ink-2); }
  .sv-ex { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-gap); margin-top: var(--sp-head); }
  .sv-ex img { display: block; width: 100%; height: auto; aspect-ratio: 5 / 4; object-fit: cover; border-radius: var(--radius); }
  .sv-demo { margin-bottom: var(--sp-section); }
  .sv-how { margin-top: var(--sp-section); }
  @media (max-width: 759.98px) {
    .sv-h { font-size: 48px; }
    .sv-kinds { font-size: 16px; }
    .sv-ex { grid-template-columns: 1fr; gap: 40px; }
    .sv-ex img { aspect-ratio: 4 / 5; }
  }
</style>
