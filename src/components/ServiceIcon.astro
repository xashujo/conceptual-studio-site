---
// Plain line icons for the service lists (Josh, 4 Nov; Design Laboratory's "We specialise in" style). One stroke, no fill,
// drawn on a 32 grid so they sit with the Agatho names. Chosen per service in Pages CMS > Services and prices > Icon.
const paths: Record<string, string> = {
  chart: 'M5 26V6M5 26h22M10 21v-6M16 21V9M22 21v-9',
  identity: 'M16 4l3.2 6.9 7.5.9-5.6 5.1 1.6 7.4L16 20.5l-6.7 3.8 1.6-7.4-5.6-5.1 7.5-.9z',
  team: 'M11 14a4 4 0 100-8 4 4 0 000 8zM3 26a8 8 0 0116 0M21 14a3.5 3.5 0 100-7M23 19.5A8 8 0 0129 26',
  video: 'M4 8h17v16H4zM21 14l7-4v12l-7-4',
  calendar: 'M5 7h22v20H5zM5 13h22M11 4v6M21 4v6',
};
const { name } = Astro.props;
const d = paths[name as string];
---
{d && <svg class="icon" viewBox="0 0 32 32" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={d} /></svg>}
