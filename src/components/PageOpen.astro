---
// A page opening (TASTE 1, 2, 3, 19): a quiet passage of a duotoned etching, the page's one big
// Agatho word set straight onto it, and the credits row underneath. No hairline (DECISIONS, 26 Oct).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { word: string[]; art: ImageMetadata; artPosition?: string; size: string; who: string; what: string }
const { word, art, artPosition = '50% 100%', size, who, what } = Astro.props;
---
<header class="open">
  <div class="open__art" aria-hidden="true"><Image src={art} alt="" widths={[800, 1600]} sizes="100vw" loading="eager" style={`object-position:${artPosition}`} /></div>
  <div class="wrap">
    <h1 class="open__word" style={`--size:${size}`}>{word.map((w) => <span>{w}</span>)}</h1>
    <div class="credits">
      <p>{who}</p>
      <p>{what}</p>
      <p><slot /></p>
    </div>
  </div>
</header>

<style>
  .open { position: relative; isolation: isolate; padding-block: 136px 0; }
  .open__art { position: absolute; z-index: -1; inset: 0 0 -80px; }
  .open__art img { width: 100%; height: 100%; object-fit: cover; -webkit-mask-image: linear-gradient(to bottom, transparent, #000 12%, #000 50%, transparent 96%); mask-image: linear-gradient(to bottom, transparent, #000 12%, #000 50%, transparent 96%); }
  .open__word { font-family: var(--display); font-weight: 500; font-size: var(--size); line-height: 0.82; letter-spacing: -0.015em; margin-left: -0.04em; padding-bottom: 0.18em; }
  .open__word span { display: block; }
  .credits { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; font-size: 24px; line-height: 1.3; letter-spacing: -0.01em; }
  .credits p:nth-child(2) { color: var(--ink-2); }
  .credits p:last-child { justify-self: end; }
  @media (max-width: 1099.98px) { .credits { font-size: 20px; } }
  @media (max-width: 759.98px) {
    .open { padding-top: 104px; }
    .credits { grid-template-columns: 1fr; gap: 6px; font-size: 20px; padding-top: 14px; }
    .credits p:last-child { justify-self: start; margin-top: 10px; }
  }
</style>
