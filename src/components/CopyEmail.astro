---
import { settings } from '../lib/site.js';
---
<span class="copy-email-wrap">
  <a class="link" href={`mailto:${settings.email}`}>{settings.email}</a>
  <button class="copy-email" type="button" data-copy={settings.email} hidden>
    <span class="copy-email__state" aria-live="polite">Copy</span>
  </button>
</span>
