---
// The work, filtered, in a grid of glass cards or a list of rows that open (Josh, 2 Nov). One set of
// project data feeds both views; switching views or filters only shows and hides what's already in the page.
// Used by Selected Work on the home page and by the Work page. Without script every card shows.
import { Image } from 'astro:assets';
export interface Item {
  title: string; year: number; href: string; image: ImageMetadata; alt: string; position?: string;
  filters: string[]; archive?: boolean; student?: boolean; label?: string; outcome?: string; brief: string;
  /** The Work page's card line (Josh, 5 Nov, after Arturistic): ["Sustainability report for", "New City College London"]. */
  caption?: [string, string];
  /** The table's Category and Client cells. */
  category?: string; client?: string;
}
export interface Video { title: string; year: number; video: string; poster: string; alt: string }
import type { ImageMetadata } from 'astro';
interface Props {
  items: Item[]; videos?: Video[]; filters: string[]; videoFilter?: string;
  /** Archive filter: its items only show under it, never under All. */
  archive?: string; archiveNote?: string;
  /** How many show before "Show More"; leave out to show them all. */
  limit?: number; label: string; children?: unknown;
  /** List view as a flat table (Year, Project, Category, Client), newest first, instead of rows that open. */
  table?: boolean;
}
const { items, videos = [], filters, videoFilter = 'Social Media', archive, archiveNote, limit = 0, label, table = false } = Astro.props;
const key = (fs: string[]) => fs.join('|');
const byYear = [...items].sort((a, b) => b.year - a.year); // stable, so same-year projects keep their order
---
<div class="wb" data-wb data-limit={limit} data-archive-name={archive}>
  <div class="wb__tools">
    <div class="filterbar glass" role="group" aria-label={`Filter ${label}`} data-lens data-filters hidden>
      <button class="glass-pill" type="button" data-filter="all" aria-pressed="true">All</button>
      {filters.map((f) => <button class="glass-pill" type="button" data-filter={f} aria-pressed="false">{f}</button>)}
      {videos.length > 0 && !filters.includes(videoFilter) && <button class="glass-pill" type="button" data-filter={videoFilter} aria-pressed="false">{videoFilter}</button>}
      {archive && <button class="glass-pill" type="button" data-filter={archive} aria-pressed="false">{archive}</button>}
    </div>
    <!-- Grid or list view: the icon shows the view you'd switch to. -->
    <button class="wb__view glass" data-lens type="button" aria-label="List view" title="List view" data-view>
      <svg class="wb__list" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 4h14M2 9h14M2 14h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      <svg class="wb__tiles" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 2h5.5v5.5H2zM10.5 2H16v5.5h-5.5zM2 10.5h5.5V16H2zM10.5 10.5H16V16h-5.5z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
    </button>
  </div>
  {archiveNote && <p class="wb__note" data-archive-note hidden>{archiveNote}</p>}

  <ul class="wb__grid" data-grid>
    {items.map((c) => (
      <li data-filter={key(c.archive ? [archive!] : c.filters)} data-archive={c.archive ? '' : undefined}>
        <a class="card glass" href={c.href} data-lens>
          <span class="card__media"><Image class="card__img" src={c.image} alt={c.alt} widths={[400, 700, 1100, 1600]} sizes="(min-width: 1100px) 580px, (min-width: 760px) 47vw, calc(100vw - 32px)" style={c.position ? `object-position: ${c.position}` : undefined} /></span>
          <span class="card__head">
            {c.caption
              ? <span class="card__t card__cap" title={`${c.caption[0]} ${c.caption[1]}`}>{c.caption[0]} <b>{c.caption[1]}</b></span>
              : <span class="card__t" title={c.title}>{c.title}</span>}
            <span class="card__y">{c.year}</span>
          </span>
          {/* The caption already says what it is, so a captioned card keeps only its label (Concept, Student Work). */}
          {(!c.caption || c.label) && (
            <span class="card__row">
              <span class="card__tags">
                {!c.caption && c.filters.slice(0, 1).map((f) => <span class="tag">{f}</span>)}
                {c.label && <span class="tag">{c.label}</span>}
              </span>
            </span>
          )}
          <span class="card__out">{c.outcome}</span>
        </a>
      </li>
    ))}
    {videos.map((v) => (
      <li class="wb__vid" data-filter={videoFilter}>
        <div class="card glass" data-lens>
          <div class="vid">
            <video class="card__img vid__v" src={v.video} poster={v.poster} preload="none" playsinline aria-label={v.alt}></video>
            <button class="vid__play" type="button" aria-label={`Play ${v.title}`} data-play><span class="vid__icon glass-button" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24"><path d="M7 4.5v15l12-7.5z" fill="currentColor"/></svg></span></button>
          </div>
          <span class="card__row"><span class="card__t">{v.title}</span><span class="card__y">{v.year}</span></span>
        </div>
      </li>
    ))}
  </ul>

  <!-- List view: a table on the Work page (Josh, 5 Nov, after Arturistic: every project and client at a glance,
       newest first); elsewhere the same projects as rows that open to their brief, image and link. -->
  {table ? (
  <div class="wbt glass wb__rows" data-lens data-list hidden>
    <table>
      <thead><tr><th scope="col">Year</th><th scope="col">Project</th><th scope="col">Category</th><th scope="col">Client</th></tr></thead>
      <tbody>
        {byYear.map((c) => (
          <tr data-filter={key(c.archive ? [archive!] : c.filters)} data-archive={c.archive ? '' : undefined}>
            <td class="wbt__y">{c.year}</td>
            <td class="wbt__t"><a href={c.href}>{c.title}</a></td>
            <td class="wbt__c">{c.category}</td>
            <td class="wbt__k">{c.client}</td>
          </tr>
        ))}
        {videos.map((v) => (
          <tr data-filter={videoFilter}>
            <td class="wbt__y">{v.year}</td>
            <td class="wbt__t">{v.title}</td>
            <td class="wbt__c">{videoFilter}</td>
            <td class="wbt__k"></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  ) : (
  <div class="acc glass wb__rows" data-lens data-acc data-list hidden>
    {items.map((c, i) => (
      <div class="acc__row" data-filter={key(c.archive ? [archive!] : c.filters)} data-archive={c.archive ? '' : undefined}>
        <h3 class="acc__h">
          <button class="acc__btn" type="button" aria-expanded="true">
            <span class="wbl__t">{c.title}</span>
            <span class="wbl__tags">{c.filters.slice(0, 1).map((f) => <span class="tag">{f}</span>)}{c.label && <span class="tag">{c.label}</span>}</span>
            <span class="acc__from">{c.year}</span><span class="acc__icon" aria-hidden="true"></span>
          </button>
        </h3>
        <div class="acc__panel" role="region" aria-label={c.title}>
          <div class="acc__inner">
            <div class="acc__body wbl__body">
              <Image class="wbl__img" src={c.image} alt={c.alt} widths={[400, 700]} sizes="(min-width: 760px) 360px, calc(100vw - 76px)" style={c.position ? `object-position: ${c.position}` : undefined} />
              <p class="acc__text">{c.brief}</p>
              <a class="btn glass-button acc__go" href={c.href}>View Project <span class="arrow" aria-hidden="true">→</span></a>
            </div>
          </div>
        </div>
      </div>
    ))}
    {videos.map((v) => (
      <div class="acc__row" data-filter={videoFilter}>
        <h3 class="acc__h">
          <button class="acc__btn" type="button" aria-expanded="true">
            <span class="wbl__t">{v.title}</span>
            <span class="wbl__tags"><span class="tag">{videoFilter}</span></span>
            <span class="acc__from">{v.year}</span><span class="acc__icon" aria-hidden="true"></span>
          </button>
        </h3>
        <div class="acc__panel" role="region" aria-label={v.title}>
          <div class="acc__inner">
            <div class="acc__body wbl__body">
              <video class="wbl__img wbl__vid" src={v.video} poster={v.poster} preload="none" playsinline controls aria-label={v.alt}></video>
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
  )}
  <p class="wb__empty" data-empty hidden>No projects under this filter yet.</p>
  <div class="wb__foot">
    <button class="btn glass-button" type="button" data-show-more hidden>Show More</button>
    <slot />
  </div>
</div>

<script>
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const ease = 'cubic-bezier(0.16, 1, 0.3, 1)';
  document.querySelectorAll<HTMLElement>('[data-wb]').forEach((wb) => {
    const limit = Number(wb.dataset.limit) || Infinity;
    const bar = wb.querySelector<HTMLElement>('[data-filters]')!;
    const grid = wb.querySelector<HTMLElement>('[data-grid]')!;
    const list = wb.querySelector<HTMLElement>('[data-list]')!;
    const views = [[...grid.children], [...list.querySelectorAll('[data-filter]')]] as HTMLElement[][]; // list rows, or table rows
    const viewBtn = wb.querySelector<HTMLButtonElement>('[data-view]')!;
    const more = wb.querySelector<HTMLButtonElement>('[data-show-more]')!;
    const empty = wb.querySelector<HTMLElement>('[data-empty]')!;
    const note = wb.querySelector<HTMLElement>('[data-archive-note]');
    const vids = [...wb.querySelectorAll<HTMLVideoElement>('video')];
    let current = 'all';
    let all = false;
    // All shows everything but the archive; a filter shows what carries its name.
    const fits = (li: HTMLElement) => (current === 'all' ? !li.hasAttribute('data-archive') : li.dataset.filter!.split('|').includes(current));
    const show = () => {
      let match: HTMLElement[] = [];
      views.forEach((items) => {
        match = items.filter(fits);
        const shown = all ? match : match.slice(0, limit);
        items.forEach((li) => { li.hidden = !shown.includes(li); });
      });
      // Rhythm (Josh, 4 Nov: the grid felt flat): in each run of five shown projects, two wide then three.
      // A last run of four becomes two wide pairs, and of two a wide pair, so no row is left half empty.
      const cards = views[0].filter((li) => !li.hidden && !li.classList.contains('wb__vid'));
      cards.forEach((li, i) => {
        const run = i - (i % 5), left = cards.length - run;
        li.toggleAttribute('data-wide', left >= 5 ? i % 5 < 2 : left === 4 || left === 2);
      });
      more.hidden = all || match.length <= limit;
      empty.hidden = match.length > 0;
      if (note) note.hidden = current !== wb.dataset.archiveName;
    };
    const pane = () => (list.hidden ? grid : list);
    const swap = async (update = show) => {
      if (still) return update();
      await pane().animate([{ opacity: 1 }, { opacity: 0, transform: 'scale(0.98)' }], { duration: 140, easing: 'ease-in' }).finished;
      update();
      pane().animate([{ opacity: 0, transform: 'scale(0.98)' }, { opacity: 1, transform: 'none' }], { duration: 320, easing: ease });
    };
    bar.hidden = false;
    bar.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
      if (!btn || btn.dataset.filter === current) return;
      current = btn.dataset.filter!;
      all = false;
      bar.querySelectorAll('[data-filter]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      vids.forEach((v) => v.pause());
      swap();
    });
    more.addEventListener('click', () => { all = true; show(); });
    viewBtn.addEventListener('click', () => swap(() => {
      const toList = list.hidden;
      list.hidden = !toList; grid.hidden = toList;
      viewBtn.ariaLabel = viewBtn.title = toList ? 'Grid view' : 'List view';
      viewBtn.toggleAttribute('data-list-on', toList);
      vids.forEach((v) => v.pause());
    }));
    show();

    // Videos play in their card on click, with controls from then on; one plays at a time.
    grid.querySelectorAll<HTMLButtonElement>('[data-play]').forEach((btn) => btn.addEventListener('click', () => {
      const v = btn.previousElementSibling as HTMLVideoElement;
      btn.remove();
      v.controls = true;
      v.play();
    }));
    vids.forEach((v) => v.addEventListener('play', () => vids.forEach((o) => o !== v && o.pause())));
  });
</script>

<style>
  .filterbar { position: relative; display: inline-flex; gap: 2px; padding: 6px; border-radius: var(--pill); max-width: 100%; min-width: 0; overflow-x: auto; scrollbar-width: none; }
  .filterbar[hidden] { display: none; }
  /* The toggle is its own glass circle beside the filters, so the filters can scroll on phones without hiding it. */
  .wb__tools { display: flex; align-items: center; gap: 10px; }
  .wb__view { position: relative; flex: none; display: grid; place-items: center; width: 56px; height: 56px; padding: 0; border: 0; border-radius: 50%; color: inherit; cursor: pointer; }
  @media (hover: hover) { .wb__view:hover { color-scheme: light; background: color-mix(in srgb, var(--paper) 90%, transparent); color: var(--ink); } }
  .wb__view:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  .wb__view .wb__tiles, .wb__view[data-list-on] .wb__list { display: none; }
  .wb__view[data-list-on] .wb__tiles { display: block; }
  .wb__note { margin-top: 16px; font-size: 18px; font-weight: 500; }
  .wb__note[hidden] { display: none; }

  /* Projects span four of twelve columns (three to a row, two on tablets, one on phones); videos are vertical,
     so they take three: four to a row (two on phones). */
  .wb__grid { list-style: none; margin: var(--sp-gap) 0 0; padding: 0; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--sp-gap); }
  .wb__grid > li { grid-column: span 4; }
  .wb__grid > .wb__vid { grid-column: span 3; }
  .wb__grid > li[data-wide] { grid-column: span 6; }
  .wb__grid > li[data-wide] .card__t { font-size: 24px; }
  .wb__grid[hidden], .wb__grid > [hidden], .wb__rows[hidden], .wb__rows > [hidden] { display: none; }
  .wb__vid .card__row { flex-direction: column; align-items: start; gap: 2px; }
  .wb__vid .card__y { margin-left: 0; }
  .vid { position: relative; }
  .card .vid__v { display: block; aspect-ratio: 9 / 16; background: #000; }
  .vid__play { position: absolute; inset: 0; display: grid; place-items: center; border: 0; padding: 0; border-radius: var(--radius-inner); background: none; cursor: pointer; }
  .vid__icon { display: grid; place-items: center; width: 64px; height: 64px; padding-left: 3px; border-radius: 50%; transition: transform 300ms ease-out; }
  @media (hover: hover) { .vid__play:hover .vid__icon { transform: scale(1.08); } }
  .vid__play:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }

  /* One fixed shape for every card (Josh, 28 Oct): the title on one line, then badges left and the year right,
     then the outcome held to two lines (space kept even when empty), so rows line up and stay short. */
  .card { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); align-content: start; gap: 12px; height: 100%; padding: 12px 12px 16px; border-radius: var(--radius); text-decoration: none; transition: background-color 300ms ease-out, color 300ms ease-out; }
  .card__img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border-radius: var(--radius-inner); }
  /* Depth: the image sits on a soft shadow and eases in slightly on hover; the card itself never moves. */
  .card__media { display: block; overflow: hidden; border-radius: var(--radius-inner); box-shadow: 0 1px 2px rgb(0 0 0 / .18), 0 12px 32px -12px rgb(0 0 0 / .45); }
  .card__media .card__img { display: block; transition: transform 600ms cubic-bezier(0.16, 1, 0.3, 1); }
  @media (hover: hover) { .card:hover .card__media .card__img { transform: scale(1.035); } }
  .card__row { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; padding: 0 8px 2px; }
  .card__head { display: flex; align-items: baseline; gap: 12px; padding: 0 8px; }
  .card__t { font-size: 20px; line-height: 1.2; font-weight: 600; letter-spacing: -0.02em; }
  .card__head .card__t { min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .card__y { margin-left: auto; font-size: 17px; font-weight: 600; color: var(--ink-2); letter-spacing: -0.01em; }
  .card__head + .card__row { margin-top: -6px; flex-wrap: nowrap; }
  .card__tags { display: flex; flex-wrap: nowrap; gap: 6px; overflow: hidden; }
  /* Two lines by height, not -webkit-line-clamp: iOS Safari drew the clamped text blank inside the glass cards (Josh, 6 Nov). */
  .card__out { display: block; overflow: hidden; height: 2.8em; box-sizing: content-box; margin-top: -8px; padding: 0 8px 2px; font-size: 17px; line-height: 1.4; color: var(--ink-2); }
  /* Hover: the site-wide work card hover in components.css. */
  .card:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }

  .wb__rows { margin-top: var(--sp-gap); }
  .wbl__t { flex: 1 1 auto; min-width: 0; }
  .wbl__tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .wb__rows [aria-expanded='true'] > .acc__from { opacity: 1; } /* the year stays: nothing inside repeats it */
  .wbl__body { grid-template-columns: minmax(0, 1fr) 360px; align-items: start; }
  .wbl__body .acc__text { grid-row: 1; }
  .wbl__body .acc__go { grid-column: 1; justify-self: start; }
  .wbl__img { grid-column: 2; grid-row: 1 / span 2; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border-radius: var(--radius-inner); }
  .wbl__vid { grid-column: 1; grid-row: 1; width: 220px; aspect-ratio: 9 / 16; background: #000; }

  /* The captioned card line reads like Arturistic's "Album Design for JACE": what I made, then who for, in bold. */
  .card__cap { font-weight: 500; }
  /* Captions run longer than titles, so they wrap in full rather than cut off the client's name. */
  .card__head .card__cap { white-space: normal; }
  .card__cap b { font-weight: 650; }

  /* Table list: ruled rows on one glass pane; the project name's link covers the whole row. */
  .wbt { padding: 6px var(--sp-card); border-radius: var(--radius); }
  .wbt table { width: 100%; border-collapse: collapse; }
  .wbt th { padding: 14px 12px 12px; text-align: left; font-size: 14px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-2); }
  .wbt td { padding: 18px 12px; border-top: 1px solid color-mix(in srgb, var(--ink) 16%, transparent); font-size: 17px; line-height: 1.35; color: var(--ink-2); vertical-align: baseline; }
  .wbt tr { position: relative; transition: background-color 200ms ease-out; }
  .wbt tr[hidden] { display: none; }
  .wbt .wbt__y { width: 4.5em; font-variant-numeric: tabular-nums; }
  .wbt .wbt__t { font-size: 20px; font-weight: 600; letter-spacing: -0.02em; color: var(--ink); }
  .wbt__t a { color: inherit; text-decoration: none; }
  .wbt__t a::after { content: ''; position: absolute; inset: 0; }
  .wbt__t a:focus-visible { outline: none; }
  .wbt tr:has(a:focus-visible) { outline: 2px solid var(--ink); outline-offset: -2px; }
  @media (hover: hover) { .wbt tbody tr:has(a):hover { background: color-mix(in srgb, var(--ink) 8%, transparent); } .wbt tbody tr:has(a):hover td { color: var(--ink); } }

  .wb__empty { margin-top: 32px; font-size: 20px; }
  .wb__foot { display: flex; flex-wrap: wrap; align-items: center; gap: var(--btn-gap); margin-top: var(--btn-space); font-size: 20px; }
  .wb__foot [hidden] { display: none; }
  .wb__foot:not(:has(> :not([hidden]))) { display: none; }

  @media (max-width: 1099.98px) { .wb__grid > li, .wb__grid > li[data-wide] { grid-column: span 6; } }
  @media (max-width: 759.98px) {
    .filterbar { gap: 0; padding: 4px; }
    .filterbar .glass-pill { flex: none; min-height: 44px; padding: 0 14px; font-size: 15px; letter-spacing: -0.01em; } /* pills never shrink; the row scrolls */
    .wb__view { width: 52px; height: 52px; }
    .wb__rows .acc__btn { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; gap: 10px 14px; }
    .wbl__tags { grid-row: 2; grid-column: 1 / -1; }
    .wbl__tags:empty { display: none; }
    .wbl__body { grid-template-columns: 1fr; }
    .wbl__img { grid-column: 1; grid-row: auto; }
    .wbl__vid { width: 200px; }
    /* Phone table: the project and year on one line, the category and client under it. */
    .wbt thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .wbt tr:not([hidden]) { display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: 't y' 'c c' 'k k'; gap: 2px 12px; padding: 14px 4px; border-top: 1px solid color-mix(in srgb, var(--ink) 16%, transparent); }
    .wbt tbody tr:first-child { border-top: 0; }
    .wbt td { padding: 0; border: 0; font-size: 15px; }
    .wbt .wbt__t { grid-area: t; font-size: 18px; }
    .wbt .wbt__y { grid-area: y; width: auto; }
    .wbt .wbt__c { grid-area: c; }
    .wbt .wbt__k { grid-area: k; }
    .wbt .wbt__k:empty { display: none; }
    .wb__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .wb__grid > li, .wb__grid > li[data-wide] { grid-column: span 2; }
    .wb__grid > .wb__vid { grid-column: span 1; }
    .vid__icon { width: 52px; height: 52px; }
    .wb__vid .card__t { font-size: 17px; }
    .card { padding: 10px 10px 14px; }
    .card__t { font-size: 19px; }
    .card__y { font-size: 15px; }
  }
</style>
