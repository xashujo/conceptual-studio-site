---
// One line-icon set (1.6px strokes) for the docked tab bar.
interface Props { name: 'home' | 'work' | 'services' | 'about' | 'contact' | 'prev' | 'next' | 'arrow' | 'play' }
const { name } = Astro.props;
---
<svg class="dock__icon icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'home' && <path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-4.5v-6h-5v6H5a1 1 0 0 1-1-1z" />}
  {name === 'work' && <><rect x="3.5" y="5" width="7" height="6" rx="1" /><rect x="13.5" y="5" width="7" height="9" rx="1" /><rect x="3.5" y="14" width="7" height="5.5" rx="1" /><rect x="13.5" y="17" width="7" height="2.5" rx="1" /></>}
  {name === 'services' && <><path d="m12 3.5 8.5 4.5-8.5 4.5L3.5 8z" /><path d="m3.5 12 8.5 4.5 8.5-4.5" /><path d="m3.5 16 8.5 4.5 8.5-4.5" /></>}
  {name === 'about' && <><circle cx="12" cy="8.5" r="4" /><path d="M4.5 20.5c1.2-3.8 4-5.5 7.5-5.5s6.3 1.7 7.5 5.5" /></>}
  {name === 'contact' && <><rect x="3" y="5.5" width="18" height="13" rx="2" /><path d="m3.8 7 8.2 6 8.2-6" /></>}
  {name === 'prev' && <path d="M15 5 8 12l7 7" />}
  {name === 'next' && <path d="m9 5 7 7-7 7" />}
  {name === 'arrow' && <path d="M5 12h14m-6-6 6 6-6 6" />}
  {name === 'play' && <path d="M8 5.5v13l11-6.5z" fill="currentColor" stroke="none" />}
</svg>
