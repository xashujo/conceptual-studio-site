---
// A project: the picture large, then its title, what it was and the year.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
interface Props { project: CollectionEntry<'projects'>; sizes?: string; eager?: boolean }
const { project, sizes = '(max-width: 800px) 100vw, 50vw', eager = false } = Astro.props;
const p = project.data;
---
<a class="card" href={`/work/${project.id}/`}>
  <span class="card__frame"><Image src={p.cover} alt={p.coverAlt} widths={[600, 900, 1400, 2000]} sizes={sizes} loading={eager ? 'eager' : 'lazy'} style={`view-transition-name: cover-${project.id}`} /></span>
  <span class="card__text">
    <span><span class="card__title">{p.title}</span><span class="card__meta">{p.client}. {p.disciplines.slice(0, 3).join(', ')}.</span></span>
    <span class="card__year">{p.year}</span>
  </span>
</a>
