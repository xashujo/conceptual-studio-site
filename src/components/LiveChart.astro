---
// "From spreadsheet to clarity": real DfE data that turns from a table into a slope chart.
// Source: DfE, Further education and skills, academic year 2025/26 (published 16 July 2026). Adult essential skills, August to April.
const rows = [
  { name: 'Maths', a: 200620, b: 146390, change: '−27.0%', fell: true },
  { name: 'English', a: 179760, b: 137330, change: '−23.6%', fell: true },
  { name: 'Digital skills', a: 41290, b: 42030, change: '+1.8%', fell: false },
];
const fmt = (n: number) => n.toLocaleString('en-GB');
const X1 = 170, X2 = 430, TOP = 34, BOTTOM = 300, MAX = 210000;
const y = (v: number) => BOTTOM - (v / MAX) * (BOTTOM - TOP);
// Nudge right-hand labels apart where two values sit close together.
const nudge = [-9, 9, 0];
---
<div class="live" data-live data-view="both">
  <div class="live__top">
    <div><h3 class="live__title">Adult essential skills</h3><p class="secondary" style="margin-top: 0.6rem; max-width: 40ch">Adults on maths, English and digital skills courses in England, August to April. Most data starts life as a table. Press Chart.</p></div>
    <div class="live__toggle toggle" role="group" aria-label="Show as">
      <button type="button" data-view-button="table" aria-pressed="true">Table</button>
      <button type="button" data-view-button="chart" aria-pressed="false">Chart</button>
    </div>
  </div>
  <div class="live__stage">
    <table class="live__table">
      <caption class="visually-hidden">Adult participation on essential skills courses, August to April, 2024/25 and 2025/26</caption>
      <thead><tr><th scope="col">Course</th><th scope="col">2024/25</th><th scope="col">2025/26</th><th scope="col">Change</th></tr></thead>
      <tbody>
        {rows.map((r) => <tr><th scope="row">{r.name}</th><td>{fmt(r.a)}</td><td>{fmt(r.b)}</td><td>{r.change}</td></tr>)}
      </tbody>
    </table>
    <div class="live__chart">
      <svg viewBox="0 0 600 340" role="img" aria-labelledby="live-chart-title live-chart-desc">
        <title id="live-chart-title">Adults on essential skills courses, 2024/25 to 2025/26</title>
        <desc id="live-chart-desc">Maths fell 27 per cent and English fell 24 per cent between August and April, while digital skills held steady with a small rise.</desc>
        <line class="guide" x1={X1} y1={TOP - 14} x2={X1} y2={BOTTOM} />
        <line class="guide" x1={X2} y1={TOP - 14} x2={X2} y2={BOTTOM} />
        <text class="axis-label" x={X1} y={BOTTOM + 28} text-anchor="middle">Aug–Apr 2024/25</text>
        <text class="axis-label" x={X2} y={BOTTOM + 28} text-anchor="middle">Aug–Apr 2025/26</text>
        {rows.map((r, i) => (
          <g style={`--i:${i}`}>
            <title>{r.name}: {fmt(r.a)} to {fmt(r.b)} ({r.change})</title>
            <line class:list={['line', !r.fell && 'line--flat']} x1={X1} y1={y(r.a)} x2={X2} y2={y(r.b)} stroke-dasharray={r.fell ? undefined : '6 6'} />
            <circle class:list={['dot', !r.fell && 'dot--flat']} cx={X1} cy={y(r.a)} r="5" />
            <circle class:list={['dot', !r.fell && 'dot--flat']} cx={X2} cy={y(r.b)} r="5" />
            <text class="series-label" x={X1 - 14} y={y(r.a) + 5} text-anchor="end">{r.name} {fmt(r.a)}</text>
            <text class="series-label" x={X2 + 14} y={y(r.b) + 5 + nudge[i]}>{fmt(r.b)} {r.change}</text>
          </g>
        ))}
      </svg>
      <p class="small muted live__legend"><span class="key key--fell"></span>Fell <span class="key key--flat"></span>Held steady</p>
    </div>
  </div>
  <p class="live__source">Source: Department for Education, Further education and skills 2025/26, published 16 July 2026.</p>
</div>
