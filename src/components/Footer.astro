---
import { Image } from 'astro:assets';
import art from '../assets/art/de-lairesse-gold.jpg';
import logo from '../assets/brand/logo-white.png';
import CopyEmail from './CopyEmail.astro';
import { settings } from '../lib/site.js';
const c = settings.company;
const s = settings.social;
---
<footer class="site-footer is-dark" data-tone="dark">
  <figure class="site-footer__art">
    <Image src={art} alt="Classical relief of Minerva among the Sciences, in gold" widths={[600, 900, 1300]} sizes="(max-width: 900px) 100vw, 50vw" />
    <figcaption class="plate glass" data-tone="dark"><span class="plate__no">Plate</span> Gerard de Lairesse (1640–1711), Allegory of the Sciences.</figcaption>
  </figure>
  <div class="site-footer__menu">
    <a class="brand" href="/" aria-label="Conceptual Studio, home"><Image src={logo} alt="" widths={[200, 400]} sizes="160px" /></a>
    <nav aria-label="Footer">
      <ul class="footer-links">
        <li><a href="/work/">Work</a></li>
        <li><a href="/services/">Services</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </nav>
    <div class="footer-blocks">
      <div>
        <h2>Contact</h2>
        <ul>
          <li><CopyEmail /></li>
          <li>London, United Kingdom</li>
        </ul>
      </div>
      <div>
        <h2>Elsewhere</h2>
        <ul>
          <li><a class="link" href={s.linkedin} rel="me noopener">LinkedIn</a></li>
          <li><a class="link" href={s.instagram} rel="me noopener">Instagram</a></li>
          <li><a class="link" href={s.tiktok} rel="me noopener">TikTok</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-legal">
      <p>
        © {new Date().getFullYear()} {c.name}. Registered in {c.registeredIn}{c.number && <>, company number {c.number}</>}.
        {c.office && <> Registered office: {c.office}.</>}{c.vat && <> VAT {c.vat}.</>}
      </p>
      <ul>
        <li><a href="/colophon/">Colophon</a></li>
        <li><a href="/privacy/">Privacy</a></li>
        <li><a href="/accessibility/">Accessibility</a></li>
      </ul>
    </div>
    <div class="footer-room" aria-hidden="true"></div>
  </div>
</footer>
