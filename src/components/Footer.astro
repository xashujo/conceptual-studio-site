---
// Footer, after wecomeet.com (Josh, 4 Nov), turned typographic (footer.design "Typographic", 4 Nov):
// one line on what the studio does with a Copy Email button, the links, then the studio's name set
// margin to margin in Agatho on a short strip of the garden engraving, in one gold ink (TASTE 15).
// Josh, 4 Nov: kept short, no registered office, company number or colophon here (they're on
// Privacy and Procurement). Words are in Pages CMS > Site settings; the big name is the company
// name without "Limited".
import { Image } from 'astro:assets';
import land from '../assets/art/engraved/garden.webp';
import logo from '../assets/brand/logo-cream-large.webp'; // Josh's logo, gold flow through cream type (5 Nov)
import { nav, social, email, company, footerText } from '../lib/site';
// night: the dark version that closes the Studio pages, on the Lemoyne under Start a Project (Josh, 5 Nov).
// The close panel above already has the line and Copy Email, and the ceiling is the art, so night drops them.
const { night = false } = Astro.props;
const year = new Date().getFullYear();
const words = company.name.replace(/\s+(limited|ltd\.?)$/i, '').split(/\s+/);
---
<footer class:list={['foot', { 'foot--night glass': night }]}>
  <div class="wrap foot__top">
    <div class="foot__brand">
      {!night && <p class="foot__line">{footerText}</p>}
      {!night && <button class="btn foot__copy" type="button" data-copy={email}><span data-copy-label>Copy Email</span></button>}
    </div>
    <div class="foot__cols">
      <div>
        <h2 class="foot__h">Studio</h2>
        <ul>{nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </div>
      <div>
        <h2 class="foot__h">Social</h2>
        <ul>{social.map((s) => <li><a href={s.href} rel="me noopener">{s.label}</a></li>)}</ul>
      </div>
      <div>
        <h2 class="foot__h">Small Print</h2>
        <ul>
          <li><a href="/privacy/">Privacy</a></li>
          <li><a href="/accessibility/">Accessibility</a></li>
          <li><a href="/procurement/">Procurement</a></li>
        </ul>
      </div>
    </div>
  </div>
  <a class="wrap foot__mark" href="/" aria-label={`${words.join(' ')}, home`}>
    {night
      ? <span class="foot__flow" data-flow>
          <Image class="foot__logo" src={logo} alt="" widths={[720, 1261, 2522]} sizes="(min-width: 1440px) 1261px, calc(100vw - 2 * var(--margin))" />
          <video class="gold-flow" muted playsinline preload="none" aria-hidden="true" width="2522" height="490" data-src="/media/flow/logo-cream-large" />
        </span>
      : <span class="foot__word" aria-hidden="true">{words.map((w) => <span>{w}</span>)}</span>}
  </a>
  {!night && <div class="foot__land" aria-hidden="true"><Image src={land} alt="" widths={[900, 1600, 2400]} sizes="100vw" /></div>}
  <p class="wrap foot__legal">© {year} {company.name}</p>
</footer>

<style>
  /* One ink for art and text: the dark end of the gold duotone (#6E5024, 5.7:1 on paper). */
  .foot { --foot-ink: #6E5024; position: relative; isolation: isolate; background: #F1DFC8; color: var(--foot-ink); padding-top: 72px; }
  .foot__top { display: grid; grid-template-columns: 5fr 7fr; gap: 24px; align-items: start; }
  .foot__line { max-width: 24em; font-size: 16px; line-height: 1.45; }
  .foot__copy { margin-top: 20px; }
  .foot__cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .foot__h { font-family: var(--display); font-size: 24px; line-height: 1.2; font-weight: 500; letter-spacing: -0.01em; margin-bottom: 12px; } /* Agatho, like the links (Josh, 6 Nov) */
  .foot ul { list-style: none; margin: 0; padding: 0; }
  .foot li a { display: inline-block; padding-block: 4px; font-family: var(--text); font-size: 17px; line-height: 1.4; text-decoration: none; } /* links in Inter, headings stay Agatho (Josh, 6 Nov) */
  .foot li a { background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat; transition: background-size 300ms var(--ease-out); }
  .foot li a:hover { background-size: 100% 1px; }
  .foot a:focus-visible { outline: 2px solid var(--foot-ink); outline-offset: 3px; border-radius: 2px; }
  /* The copyright closes the footer, centred under the name (Josh, 6 Nov). */
  .foot__legal { position: relative; z-index: 1; margin-top: 20px; padding-bottom: 24px; font-size: 14px; line-height: 1.5; text-align: center; }
  /* The studio's name, set margin to margin. 100cqi is the space inside the margins, so the fit is exact
     at any width. 6.32 is "Conceptual Studio" in ems of Agatho Medium at this tracking (3.90 + 0.25 gap
     + 2.17, measured in Chromium, 4 Nov); re-measure if the company name changes. */
  .foot__mark { display: block; position: relative; z-index: 1; margin-top: 48px; container-type: inline-size; text-decoration: none; color: var(--foot-ink); }
  .foot__word { display: flex; justify-content: space-between; gap: 0.25em; padding-top: 0.06em; border-top: 1px solid currentColor; font-family: var(--display); font-weight: 500; font-size: calc(100cqi / 6.32); line-height: 0.86; letter-spacing: -0.035em; white-space: nowrap; }
  .foot__mark:focus-visible { outline-offset: 6px; }
  /* The engraving fills the bottom of the footer, no top edge. */
  /* A short strip of the engraving under the name: a horizon, not a second page. */
  .foot__land { position: relative; z-index: -1; margin-top: -3vw; height: clamp(120px, 13vw, 200px); pointer-events: none; }
  .foot__land img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 78%; -webkit-mask-image: linear-gradient(to bottom, transparent, #000 55%); mask-image: linear-gradient(to bottom, transparent, #000 55%); }

  /* Night: one glass panel holds the whole footer, links, logo and ©, so the links read over the busy ceiling
     (Josh, 6 Nov). The lighter tint the work cards use, so the painting's gold still comes through. */
  .foot--night { --foot-ink: #F1DFC8; --glass-bg: color-mix(in srgb, var(--paper-2) 16%, transparent); --g-blur: 0.33; --g-shine: 0.5; background: var(--glass-bg); margin: 0 var(--margin); padding: clamp(28px, 3vw, 44px) 0 clamp(20px, 2.5vw, 32px); border-radius: var(--radius) var(--radius) 0 0; }
  /* Thinner glass than elsewhere (Josh, 6 Nov: "less thick"): a third of the blur, half the rim, a lighter tint. It runs into the bottom of the page, so only the top corners are rounded. */
  .foot--night .wrap { padding-inline: clamp(24px, 3vw, 44px); }
  .foot--night .foot__top { grid-template-columns: 1fr; }
  .foot--night .foot__brand { display: none; }
  .foot--night .foot__legal { margin-top: clamp(16px, 2vw, 28px); padding-bottom: 0; }
  /* The logo is 2522px wide, so it stops at 1261px: sharp on a 2x screen, never stretched. */
  .foot--night .foot__mark { margin-top: clamp(40px, 5vw, 72px); }
  .foot__logo { display: block; width: 100%; max-width: 1261px; height: auto; margin-inline: auto; }
  /* The gold flow plays once through the logo when it comes into view (logo-flow.js) and stays on its last frame. */
  .foot__flow { display: grid; max-width: 1261px; margin-inline: auto; }
  .foot__flow > * { grid-area: 1 / 1; width: 100%; height: auto; aspect-ratio: 2522 / 490; }

  @media (max-width: 759.98px) {
    .foot { padding-top: 56px; }
    .foot__top { grid-template-columns: 1fr; gap: 32px; }
    .foot__line { font-size: 17px; }

    .foot__brand:empty { display: none; } /* night has nothing on the left; on desktop the empty cell keeps the columns right */
    .foot__cols { grid-template-columns: 1fr 1fr; row-gap: 32px; }
    .foot li a { font-size: 17px; }
    .foot__mark { margin-top: 36px; }
    /* On a phone, crop to the reclining figure and the flowers. */
    .foot__land { height: 120px; margin-top: -16px; }
    .foot__land img { object-position: 22% 88%; }
  }
</style>

<script>import '../scripts/logo-flow.js';</script>
